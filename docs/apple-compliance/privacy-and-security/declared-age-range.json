{"abstract":[{"text":"Create age-appropriate experiences in your app by asking people to share their age range.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"DeclaredAgeRange","modules":[{"name":"Declared Age Range"}],"navigatorTitle":[{"kind":"text","text":"Declared Age Range"}],"platforms":[{"introducedAt":"26.0","name":"iOS"},{"introducedAt":"26.0","name":"iPadOS"},{"introducedAt":"26.0","name":"Mac Catalyst"},{"introducedAt":"26.0","name":"macOS"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"Declared Age Range"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use the Declared Age Range API to request that people share their age range with your app. For children in a Family Sharing group, a parent or guardian or the Family Organizer can decide whether to always share a child’s age information with your app, ask the child every time, or never share their age information. Along with an age range, the system returns an ","type":"text"},{"identifier":"doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/AgeRangeService\/AgeRangeDeclaration","isActive":true,"type":"reference"},{"text":" for the age range a person provides.","type":"text"},{"text":" ","type":"text"},{"text":"To use the Declared Age Range API, add the ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Entitlements\/com.apple.developer.declared-age-range","isActive":true,"type":"reference"},{"text":" entitlement to your app by enabling the Declared Age Range capability on your target in Xcode. For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-capabilities-to-your-app","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Data from the Declared Age Range API is based on information declared by a person, or their parent or guardian, and may be confirmed using a method like a credit card or government ID. You are solely responsible for ensuring compliance with associated laws or regulations that may apply to your app.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Entitlements\/com.apple.developer.declared-age-range","doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/requesting-people-share-their-age-range-with-your-app","doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/implementing-age-assurance-and-permissions"],"title":"Essentials"},{"anchor":"Age-range-requests","identifiers":["doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/AgeRangeService","doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/DeclaredAgeRangeAction"],"title":"Age range requests"},{"anchor":"Significant-change-acknowledgment","identifiers":["doc:\/\/com.apple.declaredagerange\/documentation\/DeclaredAgeRange\/SignificantUpdateAction"],"title":"Significant change acknowledgment"}],"variants":[{"paths":["\/documentation\/declaredagerange"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.declaredagerange