ck offer sheet or by implementing custom merchandising.","type":"text"}],"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/merchandising-win-back-offers-in-your-app","kind":"article","role":"article","title":"Merchandising win-back offers in your app","type":"topic","url":"\/documentation\/storekit\/merchandising-win-back-offers-in-your-app"},"doc://com.apple.storekit/documentation/StoreKit/supporting-monthly-subscriptions-with-a-12-month-commitment":{"abstract":[{"text":"Configure, merchandise, and grant access to a monthly subscription with a 12-month commitment.","type":"text"}],"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/supporting-monthly-subscriptions-with-a-12-month-commitment","kind":"article","role":"article","title":"Supporting monthly subscriptions with a 12-month commitment","type":"topic","url":"\/documentation\/storekit\/supporting-monthly-subscriptions-with-a-12-month-commitment"},"doc://com.apple.storekit/documentation/StoreKit/supporting-multiseat-purchases-in-your-app":{"abstract":[{"text":"Configure, merchandise, and sell subscriptions that people buy for a group or that organizations buy in volume, and grant access to every seat.","type":"text"}],"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/supporting-multiseat-purchases-in-your-app","kind":"article","role":"article","title":"Supporting multiseat purchases in your app","type":"topic","url":"\/documentation\/storekit\/supporting-multiseat-purchases-in-your-app"},"doc://com.apple.storekit/documentation/StoreKit/supporting-offer-codes-in-your-app":{"abstract":[{"text":"Enable customers to redeem offer codes through the App Store or within your app.","type":"text"}],"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/supporting-offer-codes-in-your-app","kind":"article","role":"article","title":"Supporting offer codes in your app","type":"topic","url":"\/documentation\/storekit\/supporting-offer-codes-in-your-app"},"doc://com