{"abstract":[{"text":"Test your implementation of Apple In-App Purchases using real product information and server-to-server transactions in the sandbox environment.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.storekit\/documentation\/StoreKit","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/in-app-purchase"],["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.storekit\/documentation\/StoreKit","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/in-app-purchase","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/original-api-for-in-app-purchase"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-in-app-purchases-with-sandbox"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"modules":[{"name":"StoreKit"}],"role":"article","roleHeading":"Article","title":"Testing Apple In-App Purchases with sandbox"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use the Apple sandbox environment to test your implementation of Apple In-App Purchases that use the StoreKit framework on devices with real product information from App Store Connect. Transactions from test accounts don’t incur charges because the sandbox environment simulates successful transactions using the App Store’s infrastructure without processing actual payments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Apps in the development and beta-testing stages of your product cycle use the sandbox environment for Apple In-App Purchases. These apps include:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Development-signed apps you build and run from Xcode","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Apps you download from TestFlight","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When you sign in to a Sandbox Apple Account on your device, you gain access to sandbox settings that control the test environment. Use these settings to change the subscription renewal rate, clear purchase history, simulate win-back offers, turn on Ask to Buy, and more.","type":"text"}],"type":"paragraph"},{"anchor":"Prepare-for-sandbox-testing","level":3,"text":"Prepare for sandbox testing","type":"heading"},{"inlineContent":[{"text":"Before you start testing Apple In-App Purchases in the sandbox environment, make sure that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Your Apple Developer Program account is active. For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/programs\/enroll\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your membership Account Holder has signed the Paid Applications Agreement, as described in ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/manage-agreements\/sign-and-update-agreements","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You set up the product information in App Store Connect for the app you’re testing. At minimum, set up a product reference name, product ID, a localized name, and a price. For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/configure-in-app-purchase-settings\/overview-for-configuring-in-app-purchases","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You create Sandbox Apple Accounts in App Store Connect. For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/test-in-app-purchases\/create-sandbox-apple-ids","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You grant permission for locally installed apps to run on the device if you test a development-signed build on iOS, watchOS, or visionOS devices. For more information, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/enabling-developer-mode-on-a-device","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"content":[{"inlineContent":[{"text":"A Sandbox Apple Account only works for testing Apple In-App Purchases in apps that belong to the same Apple Developer Program account you used to create it. Don’t use a Sandbox Apple Account to test Apple In-App Purchases in another developer’s app.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"inlineContent":[{"text":"For more information on the workflow from signing agreements to testing, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/get-started\/app-store-connect-workflow","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Next, prepare your app to test:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"During development, build and run your app from Xcode. At this stage, you don’t need to upload your app binary to App Store Connect to test it in the sandbox environment.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"During beta testing, download your app from TestFlight.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Finally, to gain access to the sandbox settings, follow the instructions below to sign in to your Sandbox Apple Account. The instructions differ for a development-signed app and for an app you download from TestFlight.","type":"text"}],"type":"paragraph"},{"anchor":"Sign-in-to-your-Sandbox-Apple-Account-for-a-development-signed-app","level":3,"text":"Sign in to your Sandbox Apple Account for a development-signed app","type":"heading"},{"inlineContent":[{"text":"In iOS and iPadOS, the sandbox account appears in Settings > Developer after the first time you use the device to attempt a purchase in a development-signed app. There’s no need to sign out of the non-Sandbox Apple Account. Sign in using a Sandbox Apple Account.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In macOS, the sandbox account appears in App Store Settings after the first time you use the device to make an Apple In-App Purchase. Open App Store > Settings and click the Sign In button to sign in using a Sandbox Apple Account. When you’re done testing, sign out of the Sandbox Apple Account from the App Store Settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your test device has macOS 11.1 or earlier installed, sign out of the Mac App Store, then build your app in Xcode and launch it from Finder.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The first time you make a purchase in a development-signed app, sign in to the App Store using your Sandbox Apple Account to begin testing. When you sign in, the text ","type":"text"},{"code":"[Environment: Sandbox]","type":"codeVoice"},{"text":" appears, indicating that you’ve connected to the test environment. If ","type":"text"},{"code":"[Environment: Sandbox]","type":"codeVoice"},{"text":" doesn’t appear, you’re using the production environment.","type":"text"}],"type":"paragraph"},{"anchor":"Sign-in-to-your-Sandbox-Apple-Account-for-a-TestFlight-app","level":3,"text":"Sign in to your Sandbox Apple Account for a TestFlight app","type":"heading"},{"inlineContent":[{"text":"Apps that you download from TestFlight always run in the sandbox environment. However, to access the sandbox controls for testing, you need to sign out of your production Apple Account in Media & Purchases, and sign in with a Sandbox Apple Account in Developer settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Follow these steps to access sandbox controls for TestFlight in iOS:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Download your beta app from TestFlight. You need to be signed in with a production Apple Account to download a beta app.  For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/test-a-beta-version\/testflight-overview","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Open Settings and select your Apple Account.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select Media & Purchases.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On the pop-up menu, select Sign Out.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Next, open Settings and select Developer. (This option is available when you enable ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/enabling-developer-mode-on-a-device","isActive":true,"overridingTitle":"Developer Mode","overridingTitleInlineContent":[{"text":"Developer Mode","type":"text"}],"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Scroll to the bottom of the screen, and select Sign In under Sandbox Apple Account. Enter your Sandbox Apple Account credentials.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Your device now has access to the sandbox controls for testing your beta app, and Apple In-App Purchases use your Sandbox Apple Account.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Signing out of Media & Purchases can remove your access to purchased content in production apps on your device. Consider using a dedicated testing device when testing a TestFlight app with sandbox controls.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"inlineContent":[{"text":"If you sign back in to your Apple Account in Media & Purchases, apps you install through TestFlight revert to attributing Apple In-App Purchases to your Apple Account and not to your Sandbox Apple Account.","type":"text"}],"type":"paragraph"},{"anchor":"Manage-sandbox-settings-from-App-Store-Connect-or-iOS-Account-Settings","level":3,"text":"Manage sandbox settings from App Store Connect or iOS Account Settings","type":"heading"},{"inlineContent":[{"text":"Sandbox settings enable you to control the testing environment to set up your tests. You can manage the settings in App Store Connect or in iOS Account Settings, whichever you prefer. The settings affect the sandbox the same way, regardless of which method you choose. However, some settings are available only in App Store Connect. The following table compares the settings on both platforms:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Sandbox setting or feature","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available in App Store Connect","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available in iOS","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Create or delete a Sandbox Apple Account","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Create or delete a Sandbox Test Family","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Remove a member from a Sandbox Test Family","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Change the storefront country or region","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Change the subscription renewal rate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Enable interrupted purchases","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Clear purchase history for a Sandbox Apple Account","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Change sharing status for a Sandbox Test Family member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Select whether to display win-back offer sheets in the app","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Turn on Ask to Buy for a Sandbox Apple Account","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Approve or decline Ask to Buy requests","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"To access the Account Settings in iOS, follow these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open Settings and select Developer.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the Sandbox Apple Account.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On the pop-up sheet, select Manage. The Account Settings page appears.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Changes you make to product metadata in App Store Connect can take up to one hour to appear in the sandbox environment.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"For information on all aspects of managing sandbox settings in App Store Connect, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/test-in-app-purchases\/overview-of-testing-in-sandbox","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Get-server-notifications-for-the-sandbox-environment","level":3,"text":"Get server notifications for the sandbox environment","type":"heading"},{"inlineContent":[{"text":"Along with testing Apple In-App Purchase in your app, you can also test related server operations in the sandbox environment. To enable App Store Server Notifications for the sandbox environment, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/enabling-app-store-server-notifications","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As you test your app, your server receives notifications for Apple In-App Purchase transactions. The notification payload identifies the sandbox environment in the ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/environment","isActive":true,"type":"reference"},{"text":" property of the ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/data","isActive":true,"type":"reference"},{"text":" object. For more information, ","type":"text"},{"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-app-store-server-notifications","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerAPI","isActive":true,"type":"reference"},{"text":" is also available in the sandbox environment. Use the endpoints’ sandbox URLs to get information about transactions that occur during testing.","type":"text"}],"type":"paragraph"},{"anchor":"Test-Apple-In-App-Purchases-for-all-regions","level":3,"text":"Test Apple In-App Purchases for all regions","type":"heading"},{"inlineContent":[{"text":"In-app products you create through App Store Connect are available for sale in every App Store region. You can also maintain a list of product identifiers that you make available in specific regions. To test Apple In-App Purchases in multiple regions using the same Sandbox Apple Account:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open App Store Connect.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click the Sandbox Apple Account.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Change the App Store Country or Region setting.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"For more information, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/test-in-app-purchases\/manage-sandbox-apple-id-settings","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To activate a storefront after you change the region in App Store Connect, sign out of the Sandbox Apple Account account on the device and sign back in. When testing this activation, you see the Apple In-App Purchases appropriate to the region assigned to your Sandbox Apple Account. Changing the App Store Country or Region setting affects the storefront value in your app. For more information, see ","type":"text"},{"identifier":"doc:\/\/com.apple.storekit\/documentation\/StoreKit\/Storefront","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Clear-the-purchase-history-for-a-Sandbox-Apple-Account","level":3,"text":"Clear the purchase history for a Sandbox Apple Account","type":"heading"},{"inlineContent":[{"text":"To manage repeated testing using the same Sandbox Apple Account, clear its purchase history in App Store Connect or from Account Settings in iOS. On your iOS device, follow these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open Settings and select Developer.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the Sandbox Apple Account.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On the pop-up sheet, select Manage.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On the Account Settings page, select Clear Purchase History.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Sign out of the Sandbox Apple Account to clear the purchase history cache on the device. Sign back in to continue testing.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"For information about clearing the purchase history from App Store Connect, see ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/help\/app-store-connect\/test-in-app-purchases\/manage-sandbox-apple-id-settings","isActive":true,"overridingTitle":"Manage Sandbox Apple Account settings","overridingTitleInlineContent":[{"text":"Manage Sandbox Apple Account settings","type":"text"}],"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Clearing the purchase history for Sandbox Apple Accounts with a high number of purchases can take longer than several minutes. When the process completes, the transaction history is empty and the Sandbox Apple Account is eligible for introductory offers. If you’re signed in with the Sandbox Apple Account, you can purchase subscriptions previously subscribed to without causing duplicate purchases.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Clearing the purchase history doesn’t affect Apple In-App Purchases that customers make on the App Store.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Apple-In-App-Purchase-Testing","generated":true,"identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-at-all-stages-of-development-with-xcode-and-the-sandbox","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-refund-requests","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-win-back-offers-in-xcode","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-ask-to-buy-in-xcode"],"title":"Apple In-App Purchase Testing"}],"topicSections":[{"anchor":"Product-identifiers-and-requests","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-fetching-product-identifiers","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-invalid-product-identifier-handling","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-a-product-request"],"title":"Product identifiers and requests"},{"anchor":"Payment-transactions","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-purchases-made-outside-your-app","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-ask-to-buy-in-the-sandbox-environment","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-win-back-offers-in-the-sandbox-environment","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-an-interrupted-purchase","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-failing-subscription-renewals-and-in-app-purchases","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-a-payment-request"],"title":"Payment transactions"},{"anchor":"Subscriptions","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-an-auto-renewable-subscription","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-resubscribing-from-the-subscriptions-page","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-disabling-auto-renew","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-multiseat-subscriptions"],"title":"Subscriptions"},{"anchor":"Family-Sharing","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-family-sharing"],"title":"Family Sharing"},{"anchor":"Age-Assurance","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-age-assurance-in-sandbox"],"title":"Age Assurance"},{"anchor":"Refunds","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-refund-requests"],"title":"Refunds"},{"anchor":"Server-notifications","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-app-store-server-notifications"],"title":"Server notifications"},{"anchor":"Transaction-observer","identifiers":["doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-transaction-observer-code","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-a-successful-transaction","doc:\/\/com.apple.storekit\/documentation\/StoreKit\/testing-complete-transactions"],"title":"Transaction observer"}],"variants":[{"paths":["\/documentation\/storekit\/testing-in-app-purchases-with-sandbox"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/storekit\/testing-in-app-purchases-with-sandbox"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.apple.documentation/documentation/AppStoreServerAPI":{"abstract":[{"text":"Manage your customers’ App Store transactions from your server.","type":"text"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerAPI","kind":"symbol","role":"collection","title":"App Store Server API","type":"topic","url":"\/documentation\/appstoreserverapi"},"doc://com.apple.documentation/documentation/AppStoreServerNotifications/data":{"abstract":[{"text":"The payload data that contains app metadata and the signed renewal and transaction information.","type":"text"}],"fragments":[{"kind":"text","text":"object "},{"kind":"identifier","text":"data"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/data","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"data"}],"role":"symbol","title":"data","type":"topic","url":"\/documentation\/appstoreservernotifications\/data"},"doc://com.apple.documentation/documentation/AppStoreServerNotifications/enabling-app-store-server-notifications":{"abstract":[{"text":"Configure your server and provide an HTTPS URL to receive notifications about in-app purchase events and unreported external purchase tokens.","type":"text"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/enabling-app-store-server-notifications","kind":"article","role":"article","title":"Enabling App Store Server Notifications","type":"topic","url":"\/documentation\/appstoreservernotifications\/enabling-app-store-server-notifications"},"doc://com.apple.documentation/documentation/AppStoreServerNotifications/environment":{"abstract":[{"text":"The server environment, either sandbox or production.","type":"text"}],"fragments":[{"kind":"text","text":"type "},{"kind":"identifier","text":"environment"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppStoreServerNotifications\/environment","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"environment"}],"role":"symbol","title":"environment","type":"topic","url":"\/documentation\/appstoreservernotifications\/environment"},"doc://com.apple.documentation/documentation/Xcode/enabling-developer-mode-on-a-device":{"abstract":[{"text":"Grant or deny permission for locally installed apps to run in iOS, iPadOS, watchOS, and visionOS.","type":"text"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/enabling-developer-mode-on-a-device","kind":"article","role":"article","title":"Enabling Developer Mode on a device","type":"topic","url":"\/documentation\/xcode\/enabling-developer-mode-on-a-device"},"doc://com.apple.documentation/documentation/technologies":{"abstract":[],"identifier":"doc:\/\/com.apple.documentation\/documentation\/technologies","kind":"technologies","role":"overview","title":"Technologies","type":"topic","url":"\/documentation\/technologies"},"doc://com.apple.storekit/documentation/StoreKit":{"abstract":[{"text":"Support Apple In-App Purchases and interactions with the App Store.","type":"text"}],"identifier":"doc:\/\/com.apple.storekit\/docu