rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    function adminsDoc() {
      return get(/databases/$(database)/documents/app/admins);
    }

    function isPricingAdmin() {
      return signedIn() && (
        request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        ||
        (adminsDoc().exists()
          && (adminsDoc().data.pricingAdmins is list)
          && (request.auth.uid in adminsDoc().data.pricingAdmins))
      );
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1';
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function isOwner(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in ld.data)
            && looksLikeFirebaseUid(ld.data.organizerUserId)
            && (ld.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in ld.data)
            && looksLikeFirebaseUid(ld.data.ownerId)
            && (ld.data.ownerId == request.auth.uid)
          )
        );
    }

    function isOrganizerByMembership(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid)).data.role == 0;
    }

    function isLeagueMemberNoGet(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid));
    }

    function canManageLeague(leagueId) {
      return isSuperAdmin()
        || isOwner(leagueId)
        || isOrganizerByMembership(leagueId);
    }

    // =========================================================================
    // CHAT — validation helpers (UPDATED: reply fields)
    // =========================================================================

    function validChatType(t) {
      return (t is string) && (t == 'text' || t == 'image' || t == 'code' || t == 'voice');
    }

    function isReasonableMs(ms) {
      return (ms is int)
        && (ms >= (request.time.toMillis() - 30 * 60 * 1000))
        && (ms <= (request.time.toMillis() + 30 * 60 * 1000));
    }

    function validChatMessageCreate(messageId) {
      return signedIn()
        && (request.resource.data.keys().hasOnly([
              'messageId', 'senderId', 'senderName', 'senderPhoto',
              'text', 'imageUrl', 'voiceUrl', 'type',
              'leagueId', 'timestamp',
              'createdAt', 'createdAtMs',

              // optional pin/mod (may be omitted by older clients)
              'pinned', 'pinnedAt', 'pinnedBy',
              'deleted', 'deletedAt', 'deletedBy',

              // reply fields (may be omitted by older clients)
              'replyToMessageId', 'replyToSenderName', 'replyToText', 'replyToType'
            ]))
        && (request.resource.data.messageId is string)
        && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string)
        && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string)
        && (request.resource.data.senderName.size() >= 1)
        && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string)
        && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string)
        && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.voiceUrl is string)
        && (request.resource.data.voiceUrl.size() <= 2000)
        && (
          !('leagueId' in request.resource.data)
          || (
            (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId.size() <= 200)
          )
        )
        && isReasonableMs(request.resource.data.timestamp)
        && (request.resource.data.createdAt == request.time)
        && isReasonableMs(request.resource.data.createdAtMs)

        // pin/mod defaults if present
        && (
          !('pinned' in request.resource.data)
          || ((request.resource.data.pinned is bool) && (request.resource.data.pinned == false))
        )
        && (
          !('pinnedAt' in request.resource.data)
          || (request.resource.data.pinnedAt == null)
        )
        && (
          !('pinnedBy' in request.resource.data)
          || ((request.resource.data.pinnedBy is string) && (request.resource.data.pinnedBy == ''))
        )
        && (
          !('deleted' in request.resource.data)
          || ((request.resource.data.deleted is bool) && (request.resource.data.deleted == false))
        )
        && (
          !('deletedAt' in request.resource.data)
          || (request.resource.data.deletedAt == null)
        )
        && (
          !('deletedBy' in request.resource.data)
          || ((request.resource.data.deletedBy is string) && (request.resource.data.deletedBy == ''))
        )

        // reply fields validation if present
        && (
          !('replyToMessageId' in request.resource.data)
          || (request.resource.data.replyToMessageId is string)
        )
        && (
          !('replyToSenderName' in request.resource.data)
          || ((request.resource.data.replyToSenderName is string) && (request.resource.data.replyToSenderName.size() <= 80))
        )
        && (
          !('replyToText' in request.resource.data)
          || ((request.resource.data.replyToText is string) && (request.resource.data.replyToText.size() <= 400))
        )
        && (
          !('replyToType' in request.resource.data)
          || ((request.resource.data.replyToType is string) && (request.resource.data.replyToType.size() <= 20))
        )

        // content constraints
        && (
          (request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == ''
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'code'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == ''
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'image'
            && request.resource.data.imageUrl.size() > 10
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'voice'
            && request.resource.data.voiceUrl.size() > 10
            && request.resource.data.imageUrl == '')
        );
    }

    function isChatPinUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'pinned', 'pinnedAt', 'pinnedBy'
        ]);
    }

    function validChatPinUpdate() {
      return isChatPinUpdate()
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinnedBy is string)
        && (
          (
            request.resource.data.pinned == true
            && (request.resource.data.pinnedBy == request.auth.uid)
            && (request.resource.data.pinnedAt == request.time)
          )
          ||
          (
            request.resource.data.pinned == false
            && (request.resource.data.pinnedBy == '')
            && (request.resource.data.pinnedAt == null)
          )
        );
    }

    function isChatSoftDeleteUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'deleted', 'deletedAt', 'deletedBy',
          'pinned', 'pinnedAt', 'pinnedBy'
        ]);
    }

    function validChatSoftDeleteUpdate() {
      return isChatSoftDeleteUpdate()
        && (request.resource.data.deleted is bool)
        && (request.resource.data.deleted == true)
        && (request.resource.data.deletedBy is string)
        && (request.resource.data.deletedBy == request.auth.uid)
        && (request.resource.data.deletedAt == request.time)
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinned == false)
        && (request.resource.data.pinnedBy is string)
        && (request.resource.data.pinnedBy == '')
        && (request.resource.data.pinnedAt == null);
    }

    function isGlobalChatApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid)).data.status == 'approved';
    }

    function canAccessGlobalChat() {
      return signedIn() && (isSuperAdmin() || isGlobalChatApproved());
    }

    function isGlobalChatAdmin() {
      let ad = adminsDoc();
      return signedIn()
        && ad.exists()
        && (ad.data.globalChatAdmins is list)
        && (request.auth.uid in ad.data.globalChatAdmins);
    }

    function allowGlobalSenderPin() {
      let ad = adminsDoc();
      return ad.exists()
        && ('allowGlobalSenderPin' in ad.data)
        && (ad.data.allowGlobalSenderPin is bool)
        && (ad.data.allowGlobalSenderPin == true);
    }

    function canPinGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (allowGlobalSenderPin()
            && ('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    function canDeleteGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    function canPinLeagueMessage(leagueId) {
      return canManageLeague(leagueId);
    }

    function canDeleteLeagueMessage(leagueId) {
      return canManageLeague(leagueId)
        || (('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    // =========================================================================
    // GLOBAL CHAT REQUESTS
    // =========================================================================
    match /globalChatRequests/{requestId} {
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if signedIn()
        && request.auth.uid == requestId
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.status is string)
        && (request.resource.data.status == 'pending');

      allow update: if signedIn()
        && (
          (
            isSuperAdmin()
            && (request.resource.data.status is string)
            && (request.resource.data.status in ['pending', 'approved', 'rejected'])
          )
          ||
          (
            request.auth.uid == requestId
            && (request.resource.data.status is string)
            && (request.resource.data.status == 'pending')
          )
        );

      allow delete: if false;
    }

    // =========================================================================
    // GLOBAL PUBLIC CHATROOM
    // =========================================================================
    match /globalChatroom/{messageId} {
      allow get, list: if canAccessGlobalChat();
      allow create: if canAccessGlobalChat() && validChatMessageCreate(messageId);

      allow update: if canAccessGlobalChat()
        && (
          (validChatPinUpdate() && canPinGlobalMessage())
          || (validChatSoftDeleteUpdate() && canDeleteGlobalMessage())
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // LEAGUES
    // =========================================================================
    match /leagues/{leagueId} {
      match /chatroom/{messageId} {
        allow get, list: if isLeagueMemberNoGet(leagueId);

        allow create: if isLeagueMemberNoGet(leagueId)
          && validChatMessageCreate(messageId)
          && (('leagueId' in request.resource.data) && (request.resource.data.leagueId == leagueId));

        allow update: if isLeagueMemberNoGet(leagueId)
          && (
            (validChatPinUpdate() && canPinLeagueMessage(leagueId))
            || (validChatSoftDeleteUpdate() && canDeleteLeagueMessage(leagueId))
          );

        allow delete: if canManageLeague(leagueId)
          || (signedIn()
              && (resource.data.senderId is string)
              && (resource.data.senderId == request.auth.uid));
      }
    }

    // =========================================================================
    // APP CONFIG
    // =========================================================================
    match /app/{docId} {
      allow get, list: if (docId == 'pricing') || (docId == 'admins' && signedIn());
      allow create, update: if (docId == 'pricing' || docId == 'admins') && isPricingAdmin();
      allow delete: if false;
    }
  }
}
