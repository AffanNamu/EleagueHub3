rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    // --------------------------
    // Pricing admins + super admin (app creator)
    // --------------------------
    function adminsDoc() {
      return get(/databases/$(database)/documents/app/admins);
    }

    function isPricingAdmin() {
      return signedIn() && (
        request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        ||
        (adminsDoc().exists()
          && (adminsDoc().data.pricingAdmins is list)
          && (request.auth.uid in adminsDoc().data.pricingAdmins))
      );
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    // Organizer/Owner detection (Firebase UID ONLY)
    function isOwner(leagueId) {
      let ld = leagueDoc(leagueId);

      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in ld.data)
            && looksLikeFirebaseUid(ld.data.organizerUserId)
            && (ld.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in ld.data)
            && looksLikeFirebaseUid(ld.data.ownerId)
            && (ld.data.ownerId == request.auth.uid)
          )
        );
    }

    // Membership (expects Firebase UIDs in memberIds)
    function isMember(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (ld.data.memberIds is list)
        && (request.auth.uid in ld.data.memberIds);
    }

    // Append-only self-join to memberIds
    function isSelfJoinAppendOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
        && (request.resource.data.memberIds is list)
        && (request.resource.data.updatedAtMs is int)
        && (
          (
            (resource.data.memberIds is list)
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && (request.auth.uid in request.resource.data.memberIds)
            && !(request.auth.uid in resource.data.memberIds)
            && (
              !(resource.data.updatedAtMs is int)
              || request.resource.data.updatedAtMs > resource.data.updatedAtMs
            )
          )
          ||
          (
            !(resource.data.memberIds is list)
            && request.resource.data.memberIds.size() == 1
            && (request.auth.uid in request.resource.data.memberIds)
          )
        );
    }

    function registeredCountOrZero(d) {
      return (d.registeredCount is int) ? d.registeredCount : 0;
    }

    // Public/private detection (secure by default)
    function isPublicLeague(leagueId) {
      let ld = leagueDoc(leagueId);
      let d = ld.data;

      return ld.exists()
        && (
          (((d.isPrivate is bool) && (d.isPrivate == false)))
          ||
          (((d.isPrivate is int) && (d.isPrivate == 0)))
          ||
          (((d.privacy is string) && (
            d.privacy == 'public'
            || d.privacy == 'PUBLIC'
            || d.privacy == 'LeaguePrivacy.public'
          )))
        );
    }

    function canViewLeague(leagueId) {
      return isOwner(leagueId) || isMember(leagueId) || isPublicLeague(leagueId);
    }

    // --------------------------
    // Quick messages validation (best-effort)
    // --------------------------
    function validQuickMsg(s) {
      return (s is string)
        && (s.size() > 0)
        && (s.size() <= 15)
        && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*');
    }

    function validQuickMessages(list) {
      return (list is list)
        && (list.size() <= 15)
        && (list.size() < 1  || validQuickMsg(list[0]))
        && (list.size() < 2  || validQuickMsg(list[1]))
        && (list.size() < 3  || validQuickMsg(list[2]))
        && (list.size() < 4  || validQuickMsg(list[3]))
        && (list.size() < 5  || validQuickMsg(list[4]))
        && (list.size() < 6  || validQuickMsg(list[5]))
        && (list.size() < 7  || validQuickMsg(list[6]))
        && (list.size() < 8  || validQuickMsg(list[7]))
        && (list.size() < 9  || validQuickMsg(list[8]))
        && (list.size() < 10 || validQuickMsg(list[9]))
        && (list.size() < 11 || validQuickMsg(list[10]))
        && (list.size() < 12 || validQuickMsg(list[11]))
        && (list.size() < 13 || validQuickMsg(list[12]))
        && (list.size() < 14 || validQuickMsg(list[13]))
        && (list.size() < 15 || validQuickMsg(list[14]));
    }

    // --------------------------
    // Users
    // --------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll([
          'userId',
          'teamName',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && (
          !('shareId' in request.resource.data)
          || (
            (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'teamName',
            'updatedAt'
          ])
          ||
          (
            resource.data.shareId == null
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'shareId',
              'updatedAt'
            ])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'quickMessagesCustom',
              'updatedAt'
            ])
            && validQuickMessages(request.resource.data.quickMessagesCustom)
          )
        );

      allow delete: if false;

      match /leagueCharges/{leagueId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.leagueId is string)
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow delete: if false;
      }
    }

    // --------------------------
    // Leagues
    // --------------------------
    match /leagues/{leagueId} {
      allow get: if canViewLeague(leagueId);

      allow list: if signedIn();

      // ─────────────────────────────────────────────────
      // CREATE: Any signed-in user can create a league.
      //
      // Validates:
      //   - organizerUid must equal caller's Firebase UID
      //   - name must be a non-empty string
      //   - if memberIds present, caller must be in it
      //
      // Intentionally permissive on other fields because the
      // creator is the organizer and owns this document.
      // ─────────────────────────────────────────────────
      allow create: if signedIn()
        && ('organizerUid' in request.resource.data)
        && (request.resource.data.organizerUid is string)
        && (request.resource.data.organizerUid == request.auth.uid)
        && ('name' in request.resource.data)
        && (request.resource.data.name is string)
        && (request.resource.data.name.size() > 0)
        && (
          !('memberIds' in request.resource.data)
          || !(request.resource.data.memberIds is list)
          || (request.auth.uid in request.resource.data.memberIds)
        );

      // ─────────────────────────────────────────────────
      // UPDATE: Multiple authorized paths.
      // ─────────────────────────────────────────────────
      allow update: if
        // Path 1: Organizer/owner full update
        isOwner(leagueId)

        // Path 2: Self-join append-only (memberIds only)
        || isSelfJoinAppendOnly()

        // Path 3: Self-join with counters
        || (
          signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'memberIds',
            'updatedAtMs',
            'registeredCount',
            'isFull'
          ])
          && (request.resource.data.memberIds is list)
          && (
            (resource.data.memberIds is list)
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && (request.auth.uid in request.resource.data.memberIds)
            && !(request.auth.uid in resource.data.memberIds)
          )
          && (request.resource.data.registeredCount is int)
          && request.resource.data.registeredCount == (registeredCountOrZero(resource.data) + 1)
          && (request.resource.data.updatedAtMs is int)
          && (
            !(resource.data.updatedAtMs is int)
            || request.resource.data.updatedAtMs > resource.data.updatedAtMs
          )
          && (
            !(resource.data.maxTeams is int)
            || (
              (request.resource.data.isFull is bool)
              && (request.resource.data.isFull == (request.resource.data.registeredCount >= resource.data.maxTeams))
            )
          )
        )

        // Path 4: Retry/re-merge by the same organizer.
        // Handles set(merge:true) on an already-existing doc when user
        // retries league creation with the same draft ID.
        || (
          signedIn()
          && (resource.data.organizerUid is string)
          && (resource.data.organizerUid == request.auth.uid)
          && ('organizerUid' in request.resource.data)
          && (request.resource.data.organizerUid is string)
          && (request.resource.data.organizerUid == request.auth.uid)
        );

      allow delete: if isOwner(leagueId);

      // --------------------------
      // Teams
      // --------------------------
      match /teams/{teamId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      // --------------------------
      // Matches
      // --------------------------
      match /matches/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      // --------------------------
      // Knockout
      // --------------------------
      match /knockout/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      // --------------------------
      // Memberships
      // --------------------------
      match /memberships/{membershipId} {
        allow get: if isOwner(leagueId) || isMember(leagueId);
        allow list: if isOwner(leagueId) || isMember(leagueId);

        allow create: if
          // ── Path A: Organizer can create any membership ──
          isOwner(leagueId)

          // ── Path B: Organizer self-membership during league creation (batch) ──
          // Uses getAfter() because both league + membership are written
          // in the same batch.commit(). getAfter() sees the pending league doc.
          || (
            signedIn()
            && !exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(membershipId))
            && (request.resource.data.userId is string)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role is int)
            && (request.resource.data.role == 1)
            && (
              // Batch path: league doc being created in same batch
              (
                getAfter(/databases/$(database)/documents/leagues/$(leagueId)).exists()
                && (
                  (getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.organizerUid == request.auth.uid)
                  || (getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid)
                )
              )
              ||
              // Sequential path: league doc already exists (retry / non-batch)
              (
                leagueDoc(leagueId).exists()
                && (
                  (('organizerUid' in leagueDoc(leagueId).data) && (leagueDoc(leagueId).data.organizerUid == request.auth.uid))
                  || (('ownerUid' in leagueDoc(leagueId).data) && (leagueDoc(leagueId).data.ownerUid == request.auth.uid))
                )
              )
            )
          )

          // ── Path C: Any signed-in user self-joins as member (role=0) ──
          || (
            signedIn()
            && !exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(membershipId))
            && (request.resource.data.userId is string)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role is int)
            && (request.resource.data.role == 0)
          );

        allow update: if
          // Organizer full update
          isOwner(leagueId)

          // Self-update limited fields (no role escalation)
          || (
            signedIn()
            && (resource.data.userId == request.auth.uid)
            && (resource.data.leagueId == leagueId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'teamId',
              'updatedAtMs',
              'version'
            ])
            && (resource.data.role == request.resource.data.role)
          );

        allow delete: if isOwner(leagueId);
      }

      // --------------------------
      // Announcements
      // --------------------------
      match /announcements/{annId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      // --------------------------
      // Space (live rooms, etc.)
      // --------------------------
      match /space/{docId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);

        match /reactions/{reactionId} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create: if signedIn() && (isOwner(leagueId) || isMember(leagueId));
          allow update, delete: if false;
        }

        match /requests/{uid} {
          allow get: if isOwner(leagueId) || (signedIn() && request.auth.uid == uid);
          allow list: if isOwner(leagueId);

          allow create: if signedIn()
            && (isOwner(leagueId) || isMember(leagueId))
            && request.auth.uid == uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending";

          allow update: if signedIn() && (isOwner(leagueId) || (request.auth.uid == uid));
          allow delete: if signedIn() && (isOwner(leagueId) || (request.auth.uid == uid));
        }

        match /speakers/{uid} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create, update, delete: if isOwner(leagueId);
        }
      }

      // --------------------------
      // Coupon config + redemptions + CODE-BASED COUPONS
      // --------------------------

      function cfgCurrent(leagueId) {
        return get(/databases/$(database)/documents/leagues/$(leagueId)/couponConfig/config);
      }
      function cfgAfter(leagueId) {
        return getAfter(/databases/$(database)/documents/leagues/$(leagueId)/couponConfig/config);
      }
      function redemptionAfter(leagueId, uid) {
        return getAfter(/databases/$(database)/documents/leagues/$(leagueId)/couponRedemptions/$(uid));
      }
      function codeAfter(leagueId, codeId) {
        return getAfter(/databases/$(database)/documents/leagues/$(leagueId)/couponCodes/$(codeId));
      }

      function isCouponManager(leagueId) {
        return isOwner(leagueId);
      }

      function hasDisc(data) {
        return ('discountPercent' in data) && (data.discountPercent is number);
      }
      function hasUserPays(data) {
        return ('userPaysPercent' in data) && (data.userPaysPercent is int);
      }
      function discOk(data) {
        return !('discountPercent' in data)
          || ((data.discountPercent is number) && (data.discountPercent >= 0) && (data.discountPercent <= 100));
      }
      function userPaysOk(data) {
        return !('userPaysPercent' in data)
          || ((data.userPaysPercent is int) && (data.userPaysPercent >= 0) && (data.userPaysPercent <= 100));
      }
      function discAndUserPaysConsistent(data) {
        return !(hasDisc(data) && hasUserPays(data))
          || (data.userPaysPercent == (100 - data.discountPercent));
      }
      function organizerPaysOk(data) {
        return !('organizerPaysPercent' in data)
          || ((data.organizerPaysPercent is int) && (data.organizerPaysPercent >= 0) && (data.organizerPaysPercent <= 100));
      }

      match /couponConfig/{docId} {
        allow get: if signedIn() && (canViewLeague(leagueId) || isCouponManager(leagueId));
        allow list: if false;

        allow create: if (docId == 'config')
          && signedIn()
          && isCouponManager(leagueId)
          && (request.resource.data.leagueId is string)
          && request.resource.data.leagueId == leagueId
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.currency is string)
          && ((request.resource.data.currency == 'NGN') || (request.resource.data.currency == 'USD'))
          && (request.resource.data.unitPrice is number) && (request.resource.data.unitPrice > 0)
          && (request.resource.data.effectiveUnit is number) && (request.resource.data.effectiveUnit > 0)
          && (!('threshold' in request.resource.data) || (request.resource.data.threshold == null) || (request.resource.data.threshold is number && request.resource.data.threshold >= 0))
          && (request.resource.data.thresholdDiscountPercent is number)
          && (request.resource.data.thresholdDiscountPercent >= 0) && (request.resource.data.thresholdDiscountPercent <= 100)
          && (hasDisc(request.resource.data) || hasUserPays(request.resource.data))
          && discOk(request.resource.data)
          && userPaysOk(request.resource.data)
          && discAndUserPaysConsistent(request.resource.data)
          && organizerPaysOk(request.resource.data)
          && (request.resource.data.qtyTotal is int) && (request.resource.data.qtyTotal >= 0)
          && (request.resource.data.qtyRemaining is int) && (request.resource.data.qtyRemaining == request.resource.data.qtyTotal)
          && (request.resource.data.createdAtMs is int) && (request.resource.data.createdAtMs > 0)
          && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs > 0)
          && (request.resource.data.version is int) && (request.resource.data.version >= 1);

        allow update: if
          (
            signedIn()
            && isCouponManager(leagueId)
            && !(resource.data.qtyRemaining is int)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'qtyRemaining',
              'updatedAtMs'
            ])
            && (request.resource.data.qtyRemaining is int)
            && (request.resource.data.qtyRemaining == 0)
            && (request.resource.data.updatedAtMs is int)
            && (
              !(resource.data.updatedAtMs is int)
              || request.resource.data.updatedAtMs > resource.data.updatedAtMs
            )
          )
          ||
          (
            signedIn()
            && isCouponManager(leagueId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'currency',
              'unitPrice',
              'effectiveUnit',
              'threshold',
              'thresholdDiscountPercent',
              'discountPercent',
              'userPaysPercent',
              'organizerPaysPercent',
              'qtyTotal',
              'qtyRemaining',
              'updatedAtMs'
            ])
            && (request.resource.data.currency is string)
            && ((request.resource.data.currency == 'NGN') || (request.resource.data.currency == 'USD'))
            && (request.resource.data.unitPrice is number) && (request.resource.data.unitPrice > 0)
            && (request.resource.data.effectiveUnit is number) && (request.resource.data.effectiveUnit > 0)
            && (!('threshold' in request.resource.data) || (request.resource.data.threshold == null) || (request.resource.data.threshold is number && request.resource.data.threshold >= 0))
            && (request.resource.data.thresholdDiscountPercent is number)
            && (request.resource.data.thresholdDiscountPercent >= 0) && (request.resource.data.thresholdDiscountPercent <= 100)
            && discOk(request.resource.data)
            && userPaysOk(request.resource.data)
            && discAndUserPaysConsistent(request.resource.data)
            && organizerPaysOk(request.resource.data)
            && (request.resource.data.qtyTotal is int) && (request.resource.data.qtyRemaining is int)
            && (request.resource.data.qtyTotal >= resource.data.qtyTotal)
            && (request.resource.data.qtyRemaining >= resource.data.qtyRemaining)
            && ((request.resource.data.qtyTotal - resource.data.qtyTotal) == (request.resource.data.qtyRemaining - resource.data.qtyRemaining))
            && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs > resource.data.updatedAtMs)
          )
          ||
          (
            signedIn()
            && isCouponManager(leagueId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'qtyRemaining',
              'updatedAtMs'
            ])
            && (request.resource.data.qtyRemaining is int)
            && (request.resource.data.qtyRemaining == (resource.data.qtyRemaining - 1))
            && (request.resource.data.qtyRemaining >= 0)
            && (request.resource.data.updatedAtMs is int)
            && (request.resource.data.updatedAtMs > resource.data.updatedAtMs)
          )
          ||
          (
            signedIn()
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'qtyRemaining',
              'updatedAtMs'
            ])
            && (request.resource.data.qtyRemaining is int)
            && (request.resource.data.qtyRemaining == (resource.data.qtyRemaining - 1))
            && (request.resource.data.qtyRemaining >= 0)
            && (request.resource.data.updatedAtMs is int)
            && (
              redemptionAfter(leagueId, request.auth.uid).exists()
              && redemptionAfter(leagueId, request.auth.uid).data.status == 'paid'
            )
          );

        allow delete: if false;
      }

      match /couponCodes/{codeId} {
        allow list: if isCouponManager(leagueId);
        allow get: if signedIn();

        allow create: if signedIn()
          && isCouponManager(leagueId)
          && (request.resource.data.leagueId is string)
          && request.resource.data.leagueId == leagueId
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.currency is string)
          && ((request.resource.data.currency == 'NGN') || (request.resource.data.currency == 'USD'))
          && (request.resource.data.discountPercent is number)
          && (request.resource.data.discountPercent >= 0) && (request.resource.data.discountPercent <= 100)
          && (request.resource.data.expectedAmount is number) && (request.resource.data.expectedAmount >= 0)
          && (request.resource.data.usedBy is string) && (request.resource.data.usedBy == '')
          && (request.resource.data.usedAtMs is int) && (request.resource.data.usedAtMs == 0)
          && (request.resource.data.createdAtMs is int) && (request.resource.data.createdAtMs > 0)
          && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs > 0)
          && (request.resource.data.version is int) && (request.resource.data.version >= 1)
          && cfgCurrent(leagueId).exists()
          && (cfgCurrent(leagueId).data.qtyRemaining is int)
          && (cfgCurrent(leagueId).data.qtyRemaining > 0)
          && cfgAfter(leagueId).exists()
          && (cfgAfter(leagueId).data.qtyRemaining == (cfgCurrent(leagueId).data.qtyRemaining - 1));

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'usedBy',
            'usedAtMs',
            'updatedAtMs'
          ])
          && (resource.data.usedBy is string) && (resource.data.usedBy == '')
          && (request.resource.data.usedBy is string) && (request.resource.data.usedBy == request.auth.uid)
          && (request.resource.data.usedAtMs is int) && (request.resource.data.usedAtMs > 0)
          && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs > resource.data.updatedAtMs)
          && redemptionAfter(leagueId, request.auth.uid).exists()
          && (redemptionAfter(leagueId, request.auth.uid).data.status == 'paid')
          && (redemptionAfter(leagueId, request.auth.uid).data.code is string)
          && (redemptionAfter(leagueId, request.auth.uid).data.code == codeId);

        allow delete: if false;
      }

      match /couponRedemptions/{uid} {
        allow list: if isCouponManager(leagueId);
        allow get: if isCouponManager(leagueId) || (signedIn() && uid == request.auth.uid);

        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.leagueId == leagueId
          && request.resource.data.userId == request.auth.uid
          && (request.resource.data.createdAtMs is int) && (request.resource.data.createdAtMs > 0)
          && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs >= request.resource.data.createdAtMs)
          && (
            (
              request.resource.data.status == 'pending'
              && (request.resource.data.currency is string)
              && ((request.resource.data.currency == 'NGN') || (request.resource.data.currency == 'USD'))
              && (request.resource.data.expectedAmount is number) && (request.resource.data.expectedAmount >= 0)
              && (request.resource.data.expiresAt is timestamp)
              && cfgCurrent(leagueId).exists()
              && ((cfgCurrent(leagueId).data.qtyRemaining is int) && (cfgCurrent(leagueId).data.qtyRemaining >= 0))
            )
            ||
            (
              request.resource.data.status == 'paid'
              && (request.resource.data.code is string)
              && codeAfter(leagueId, request.resource.data.code).exists()
              && (codeAfter(leagueId, request.resource.data.code).data.usedBy is string)
              && (codeAfter(leagueId, request.resource.data.code).data.usedBy == request.auth.uid)
            )
          );

        allow update: if signedIn()
          && uid == request.auth.uid
          && resource.data.userId == request.auth.uid
          && resource.data.leagueId == leagueId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'provider',
            'receiptId',
            'paidAtMs',
            'updatedAtMs'
          ])
          && (resource.data.status == 'pending')
          && (request.resource.data.status == 'paid')
          && (request.resource.data.paidAtMs is int) && (request.resource.data.paidAtMs > 0)
          && (request.resource.data.updatedAtMs is int) && (request.resource.data.updatedAtMs >= request.resource.data.paidAtMs)
          && cfgAfter(leagueId).exists()
          && (cfgAfter(leagueId).data.qtyRemaining == (cfgCurrent(leagueId).data.qtyRemaining - 1));

        allow delete: if false;
      }

      match /coupons/{couponId} {
        allow read, write: if false;
      }
    }

    // --------------------------
    // league_spaces (legacy)
    // --------------------------
    match /league_spaces/{spaceId} {
      allow read: if signedIn()
        && (resource.data.leagueId is string)
        && (isOwner(resource.data.leagueId) || isMember(resource.data.leagueId));

      allow create: if signedIn()
        && (request.resource.data.leagueId is string)
        && isOwner(request.resource.data.leagueId);

      allow update, delete: if signedIn()
        && (resource.data.leagueId is string)
        && isOwner(resource.data.leagueId);
    }

    // --------------------------
    // Pricing doc + admins doc + analytics
    // --------------------------
    match /app/{docId} {
      allow get, list: if (docId == 'pricing') || (docId == 'admins' && signedIn());
      allow create, update: if ((docId == 'pricing' || docId == 'admins') && isPricingAdmin());
      allow delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && (request.resource.data.eventName is string)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid);

      allow get, list: if isPricingAdmin();
      allow update, delete: if false;
    }
  }
}
