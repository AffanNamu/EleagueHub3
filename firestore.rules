rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function isOwnerFromLeagueDoc(leagueId) {
      return signedIn() && leagueDoc(leagueId).data.organizerUserId == request.auth.uid;
    }

    function isMemberFromLeagueDoc(leagueId) {
      return signedIn()
        && (leagueDoc(leagueId).data.memberIds is list)
        && (request.auth.uid in leagueDoc(leagueId).data.memberIds);
    }

    function inLeague(leagueId) {
      return isOwnerFromLeagueDoc(leagueId) || isMemberFromLeagueDoc(leagueId);
    }

    match /leagues/{leagueId} {

      function isOwnerHere() {
        return signedIn() && resource.data.organizerUserId == request.auth.uid;
      }

      function isMemberHere() {
        return signedIn()
          && (resource.data.memberIds is list)
          && (request.auth.uid in resource.data.memberIds);
      }

      function canReadLeague() {
        // Treat missing isPrivate as public.
        return (resource.data.isPrivate != true) || isOwnerHere() || isMemberHere();
      }

      allow get: if canReadLeague();

      // Per-doc evaluated for query results.
      allow list: if signedIn() && canReadLeague();

      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        && (request.resource.data.memberIds is list)
        && (request.auth.uid in request.resource.data.memberIds);

      function memberIdsValid() {
        return (resource.data.memberIds is list) && (request.resource.data.memberIds is list);
      }

      // Members can only add/remove themselves from memberIds.
      function isSelfJoin() {
        return memberIdsValid()
          && !(request.auth.uid in resource.data.memberIds)
          && (request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds);
      }

      function isSelfLeave() {
        return memberIdsValid()
          && (request.auth.uid in resource.data.memberIds)
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds);
      }

      allow update: if isOwnerHere()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
          && (isSelfJoin() || isSelfLeave())
        );

      allow delete: if isOwnerHere();

      match /teams/{teamId} {
        allow read: if inLeague(leagueId);
        allow write: if isOwnerFromLeagueDoc(leagueId);
      }

      match /matches/{matchId} {
        allow read: if inLeague(leagueId);
        allow write: if isOwnerFromLeagueDoc(leagueId);
      }

      match /knockout/{matchId} {
        allow read: if inLeague(leagueId);
        allow write: if isOwnerFromLeagueDoc(leagueId);
      }

      match /memberships/{membershipId} {
        allow read: if inLeague(leagueId);
        allow create, update: if isOwnerFromLeagueDoc(leagueId)
          || (signedIn() && request.resource.data.userId == request.auth.uid);
        allow delete: if isOwnerFromLeagueDoc(leagueId);
      }

      match /announcements/{annId} {
        allow read: if inLeague(leagueId);
        allow write: if isOwnerFromLeagueDoc(leagueId);
      }

      match /space/{docId} {
        allow read: if inLeague(leagueId);
        allow write: if isOwnerFromLeagueDoc(leagueId);

        match /reactions/{reactionId} {
          allow read: if inLeague(leagueId);
          allow create: if signedIn() && inLeague(leagueId);
          allow update, delete: if false;
        }

        match /requests/{uid} {
          // Host can read all; user can read their own request doc (needed for your UI).
          allow get: if isOwnerFromLeagueDoc(leagueId) || (signedIn() && request.auth.uid == uid);
          allow list: if isOwnerFromLeagueDoc(leagueId);

          allow create: if signedIn()
            && inLeague(leagueId)
            && request.auth.uid == uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending";

          allow update: if signedIn() && (
            // host can update any request (approve/deny), but cannot rewrite who it belongs to
            (isOwnerFromLeagueDoc(leagueId) && request.resource.data.userId == uid)
            ||
            // requester can only change status + updatedAtMs, and only to pending/denied
            (
              inLeague(leagueId)
              && request.auth.uid == uid
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAtMs'])
              && (request.resource.data.status == "pending" || request.resource.data.status == "denied")
            )
          );

          allow delete: if signedIn() && (
            isOwnerFromLeagueDoc(leagueId) || (inLeague(leagueId) && request.auth.uid == uid)
          );
        }

        match /speakers/{uid} {
          allow read: if inLeague(leagueId);
          allow create, update, delete: if isOwnerFromLeagueDoc(leagueId);
        }
      }
    }

    // IMPORTANT: your app also uses the TOP-LEVEL `league_spaces` collection.
    // Without rules for it, every read/write fails with permission-denied.
    match /league_spaces/{spaceId} {
      allow read: if signedIn()
        && (resource.data.leagueId is string)
        && inLeague(resource.data.leagueId);

      allow create: if signedIn()
        && (request.resource.data.leagueId is string)
        && isOwnerFromLeagueDoc(request.resource.data.leagueId);

      allow update, delete: if signedIn()
        && (resource.data.leagueId is string)
        && isOwnerFromLeagueDoc(resource.data.leagueId);
    }
  }
}
