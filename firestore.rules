rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function isOwner(leagueId) {
      return signedIn() && leagueDoc(leagueId).data.organizerUserId == request.auth.uid;
    }

    function isMember(leagueId) {
      return signedIn()
        && (leagueDoc(leagueId).data.memberIds is list)
        && (request.auth.uid in leagueDoc(leagueId).data.memberIds);
    }

    // Public/private detection.
    //
    // Secure-by-default:
    // - If privacy info is missing/unknown, the league is treated as private.
    //
    // Supports:
    // - legacy boolean `isPrivate: false`
    // - legacy int `isPrivate: 0` (your League.toJson writes 1/0)
    // - optional string `privacy: 'public'`
    function isPublicLeague(leagueId) {
      let d = leagueDoc(leagueId).data;

      return
        ((d.isPrivate is bool) && (d.isPrivate == false))
        ||
        ((d.isPrivate is int) && (d.isPrivate == 0))
        ||
        ((d.privacy is string) && (
          d.privacy == 'public'
          || d.privacy == 'PUBLIC'
          || d.privacy == 'LeaguePrivacy.public'
        ));
    }

    // --------------------------
    // User Profiles (Firebase uid is doc id)
    // --------------------------
    match /users/{userId} {
      // Needed for:
      // - showing your own profile everywhere
      // - admin lookup by uid / shareId to auto-resolve teamName
      allow read: if signedIn();

      // Create profile (one-time after first login).
      //
      // shareId is optional for backward compatibility with any older clients,
      // but if provided it must match the expected format.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll([
          'userId',
          'teamName',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && (
          !('shareId' in request.resource.data)
          || (
            (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
        );

      // Hardened update:
      //
      // Users can:
      // 1) update teamName (+ updatedAt)
      // 2) backfill shareId ONCE if it was missing (+ updatedAt)
      //
      // This keeps userId/authProvider/createdAt immutable.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          // Normal edit
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'teamName',
            'updatedAt'
          ])
          ||
          // One-time shareId backfill (for old profiles that don't have shareId yet)
          (
            resource.data.shareId == null
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'shareId',
              'updatedAt'
            ])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
        );

      allow delete: if false;
    }

    match /leagues/{leagueId} {
      // Secure-by-default: if privacy missing/unknown -> private (owner/member only).
      allow get: if isOwner(leagueId) || isMember(leagueId) || isPublicLeague(leagueId);

      // Allows .where('memberIds', 'array-contains', uid) queries
      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        // memberIds is optional for backward compatibility with older/lean league docs.
        // If provided, it must include the creator.
        && (
          !(request.resource.data.memberIds is list)
          || (request.auth.uid in request.resource.data.memberIds)
        );

      allow update: if isOwner(leagueId)
        || (signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
          && (request.resource.data.memberIds is list)
          && (request.auth.uid in request.resource.data.memberIds));

      allow delete: if isOwner(leagueId);

      match /teams/{teamId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /matches/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /knockout/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /memberships/{membershipId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow create, update: if isOwner(leagueId)
          || (signedIn() && request.resource.data.userId == request.auth.uid);
        allow delete: if isOwner(leagueId);
      }

      match /announcements/{annId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /space/{docId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);

        // Nested reactions: members can react, everyone in league can see
        match /reactions/{reactionId} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create: if signedIn() && (isOwner(leagueId) || isMember(leagueId));
          allow update, delete: if false;
        }

        // ✅ REQUIRED by your Space UI
        match /requests/{uid} {
          allow get: if isOwner(leagueId) || (signedIn() && request.auth.uid == uid);
          allow list: if isOwner(leagueId);

          allow create: if signedIn()
            && (isOwner(leagueId) || isMember(leagueId))
            && request.auth.uid == uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending";

          // Host can approve/deny; requester can delete their own request.
          allow update: if signedIn() && (
            isOwner(leagueId)
            || (request.auth.uid == uid)
          );

          allow delete: if signedIn() && (
            isOwner(leagueId) || (request.auth.uid == uid)
          );
        }

        // ✅ REQUIRED by your Space UI (host panel)
        match /speakers/{uid} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create, update, delete: if isOwner(leagueId);
        }
      }
    }

    // ✅ REQUIRED by LeagueSpacesFirebase (top-level collection)
    match /league_spaces/{spaceId} {
      allow read: if signedIn()
        && (resource.data.leagueId is string)
        && (isOwner(resource.data.leagueId) || isMember(resource.data.leagueId));

      allow create: if signedIn()
        && (request.resource.data.leagueId is string)
        && isOwner(request.resource.data.leagueId);

      allow update, delete: if signedIn()
        && (resource.data.leagueId is string)
        && isOwner(resource.data.leagueId);
    }
  }
}
