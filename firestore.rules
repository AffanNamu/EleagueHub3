rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    function adminsDoc() {
      return get(/databases/$(database)/documents/app/admins);
    }

    function isPricingAdmin() {
      return signedIn() && (
        request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        ||
        (adminsDoc().exists()
          && (adminsDoc().data.pricingAdmins is list)
          && (request.auth.uid in adminsDoc().data.pricingAdmins))
      );
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1';
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    // =========================================================================
    // MASTER LEAGUES (Premium container)
    // =========================================================================
    function masterLeagueDoc(masterLeagueId) {
      return get(/databases/$(database)/documents/master_leagues/$(masterLeagueId));
    }

    function validMasterLeagueId(id) {
      return (id is string) && (id.size() > 0) && (id.size() <= 200);
    }

    function isMasterLeagueOwner(masterLeagueId) {
      let ml = masterLeagueDoc(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && ml.exists()
        && ('ownerId' in ml.data)
        && (ml.data.ownerId is string)
        && (ml.data.ownerId == request.auth.uid);
    }

    function isMasterLeagueMember(masterLeagueId) {
      let ml = masterLeagueDoc(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && ml.exists()
        && (
          (('ownerId' in ml.data) && (ml.data.ownerId is string) && (ml.data.ownerId == request.auth.uid))
          || (('memberIds' in ml.data) && (ml.data.memberIds is list) && (request.auth.uid in ml.data.memberIds))
        );
    }

    function isOwner(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in ld.data)
            && looksLikeFirebaseUid(ld.data.organizerUserId)
            && (ld.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in ld.data)
            && looksLikeFirebaseUid(ld.data.ownerId)
            && (ld.data.ownerId == request.auth.uid)
          )
        );
    }

    function isOwnerDirect() {
      return signedIn()
        && resource != null
        && (
          (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
          || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in resource.data)
            && looksLikeFirebaseUid(resource.data.organizerUserId)
            && (resource.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in resource.data)
            && looksLikeFirebaseUid(resource.data.ownerId)
            && (resource.data.ownerId == request.auth.uid)
          )
        );
    }

    function isOrganizerByMembership(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid)).data.role == 0;
    }

    function isLeagueMemberNoGet(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid));
    }

    function isOrganizerRole(role) { return (role is int) && role == 0; }
    function isMemberRole(role)    { return (role is int) && role == 1; }

    function canManageLeague(leagueId) {
      return isSuperAdmin()
        || isOwner(leagueId)
        || isOrganizerByMembership(leagueId);
    }

    function canReadLeague(leagueId) {
      let ld = leagueDoc(leagueId);
      return isSuperAdmin()
        || (
          signedIn()
          && ld.exists()
          && (
            (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
            || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
            || (('organizerUserId' in ld.data) && looksLikeFirebaseUid(ld.data.organizerUserId) && (ld.data.organizerUserId == request.auth.uid))
            || (('ownerId' in ld.data) && looksLikeFirebaseUid(ld.data.ownerId) && (ld.data.ownerId == request.auth.uid))
            || ((ld.data.memberIds is list) && (request.auth.uid in ld.data.memberIds))

            // Master League System:
            // If a league belongs to a Master League, allow Master League members to read it.
            || (
              ('masterLeagueId' in ld.data)
              && (ld.data.masterLeagueId is string)
              && isMasterLeagueMember(ld.data.masterLeagueId)
            )

            || ((ld.data.isPrivate is bool) && (ld.data.isPrivate == false))
            || ((ld.data.isPrivate is int) && (ld.data.isPrivate == 0))
            || ((ld.data.privacy is string) && (
              ld.data.privacy == 'public'
              || ld.data.privacy == 'PUBLIC'
              || ld.data.privacy == 'LeaguePrivacy.public'
            ))
          )
        )
        || (
          signedIn()
          && ld.exists()
          && !('isPrivate' in ld.data)
          && !('privacy' in ld.data)
        );
    }

    // =========================================================================
    // MATCH HIGHLIGHTS (matches/{matchId}/highlights/{highlightId})
    //
    // IMPORTANT SECURITY NOTE:
    // - This ruleset protects Firestore metadata writes ONLY.
    // - Cloudinary upload is protected separately by SIGNED upload:
    //   signature must be generated server-side after verifying the same conditions.
    // =========================================================================

    function membershipDoc(leagueId, uid) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(uid));
    }

    function leagueMatchDoc(leagueId, matchId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/matches/$(matchId));
    }

    function matchIsFinished(matchDoc) {
      return matchDoc.exists()
        && (
          (('isPlayed' in matchDoc.data) && (matchDoc.data.isPlayed is bool) && (matchDoc.data.isPlayed == true))
          || (('status' in matchDoc.data) && (matchDoc.data.status is string) && (matchDoc.data.status == 'FINISHED'))
          || (('matchStatus' in matchDoc.data) && (matchDoc.data.matchStatus is string) && (matchDoc.data.matchStatus == 'FINISHED'))
        );
    }

    function matchHasTeams(matchDoc) {
      return matchDoc.exists()
        && ('homeTeamId' in matchDoc.data)
        && (matchDoc.data.homeTeamId is string)
        && (matchDoc.data.homeTeamId.size() > 0)
        && ('awayTeamId' in matchDoc.data)
        && (matchDoc.data.awayTeamId is string)
        && (matchDoc.data.awayTeamId.size() > 0);
    }

    function isParticipantTeam(matchDoc, teamId) {
      return matchHasTeams(matchDoc)
        && (
          (matchDoc.data.homeTeamId == teamId)
          || (matchDoc.data.awayTeamId == teamId)
        );
    }

    function highlightHasOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'matchId',
        'leagueId',
        'teamId',
        'uploadedBy',
        'cloudinaryPublicId',
        'secureUrl',
        'thumbnailUrl',
        'duration',
        'size',
        'format',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function highlightFieldsAreValid(matchId, highlightId) {
      let d = request.resource.data;

      // Hard caps for free-tier protection (metadata sanity checks).
      // Real enforcement is client-side compression + Cloudinary signed endpoint constraints.
      let maxBytes = 15 * 1024 * 1024; // 15MB
      let maxSeconds = 180; // 3 minutes

      return highlightHasOnlyAllowedKeys()
        && (d.matchId is string)
        && (d.matchId == matchId)
        && (d.leagueId is string)
        && (d.leagueId.size() > 0)
        && (d.leagueId.size() <= 200)
        && (d.teamId is string)
        && (d.teamId.size() > 0)
        && (d.teamId.size() <= 200)
        && (d.uploadedBy is string)
        && (d.uploadedBy == request.auth.uid)

        // Enforce Cloudinary public_id path to stop clients from writing arbitrary folders.
        // Expected: match_highlights/{leagueId}/{matchId}/{teamId}/{highlightId}
        && (d.cloudinaryPublicId is string)
        && (d.cloudinaryPublicId == ('match_highlights/' + d.leagueId + '/' + matchId + '/' + d.teamId + '/' + highlightId))
        && (d.cloudinaryPublicId.size() <= 600)

        && (d.secureUrl is string)
        && (d.secureUrl.size() <= 2000)
        && (d.thumbnailUrl is string)
        && (d.thumbnailUrl.size() <= 2000)

        && (d.duration is int || d.duration is float)
        && (d.duration >= 0)
        && (d.duration <= maxSeconds)

        && (d.size is int)
        && (d.size >= 0)
        && (d.size <= maxBytes)

        && (d.format is string)
        && (d.format.size() <= 10)

        && (d.status is string)
        && (d.status in ['UPLOADING', 'PROCESSING', 'APPROVED'])

        // timestamps are optional/loose to avoid breaking existing docs, but must be timestamps if present
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp))
        && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderIsLeagueParticipant(matchId, highlightId) {
      let d = request.resource.data;

      // Must be in league
      let mem = membershipDoc(d.leagueId, request.auth.uid);

      // Must reference a finished match under the same league (authoritative league match doc)
      let md = leagueMatchDoc(d.leagueId, matchId);

      return signedIn()
        && mem.exists()
        && ('teamId' in mem.data)
        && (mem.data.teamId is string)
        && (mem.data.teamId == d.teamId)

        && matchIsFinished(md)
        && isParticipantTeam(md, d.teamId);
    }

    function highlightCreateIsValid(matchId, highlightId) {
      let d = request.resource.data;

      return highlightFieldsAreValid(matchId, highlightId)
        && highlightUploaderIsLeagueParticipant(matchId, highlightId)

        // Create must start as UPLOADING with empty URLs (optimistic UI doc).
        && (d.status == 'UPLOADING')
        && (d.secureUrl == '')
        && (d.thumbnailUrl == '')
        && (d.duration == 0 || d.duration == 0.0)
        && (d.size == 0)
        && (d.format == '')

        // createdAt/updatedAt: allow unset/null or server timestamp (evaluates as timestamp)
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp))
        && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderUpdateIsValid(matchId, highlightId) {
      let d = request.resource.data;

      // Identity fields MUST NOT change.
      let identityUnchanged =
        (d.matchId == resource.data.matchId)
        && (d.leagueId == resource.data.leagueId)
        && (d.teamId == resource.data.teamId)
        && (d.uploadedBy == resource.data.uploadedBy)
        && (d.cloudinaryPublicId == resource.data.cloudinaryPublicId);

      // uploader must remain same user
      let isUploader = signedIn()
        && ('uploadedBy' in resource.data)
        && (resource.data.uploadedBy is string)
        && (resource.data.uploadedBy == request.auth.uid);

      // still must be league participant + match finished (defense-in-depth)
      let md = leagueMatchDoc(resource.data.leagueId, matchId);
      let mem = membershipDoc(resource.data.leagueId, request.auth.uid);

      let stillAllowed =
        mem.exists()
        && ('teamId' in mem.data)
        && (mem.data.teamId is string)
        && (mem.data.teamId == resource.data.teamId)
        && matchIsFinished(md)
        && isParticipantTeam(md, resource.data.teamId);

      // Allowed uploader transitions:
      // - UPLOADING (urls empty)  -> PROCESSING (urls set, duration/size/format set)
      // - PROCESSING may be re-set idempotently (same data) on retry/merge
      // - UPLOADING may be restored (markUploadFailed clears urls)
      let uploadingStateOk =
        (d.status == 'UPLOADING')
        && (d.secureUrl == '')
        && (d.thumbnailUrl == '')
        && (d.size == 0)
        && (d.duration == 0 || d.duration == 0.0)
        && (d.format == '' || d.format == 'mp4'); // allow '' during uploading; tolerate mp4 if client writes it early

      let processingStateOk =
        (d.status == 'PROCESSING')
        && (d.secureUrl.size() > 10)
        && (d.thumbnailUrl.size() > 10)
        && (d.size > 0)
        && (d.duration > 0)
        && (d.format == 'mp4');

      return highlightFieldsAreValid(matchId, highlightId)
        && identityUnchanged
        && isUploader
        && stillAllowed
        && (uploadingStateOk || processingStateOk);
    }

    function highlightModeratorUpdateIsValid(matchId, highlightId) {
      // League managers can approve highlights (moderation).
      // Keep this extremely strict to prevent edits to URLs/metadata by admins.
      return signedIn()
        && canManageLeague(resource.data.leagueId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status is string)
        && (request.resource.data.status in ['PROCESSING', 'APPROVED'])
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == null || (request.resource.data.updatedAt is timestamp));
    }

    // =========================================================================
    // REWARDS — validation helpers
    // =========================================================================

    function validRewardType(t) {
      return (t is string)
        && (t == 'cash' || t == 'physical' || t == 'digital'
            || t == 'trophy' || t == 'other');
    }

    function validRewardFields() {
      let d = request.resource.data;
      return (d.position is int)
        && (d.position >= 1)
        && (d.position <= 1000)
        && (d.rewardName is string)
        && (d.rewardName.size() >= 1)
        && (d.rewardName.size() <= 120)
        && (d.rewardType is string)
        && validRewardType(d.rewardType)
        && (!('description' in d) || (d.description is string && d.description.size() <= 6000))
        && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2000));
    }

    // =========================================================================
    // CHAT — validation helpers
    // =========================================================================

    function validChatType(t) {
      return (t is string) && (t == 'text' || t == 'image' || t == 'code' || t == 'voice');
    }

    function isReasonableMs(ms) {
      return (ms is int)
        && (ms >= (request.time.toMillis() - 30 * 60 * 1000))
        && (ms <= (request.time.toMillis() + 30 * 60 * 1000));
    }

    function validChatMessageCreate(messageId) {
      return signedIn()
        && (request.resource.data.keys().hasOnly([
              'messageId', 'senderId', 'senderName', 'senderPhoto',
              'text', 'imageUrl', 'voiceUrl', 'type',
              'leagueId', 'timestamp',
              'createdAt', 'createdAtMs',
              'pinned', 'pinnedAt', 'pinnedBy',
              'deleted', 'deletedAt', 'deletedBy',
              'replyToMessageId', 'replyToSenderName', 'replyToText', 'replyToType'
            ]))
        && (request.resource.data.messageId is string)
        && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string)
        && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string)
        && (request.resource.data.senderName.size() >= 1)
        && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string)
        && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string)
        && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.voiceUrl is string)
        && (request.resource.data.voiceUrl.size() <= 2000)
        && (
          !('leagueId' in request.resource.data)
          || (
            (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId.size() <= 200)
          )
        )
        && isReasonableMs(request.resource.data.timestamp)
        && (request.resource.data.createdAt == request.time)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (
          !('pinned' in request.resource.data)
          || ((request.resource.data.pinned is bool) && (request.resource.data.pinned == false))
        )
        && (
          !('pinnedAt' in request.resource.data)
          || (request.resource.data.pinnedAt == null)
        )
        && (
          !('pinnedBy' in request.resource.data)
          || ((request.resource.data.pinnedBy is string) && (request.resource.data.pinnedBy == ''))
        )
        && (
          !('deleted' in request.resource.data)
          || ((request.resource.data.deleted is bool) && (request.resource.data.deleted == false))
        )
        && (
          !('deletedAt' in request.resource.data)
          || (request.resource.data.deletedAt == null)
        )
        && (
          !('deletedBy' in request.resource.data)
          || ((request.resource.data.deletedBy is string) && (request.resource.data.deletedBy == ''))
        )
        && (
          !('replyToMessageId' in request.resource.data)
          || (request.resource.data.replyToMessageId is string)
        )
        && (
          !('replyToSenderName' in request.resource.data)
          || ((request.resource.data.replyToSenderName is string) && (request.resource.data.replyToSenderName.size() <= 80))
        )
        && (
          !('replyToText' in request.resource.data)
          || ((request.resource.data.replyToText is string) && (request.resource.data.replyToText.size() <= 4000))
        )
        && (
          !('replyToType' in request.resource.data)
          || (
            (request.resource.data.replyToType is string)
            && (request.resource.data.replyToType == '' || validChatType(request.resource.data.replyToType))
          )
        )
        && (
          (request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == ''
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'code'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == ''
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'image'
            && request.resource.data.imageUrl.size() > 10
            && request.resource.data.voiceUrl == '')
          ||
          (request.resource.data.type == 'voice'
            && request.resource.data.voiceUrl.size() > 10
            && request.resource.data.imageUrl == '')
        );
    }

    function isChatPinUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'pinned', 'pinnedAt', 'pinnedBy'
        ]);
    }

    function validChatPinUpdate() {
      return isChatPinUpdate()
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinnedBy is string)
        && (
          (
            request.resource.data.pinned == true
            && (request.resource.data.pinnedBy == request.auth.uid)
            && (request.resource.data.pinnedAt == request.time)
          )
          ||
          (
            request.resource.data.pinned == false
            && (request.resource.data.pinnedBy == '')
            && (request.resource.data.pinnedAt == null)
          )
        );
    }

    function isChatSoftDeleteUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'deleted', 'deletedAt', 'deletedBy',
          'pinned', 'pinnedAt', 'pinnedBy'
        ]);
    }

    function validChatSoftDeleteUpdate() {
      return isChatSoftDeleteUpdate()
        && (request.resource.data.deleted is bool)
        && (request.resource.data.deleted == true)
        && (request.resource.data.deletedBy is string)
        && (request.resource.data.deletedBy == request.auth.uid)
        && (request.resource.data.deletedAt == request.time)
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinned == false)
        && (request.resource.data.pinnedBy is string)
        && (request.resource.data.pinnedBy == '')
        && (request.resource.data.pinnedAt == null);
    }

    function isGlobalChatApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid)).data.status == 'approved';
    }

    function canAccessGlobalChat() {
      return signedIn() && (isSuperAdmin() || isGlobalChatApproved());
    }

    function isGlobalChatAdmin() {
      let ad = adminsDoc();
      return signedIn()
        && ad.exists()
        && (ad.data.globalChatAdmins is list)
        && (request.auth.uid in ad.data.globalChatAdmins);
    }

    function allowGlobalSenderPin() {
      let ad = adminsDoc();
      return ad.exists()
        && ('allowGlobalSenderPin' in ad.data)
        && (ad.data.allowGlobalSenderPin is bool)
        && (ad.data.allowGlobalSenderPin == true);
    }

    function canPinGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (allowGlobalSenderPin()
            && ('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    function canDeleteGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    function canPinLeagueMessage(leagueId) {
      return canManageLeague(leagueId);
    }

    function canDeleteLeagueMessage(leagueId) {
      return canManageLeague(leagueId)
        || (('senderId' in resource.data)
            && (resource.data.senderId is string)
            && (resource.data.senderId == request.auth.uid));
    }

    // =========================================================================
    // QUICK MESSAGES
    // =========================================================================
    function validQuickMsg(s) {
      return (s is string)
        && (s.size() > 0)
        && (s.size() <= 15)
        && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*');
    }

    function validQuickMessages(list) {
      return (list is list)
        && (list.size() <= 15)
        && (list.size() < 1  || validQuickMsg(list[0]))
        && (list.size() < 2  || validQuickMsg(list[1]))
        && (list.size() < 3  || validQuickMsg(list[2]))
        && (list.size() < 4  || validQuickMsg(list[3]))
        && (list.size() < 5  || validQuickMsg(list[4]))
        && (list.size() < 6  || validQuickMsg(list[5]))
        && (list.size() < 7  || validQuickMsg(list[6]))
        && (list.size() < 8  || validQuickMsg(list[7]))
        && (list.size() < 9  || validQuickMsg(list[8]))
        && (list.size() < 10 || validQuickMsg(list[9]))
        && (list.size() < 11 || validQuickMsg(list[10]))
        && (list.size() < 12 || validQuickMsg(list[11]))
        && (list.size() < 13 || validQuickMsg(list[12]))
        && (list.size() < 14 || validQuickMsg(list[13]))
        && (list.size() < 15 || validQuickMsg(list[14]));
    }

    // =========================================================================
    // CALL ROOM HELPERS
    // =========================================================================
    function callRoomDoc(callId) {
      return get(/databases/$(database)/documents/call_rooms/$(callId));
    }

    function isCallParticipant(callId) {
      let cd = callRoomDoc(callId);
      return signedIn()
        && cd.exists()
        && (
          (('hostUserId' in cd.data) && (cd.data.hostUserId is string) && (cd.data.hostUserId == request.auth.uid))
          || (('createdBy' in cd.data) && (cd.data.createdBy is string) && (cd.data.createdBy == request.auth.uid))
          || (('participantIds' in cd.data) && (cd.data.participantIds is list) && (request.auth.uid in cd.data.participantIds))
        );
    }

    // =========================================================================
    // GLOBAL CHAT REQUESTS
    // =========================================================================
    match /globalChatRequests/{requestId} {
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if signedIn()
        && request.auth.uid == requestId
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.status is string)
        && (request.resource.data.status == 'pending');

      allow update: if signedIn()
        && (
          (
            isSuperAdmin()
            && (request.resource.data.status is string)
            && (request.resource.data.status in ['pending', 'approved', 'rejected'])
          )
          ||
          (
            request.auth.uid == requestId
            && (request.resource.data.status is string)
            && (request.resource.data.status == 'pending')
          )
        );

      allow delete: if false;
    }

    // =========================================================================
    // GLOBAL PUBLIC CHATROOM
    // =========================================================================
    match /globalChatroom/{messageId} {
      allow get, list: if canAccessGlobalChat();
      allow create: if canAccessGlobalChat() && validChatMessageCreate(messageId);

      allow update: if canAccessGlobalChat()
        && (
          (validChatPinUpdate() && canPinGlobalMessage())
          || (validChatSoftDeleteUpdate() && canDeleteGlobalMessage())
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll([
             'userId', 'teamName', 'authProvider', 'createdAt', 'updatedAt'
           ])
        && (
          !('shareId' in request.resource.data)
          || (
            (request.resource.data.shareId is string)
            && (request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$'))
          )
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'teamName', 'updatedAt'
          ])
          ||
          (
            resource.data.shareId == null
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'shareId', 'updatedAt'
            ])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'quickMessagesCustom', 'updatedAt'
            ])
            && validQuickMessages(request.resource.data.quickMessagesCustom)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'photoUrl', 'profileImageUrl', 'teamImageUrl', 'updatedAt'
            ])
            && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string))
            && (!('profileImageUrl' in request.resource.data) || (request.resource.data.profileImageUrl is string))
            && (!('teamImageUrl' in request.resource.data) || (request.resource.data.teamImageUrl is string))
            && (request.resource.data.updatedAt is int)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'isPremium', 'premiumExpiresAtMs', 'updatedAt'
            ])
            && (request.resource.data.isPremium is bool)
            && (request.resource.data.isPremium == true)
            && (request.resource.data.premiumExpiresAtMs is int)
            && (request.resource.data.premiumExpiresAtMs > request.time.toMillis())
          )
        );

      allow delete: if false;

      match /leagueCharges/{leagueId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow delete: if false;
      }

      // =========================================================================
      // ENTITLEMENTS (Master League premium unlock)
      // users/{uid}/entitlements/master_league
      // =========================================================================
      match /entitlements/{entitlementId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && entitlementId == 'master_league'
          && request.resource.data.keys().hasOnly([
            'active', 'purchasedAt', 'updatedAtMs'
          ])
          && (request.resource.data.active is bool)
          // Allow only enabling from client (server/admin can handle refunds separately).
          && (request.resource.data.active == true)
          && (!('purchasedAt' in request.resource.data) || request.resource.data.purchasedAt == null || (request.resource.data.purchasedAt is timestamp))
          && (!('updatedAtMs' in request.resource.data) || (request.resource.data.updatedAtMs is int));

        allow delete: if false;
      }

      // =========================================================================
      // FCM TOKENS (FIXED + RELAXED)
      //
      // Allows a signed-in user to store their own FCM tokens at:
      // users/{uid}/fcmTokens/{token}
      //
      // This is required for diagnostics and future token-based fanout.
      // =========================================================================
      match /fcmTokens/{tokenId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.token is string)
          && (request.resource.data.token == tokenId)
          // allow any extra fields for forward compatibility
          && (!('platform' in request.resource.data) || (request.resource.data.platform is string))
          && (!('updatedAt' in request.resource.data) || (request.resource.data.updatedAt is timestamp))
          && (!('updatedAtMs' in request.resource.data) || (request.resource.data.updatedAtMs is int));

        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // MASTER LEAGUES (Premium container)
    // =========================================================================
    match /master_leagues/{masterLeagueId} {
      allow get: if signedIn()
        && resource != null
        && (
          (('ownerId' in resource.data) && (resource.data.ownerId is string) && (resource.data.ownerId == request.auth.uid))
          || (('memberIds' in resource.data) && (resource.data.memberIds is list) && (request.auth.uid in resource.data.memberIds))
        );

      // IMPORTANT:
      // Keeping list permissive to match existing app pattern (leagues list is also signedIn()).
      // Your client queries are expected to filter by memberIds arrayContains.
      allow list: if signedIn();

      allow create: if signedIn()
        && (request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'createdAt', 'purchaseStatus', 'memberIds', 'updatedAtMs'
        ]))
        && (request.resource.data.name is string)
        && (request.resource.data.name.size() >= 1)
        && (request.resource.data.name.size() <= 60)
        && (request.resource.data.ownerId is string)
        && (request.resource.data.ownerId == request.auth.uid)
        && (request.resource.data.purchaseStatus is string)
        && (request.resource.data.purchaseStatus == 'active')
        && (!('memberIds' in request.resource.data) || ((request.resource.data.memberIds is list) && (request.auth.uid in request.resource.data.memberIds)))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == null || (request.resource.data.createdAt is timestamp))
        && (!('updatedAtMs' in request.resource.data) || (request.resource.data.updatedAtMs is int));

      allow update: if signedIn()
        && (resource.data.ownerId is string)
        && (resource.data.ownerId == request.auth.uid)
        && (request.resource.data.ownerId == resource.data.ownerId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name', 'memberIds', 'purchaseStatus', 'updatedAtMs'
        ])
        && (request.resource.data.name is string)
        && (request.resource.data.name.size() >= 1)
        && (request.resource.data.name.size() <= 60)
        && (!('memberIds' in request.resource.data) || (request.resource.data.memberIds is list))
        && (!('updatedAtMs' in request.resource.data) || (request.resource.data.updatedAtMs is int));

      allow delete: if signedIn()
        && (resource.data.ownerId is string)
        && (resource.data.ownerId == request.auth.uid);
    }

    // =========================================================================
    // LEAGUES
    // =========================================================================
    match /leagues/{leagueId} {

      allow get: if isSuperAdmin()
        || (
          signedIn()
          && (
            (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
            || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
            || (('organizerUserId' in resource.data) && looksLikeFirebaseUid(resource.data.organizerUserId) && (resource.data.organizerUserId == request.auth.uid))
            || (('ownerId' in resource.data) && looksLikeFirebaseUid(resource.data.ownerId) && (resource.data.ownerId == request.auth.uid))
            || ((resource.data.memberIds is list) && (request.auth.uid in resource.data.memberIds))

            // Master League System:
            // Allow Master League members to read competitions.
            || (
              ('masterLeagueId' in resource.data)
              && (resource.data.masterLeagueId is string)
              && isMasterLeagueMember(resource.data.masterLeagueId)
            )

            || ((resource.data.isPrivate is bool) && (resource.data.isPrivate == false))
            || ((resource.data.isPrivate is int) && (resource.data.isPrivate == 0))
            || ((resource.data.privacy is string) && (
              resource.data.privacy == 'public'
              || resource.data.privacy == 'PUBLIC'
              || resource.data.privacy == 'LeaguePrivacy.public'
            ))
            || (!('isPrivate' in resource.data) && !('privacy' in resource.data))
          )
        );

      allow list: if signedIn();

      allow create: if signedIn()
        && ('organizerUid' in request.resource.data)
        && (request.resource.data.organizerUid is string)
        && (request.resource.data.organizerUid == request.auth.uid)
        && (
          !(request.resource.data.memberIds is list)
          || (request.auth.uid in request.resource.data.memberIds)
        )
        // Master League System:
        // If creating under a Master League, only the Master League owner can do it.
        && (
          !('masterLeagueId' in request.resource.data)
          || (
            (request.resource.data.masterLeagueId is string)
            && validMasterLeagueId(request.resource.data.masterLeagueId)
            && isMasterLeagueOwner(request.resource.data.masterLeagueId)
          )
        );

      // Keep your existing update behavior, but prevent members from changing masterLeagueId.
      allow update: if (
          isOwnerDirect()
          || (
            signedIn()
            && (request.resource.data.memberIds is list)
            && (request.auth.uid in request.resource.data.memberIds)
            && !request.resource.data.diff(resource.data).changedKeys().hasAny(['masterLeagueId'])
          )
        )
        // If masterLeagueId is present, enforce validity; if it is being changed, require owner + master league ownership.
        && (
          !('masterLeagueId' in request.resource.data)
          || (
            (request.resource.data.masterLeagueId is string)
            && validMasterLeagueId(request.resource.data.masterLeagueId)
            && (
              !request.resource.data.diff(resource.data).changedKeys().hasAny(['masterLeagueId'])
              || isMasterLeagueOwner(request.resource.data.masterLeagueId)
            )
          )
        );

      allow delete: if isOwnerDirect();

      match /rewards/{rewardId} {
        allow get, list: if signedIn();
        allow create: if canManageLeague(leagueId) && validRewardFields();
        allow update: if canManageLeague(leagueId) && validRewardFields();
        allow delete: if canManageLeague(leagueId);
      }

      match /teams/{teamId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId);
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId);
      }

      match /knockout/{matchId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId);
      }

      match /memberships/{membershipId} {
        allow read: if signedIn();

        allow create: if canManageLeague(leagueId)
          || (
            signedIn()
            && request.auth.uid == membershipId
            && (request.resource.data.userId is string)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role is int)
            && (isMemberRole(request.resource.data.role) || isOrganizerRole(request.resource.data.role))
          );

        allow update: if canManageLeague(leagueId)
          || (
            signedIn()
            && request.auth.uid == membershipId
            && (resource.data.userId == request.auth.uid)
            && (resource.data.leagueId == leagueId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                 'teamId', 'updatedAtMs', 'version'
               ])
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role == resource.data.role)
          );

        allow delete: if canManageLeague(leagueId);
      }

      match /announcements/{annId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId);
      }

      match /chatroom/{messageId} {
        allow get, list: if isLeagueMemberNoGet(leagueId);

        allow create: if isLeagueMemberNoGet(leagueId)
          && validChatMessageCreate(messageId)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);

        allow update: if isLeagueMemberNoGet(leagueId)
          && (
            (validChatPinUpdate() && canPinLeagueMessage(leagueId))
            || (validChatSoftDeleteUpdate() && canDeleteLeagueMessage(leagueId))
          );

        allow delete: if canManageLeague(leagueId)
          || (signedIn()
              && (resource.data.senderId is string)
              && (resource.data.senderId == request.auth.uid));
      }

      match /space/{docId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (
            canManageLeague(leagueId)
            || (
              ('hostUserId' in request.resource.data)
              && (request.resource.data.hostUserId is string)
              && (request.resource.data.hostUserId == request.auth.uid)
            )
          );

        allow update: if signedIn()
          && (
            canManageLeague(leagueId)
            || (
              resource != null
              && ('hostUserId' in resource.data)
              && (resource.data.hostUserId is string)
              && (resource.data.hostUserId == request.auth.uid)
            )
            || (
              ('hostUserId' in request.resource.data)
              && (request.resource.data.hostUserId is string)
              && (request.resource.data.hostUserId == request.auth.uid)
            )
          );

        allow delete: if canManageLeague(leagueId);

        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create: if signedIn();
          allow update, delete: if false;
        }

        match /requests/{uid} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == uid;
          allow update: if signedIn() && (canManageLeague(leagueId) || (request.auth.uid == uid));
          allow delete: if signedIn() && (canManageLeague(leagueId) || (request.auth.uid == uid));
        }

        match /speakers/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if signedIn()
            && (
              canManageLeague(leagueId)
              || (
                exists(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId))
                && ('hostUserId' in get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data)
                && (get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data.hostUserId is string)
                && (get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data.hostUserId == request.auth.uid)
              )
            );
        }
      }

      match /couponConfig/{docId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);

        allow update: if signedIn()
          && (
            (
              (resource.data.organizerUserId is string)
              && (resource.data.organizerUserId == request.auth.uid)
            )
            ||
            (
              request.resource.data.diff(resource.data).changedKeys().hasOnly([
                'qtyRemaining', 'updatedAtMs'
              ])
              && (request.resource.data.qtyRemaining is int)
              && (request.resource.data.qtyRemaining == (resource.data.qtyRemaining - 1))
              && (request.resource.data.qtyRemaining >= 0)
            )
          );

        allow delete: if false;
      }

      match /couponCodes/{codeId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
               'usedBy', 'usedAtMs', 'updatedAtMs'
             ])
          && (resource.data.usedBy is string)
          && (resource.data.usedBy == '')
          && (request.resource.data.usedBy is string)
          && (request.resource.data.usedBy == request.auth.uid);

        allow delete: if false;
      }

      match /couponRedemptions/{uid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && uid == request.auth.uid
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow update: if signedIn()
          && uid == request.auth.uid
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid);

        allow delete: if false;
      }

      match /coupons/{couponId} {
        allow read, write: if false;
      }
    }

    // =========================================================================
    // TOP-LEVEL MATCHES (for highlights metadata only)
    // matches/{matchId}/highlights/{highlightId}
    // =========================================================================
    match /matches/{matchId} {
      // Parent doc not used by the highlights system. Keep locked down.
      allow get, list, create, update, delete: if false;

      match /highlights/{highlightId} {
        // Reads: only signed-in users who can read the league.
        // (If you want public unauthenticated viewing for public leagues, relax here carefully.)
        allow get, list: if signedIn()
          && ('leagueId' in resource.data)
          && (resource.data.leagueId is string)
          && canReadLeague(resource.data.leagueId);

        // Create: strict metadata validation + membership + match finished + participant team.
        allow create: if signedIn()
          && highlightCreateIsValid(matchId, highlightId);

        // Update:
        // - uploader can move UPLOADING <-> PROCESSING with strict constraints
        // - league managers can only change status (e.g. approve)
        allow update: if signedIn()
          && (
            highlightUploaderUpdateIsValid(matchId, highlightId)
            || highlightModeratorUpdateIsValid(matchId, highlightId)
          );

        // Delete: uploader can delete only their own UPLOADING doc (optional cleanup).
        allow delete: if signedIn()
          && ('uploadedBy' in resource.data)
          && (resource.data.uploadedBy is string)
          && (resource.data.uploadedBy == request.auth.uid)
          && ('status' in resource.data)
          && (resource.data.status is string)
          && (resource.data.status == 'UPLOADING');
      }
    }

    match /league_spaces/{spaceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /call_rooms/{callId} {
      allow get: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
        );

      allow list: if signedIn();

      allow create: if signedIn()
        && (
          (
            ('createdBy' in request.resource.data)
            && (request.resource.data.createdBy is string)
            && (request.resource.data.createdBy == request.auth.uid)
          )
          || (
            ('hostUserId' in request.resource.data)
            && (request.resource.data.hostUserId is string)
            && (request.resource.data.hostUserId == request.auth.uid)
          )
        );

      allow update: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
          || (
            ('participantIds' in request.resource.data)
            && (request.resource.data.participantIds is list)
            && (request.auth.uid in request.resource.data.participantIds)
          )
        );

      allow delete: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
        );

      match /quick_messages/{msgId} {
        allow read: if isCallParticipant(callId);

        allow create: if signedIn()
          && (request.resource.data.senderId is string)
          && (request.resource.data.senderId == request.auth.uid)
          && isCallParticipant(callId);

        allow update, delete: if false;
      }
    }

    match /marketplace_products/{productId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        && (request.resource.data.createdBy is string)
        && (request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.keys().hasAll([
             'productId', 'name', 'price', 'description', 'imageUrl',
             'affiliateUrl', 'category', 'sellerName', 'createdAt', 'createdBy'
           ])
        && (request.resource.data.productId is string)
        && (request.resource.data.productId == productId)
        && (request.resource.data.name is string)
        && (request.resource.data.price is string)
        && (request.resource.data.description is string)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.affiliateUrl is string)
        && (request.resource.data.category is string)
        && (request.resource.data.sellerName is string)
        && (request.resource.data.createdAt is timestamp);

      allow update, delete: if false;
    }

    match /app/{docId} {
      allow get, list: if (docId == 'pricing') || (docId == 'admins' && signedIn());
      allow create, update: if (docId == 'pricing' || docId == 'admins') && isPricingAdmin();
      allow delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && (request.resource.data.eventName is string)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid);

      allow get, list: if isPricingAdmin();
      allow update, delete: if false;
    }
  }
}
