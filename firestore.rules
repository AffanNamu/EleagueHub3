rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function isOwner(leagueId) {
      return signedIn() && leagueDoc(leagueId).data.organizerUserId == request.auth.uid;
    }

    function isMember(leagueId) {
      return signedIn()
        && (leagueDoc(leagueId).data.memberIds is list)
        && (request.auth.uid in leagueDoc(leagueId).data.memberIds);
    }

    function isLeagueFinished(leagueId) {
      let d = leagueDoc(leagueId).data;
      return (d.isFinished == true) || (d.isFinished == 1);
    }

    // Public/private detection.
    //
    // Secure-by-default:
    // - If privacy info is missing/unknown, the league is treated as private.
    //
    // Supports:
    // - legacy boolean `isPrivate: false`
    // - legacy int `isPrivate: 0` (your League.toJson writes 1/0)
    // - optional string `privacy: 'public'`
    function isPublicLeague(leagueId) {
      let d = leagueDoc(leagueId).data;

      return
        ((d.isPrivate is bool) && (d.isPrivate == false))
        ||
        ((d.isPrivate is int) && (d.isPrivate == 0))
        ||
        ((d.privacy is string) && (
          d.privacy == 'public'
          || d.privacy == 'PUBLIC'
          || d.privacy == 'LeaguePrivacy.public'
        ));
    }

    // Helper for safe numeric comparisons in update rules.
    function registeredCountOrZero(d) {
      return (d.registeredCount is int) ? d.registeredCount : 0;
    }

    // --------------------------
    // Quick messages validation (best-effort)
    // --------------------------
    function validQuickMsg(s) {
      // 1..15 chars, no urls, no mentions
      return (s is string)
        && (s.size() > 0)
        && (s.size() <= 15)
        && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*');
    }

    function validQuickMessages(list) {
      // Firestore rules have no loops, so we unroll checks up to 15 items.
      return (list is list)
        && (list.size() <= 15)
        && (list.size() < 1  || validQuickMsg(list[0]))
        && (list.size() < 2  || validQuickMsg(list[1]))
        && (list.size() < 3  || validQuickMsg(list[2]))
        && (list.size() < 4  || validQuickMsg(list[3]))
        && (list.size() < 5  || validQuickMsg(list[4]))
        && (list.size() < 6  || validQuickMsg(list[5]))
        && (list.size() < 7  || validQuickMsg(list[6]))
        && (list.size() < 8  || validQuickMsg(list[7]))
        && (list.size() < 9  || validQuickMsg(list[8]))
        && (list.size() < 10 || validQuickMsg(list[9]))
        && (list.size() < 11 || validQuickMsg(list[10]))
        && (list.size() < 12 || validQuickMsg(list[11]))
        && (list.size() < 13 || validQuickMsg(list[12]))
        && (list.size() < 14 || validQuickMsg(list[13]))
        && (list.size() < 15 || validQuickMsg(list[14]));
    }

    // --------------------------
    // User Profiles (Firebase uid is doc id)
    // --------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll([
          'userId',
          'teamName',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && (
          !('shareId' in request.resource.data)
          || (
            (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'teamName',
            'updatedAt'
          ])
          ||
          (
            resource.data.shareId == null
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'shareId',
              'updatedAt'
            ])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'quickMessagesCustom',
              'updatedAt'
            ])
            && validQuickMessages(request.resource.data.quickMessagesCustom)
          )
        );

      allow delete: if false;
    }

    match /leagues/{leagueId} {
      allow get: if isOwner(leagueId) || isMember(leagueId) || isPublicLeague(leagueId);
      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        && (
          !(request.resource.data.memberIds is list)
          || (request.auth.uid in request.resource.data.memberIds)
        );

      allow update: if isOwner(leagueId)
        || (signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
          && (request.resource.data.memberIds is list)
          && (request.auth.uid in request.resource.data.memberIds))
        || (signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'memberIds',
            'updatedAtMs',
            'registeredCount',
            'isFull'
          ])
          && (request.resource.data.memberIds is list)
          && (request.auth.uid in request.resource.data.memberIds)

          && (
            (
              (resource.data.memberIds is list)
              && request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
              && !(request.auth.uid in resource.data.memberIds)
            )
            ||
            (
              !(resource.data.memberIds is list)
              && request.resource.data.memberIds.size() == 1
              && (request.auth.uid in request.resource.data.memberIds)
            )
          )

          && (request.resource.data.registeredCount is int)
          && request.resource.data.registeredCount == (registeredCountOrZero(resource.data) + 1)

          && (
            (request.resource.data.isFull is bool)
            && (
              request.resource.data.isFull
              ==
              (request.resource.data.registeredCount >= ((resource.data.maxTeams is int) ? resource.data.maxTeams : request.resource.data.maxTeams))
            )
          )
        );

      allow delete: if isOwner(leagueId);

      match /teams/{teamId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /matches/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /knockout/{matchId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /memberships/{membershipId} {
        allow get: if isOwner(leagueId) || isMember(leagueId) || (signedIn() && membershipId == request.auth.uid);
        allow list: if isOwner(leagueId) || isMember(leagueId);

        allow create, update: if isOwner(leagueId)
          || (
            signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.leagueId == leagueId
          );

        allow delete: if isOwner(leagueId);
      }

      match /announcements/{annId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);
      }

      match /space/{docId} {
        allow read: if isOwner(leagueId) || isMember(leagueId);
        allow write: if isOwner(leagueId);

        match /reactions/{reactionId} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create: if signedIn() && (isOwner(leagueId) || isMember(leagueId));
          allow update, delete: if false;
        }

        match /requests/{uid} {
          allow get: if isOwner(leagueId) || (signedIn() && request.auth.uid == uid);
          allow list: if isOwner(leagueId);

          allow create: if signedIn()
            && (isOwner(leagueId) || isMember(leagueId))
            && request.auth.uid == uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending";

          allow update: if signedIn() && (
            isOwner(leagueId)
            || (request.auth.uid == uid)
          );

          allow delete: if signedIn() && (
            isOwner(leagueId) || (request.auth.uid == uid)
          );
        }

        match /speakers/{uid} {
          allow read: if isOwner(leagueId) || isMember(leagueId);
          allow create, update, delete: if isOwner(leagueId);
        }
      }

      // --------------------------
      // Coupons (league-specific)
      // --------------------------
      match /coupons/{couponId} {
        // Reservation TTL (server-enforced).
        function reservationTtl() {
          return duration.value(15, 'm');
        }

        function strEmpty(v) {
          return !(v is string) || v == null || v == '';
        }

        function couponUnused(d) {
          return !('usedBy' in d) || strEmpty(d.usedBy);
        }

        function reservedBy(d) {
          return ('reservedBy' in d) ? d.reservedBy : '';
        }

        function reservedUntil(d) {
          return ('reservedUntil' in d) ? d.reservedUntil : null;
        }

        function couponReserved(d) {
          return !strEmpty(reservedBy(d)) && (reservedUntil(d) is timestamp);
        }

        function reservationExpired(d) {
          return !couponReserved(d) || (reservedUntil(d) <= request.time);
        }

        function canReserveNow(d) {
          return couponUnused(d)
            && (
              !couponReserved(d)
              || reservationExpired(d)
              || (reservedBy(d) == request.auth.uid)
            );
        }

        // Organizer can list their coupons. Participants should not enumerate.
        allow list: if isOwner(leagueId);

        // Anyone signed-in can GET a coupon if they know its id (code).
        // The coupon code itself is the secret; do not allow list.
        allow get: if signedIn();

        // Only organizer can create coupons for their league.
        allow create: if isOwner(leagueId)
          && !isLeagueFinished(leagueId)
          && (request.resource.data.leagueId is string)
          && request.resource.data.leagueId == leagueId
          && (request.resource.data.code is string)
          && request.resource.data.code == couponId
          && (request.resource.data.organizerUserId is string)
          && request.resource.data.organizerUserId == request.auth.uid
          && (request.resource.data.discountPercent is int)
          && request.resource.data.discountPercent >= 5
          && request.resource.data.discountPercent <= 100
          && (
            !('usedBy' in request.resource.data)
            || strEmpty(request.resource.data.usedBy)
          )
          && (
            !('usedAtMs' in request.resource.data)
            || (request.resource.data.usedAtMs is int && request.resource.data.usedAtMs == 0)
          )
          && (
            !('reservedBy' in request.resource.data)
            || strEmpty(request.resource.data.reservedBy)
          );

        // Organizer can update coupon docs freely.
        // Participants:
        // 1) Reserve: set reservedBy/reservedAt/reservedUntil (bounded to TTL)
        // 2) Release their own reservation: clear reserved fields
        // 3) Finalize use: set usedBy/usedAtMs and clear reservation, only if reserved by them and not expired
        allow update: if isOwner(leagueId)

          // Reserve
          || (
            signedIn()
            && !isLeagueFinished(leagueId)
            && (resource.data.leagueId == leagueId)
            && canReserveNow(resource.data)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'reservedBy',
              'reservedAt',
              'reservedUntil',
              'updatedAtMs'
            ])
            && (request.resource.data.reservedBy is string)
            && request.resource.data.reservedBy == request.auth.uid
            && (request.resource.data.reservedAt is timestamp)
            && (request.resource.data.reservedUntil is timestamp)
            // keep reservedAt close to server time (prevents far-future reservations)
            && request.resource.data.reservedAt >= request.time - duration.value(2, 'm')
            && request.resource.data.reservedAt <= request.time + duration.value(2, 'm')
            // enforce TTL window exactly (prevents locking coupon for long)
            && request.resource.data.reservedUntil == request.resource.data.reservedAt + reservationTtl()
            && request.resource.data.reservedUntil > request.time
            // do not allow client to mark used during reserve
            && couponUnused(request.resource.data)
          )

          // Release reservation (same user only)
          || (
            signedIn()
            && !isLeagueFinished(leagueId)
            && (resource.data.leagueId == leagueId)
            && couponUnused(resource.data)
            && (reservedBy(resource.data) == request.auth.uid)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'reservedBy',
              'reservedAt',
              'reservedUntil',
              'updatedAtMs'
            ])
            && (
              !('reservedBy' in request.resource.data)
              || strEmpty(request.resource.data.reservedBy)
            )
            && (
              !('reservedAt' in request.resource.data)
              || request.resource.data.reservedAt == null
            )
            && (
              !('reservedUntil' in request.resource.data)
              || request.resource.data.reservedUntil == null
            )
          )

          // Finalize use (one-time)
          || (
            signedIn()
            && !isLeagueFinished(leagueId)
            && (resource.data.leagueId == leagueId)
            && couponUnused(resource.data)
            && couponReserved(resource.data)
            && (reservedBy(resource.data) == request.auth.uid)
            && !reservationExpired(resource.data)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'usedBy',
              'usedAtMs',
              'reservedBy',
              'reservedAt',
              'reservedUntil',
              'updatedAtMs'
            ])
            && (request.resource.data.usedBy is string)
            && request.resource.data.usedBy == request.auth.uid
            && (request.resource.data.usedAtMs is int)
            && request.resource.data.usedAtMs > 0
            // clear reservation fields when used
            && (
              !('reservedBy' in request.resource.data)
              || strEmpty(request.resource.data.reservedBy)
            )
            && (
              !('reservedAt' in request.resource.data)
              || request.resource.data.reservedAt == null
            )
            && (
              !('reservedUntil' in request.resource.data)
              || request.resource.data.reservedUntil == null
            )
          );

        allow delete: if isOwner(leagueId);
      }
    }

    match /league_spaces/{spaceId} {
      allow read: if signedIn()
        && (resource.data.leagueId is string)
        && (isOwner(resource.data.leagueId) || isMember(resource.data.leagueId));

      allow create: if signedIn()
        && (request.resource.data.leagueId is string)
        && isOwner(request.resource.data.leagueId);

      allow update, delete: if signedIn()
        && (resource.data.leagueId is string)
        && isOwner(resource.data.leagueId);
    }
  }
}
