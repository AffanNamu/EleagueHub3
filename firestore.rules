rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /leagues/{leagueId} {
      function isOwner() {
        return signedIn() && resource.data.organizerUserId == request.auth.uid;
      }
      function isMember() {
        return signedIn()
          && (resource.data.memberIds is list)
          && (request.auth.uid in resource.data.memberIds);
      }

      // League doc
      allow get: if (!resource.data.isPrivate) || isOwner() || isMember();
      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        && (request.resource.data.memberIds is list)
        && (request.auth.uid in request.resource.data.memberIds);

      // Owner edits + join-self
      allow update: if isOwner()
        || (signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
          && request.auth.uid in request.resource.data.memberIds);

      allow delete: if isOwner();

      // Subcollections: teams/matches/knockout/memberships
      match /teams/{teamId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /matches/{matchId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /knockout/{matchId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /memberships/{membershipId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner()
          || (signedIn() && request.resource.data.userId == request.auth.uid);
      }
    }
  }
}
