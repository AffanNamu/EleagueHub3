rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    function adminsDoc() {
      return get(/databases/$(database)/documents/app/admins);
    }

    function isPricingAdmin() {
      return signedIn() && (
        request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        ||
        (adminsDoc().exists()
          && (adminsDoc().data.pricingAdmins is list)
          && (request.auth.uid in adminsDoc().data.pricingAdmins))
      );
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1';
    }

    // =========================================================================
    // Organizer Pro via server-issued Firebase Auth Custom Claims
    // =========================================================================
    function organizerProActiveFromClaims() {
      return signedIn()
        && (request.auth.token.organizerPro == true)
        && (request.auth.token.organizerProExpiryMs is int)
        && (request.auth.token.organizerProExpiryMs > request.time.toMillis());
    }

    function organizerProPlanFromClaims() {
      return signedIn()
        && (request.auth.token.organizerProPlan is string)
        && (request.auth.token.organizerProPlan in ['basic', 'pro', 'elite'])
        ? request.auth.token.organizerProPlan
        : '';
    }

    function organizerProClaimsValid() {
      return organizerProActiveFromClaims()
        && (organizerProPlanFromClaims() in ['basic', 'pro', 'elite']);
    }

    function organizerProOrSuperAdmin() {
      return isSuperAdmin() || organizerProActiveFromClaims();
    }

    function organizerProOrSuperAdminWithPlan() {
      return isSuperAdmin() || organizerProClaimsValid();
    }

    match /organizer_pro_entitlements/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function masterLeagueDoc(masterLeagueId) {
      return get(/databases/$(database)/documents/master_leagues/$(masterLeagueId));
    }

    function validMasterLeagueId(id) {
      return (id is string) && (id.size() > 0) && (id.size() <= 200);
    }

    function validMasterLeagueSocialLinksMap(links) {
      return (links is map)
        && links.keys().hasOnly([
          'website',
          'facebook',
          'instagram',
          'x',
          'twitter',
          'discord',
          'youtube',
          'twitch',
          'tiktok'
        ])
        && (!('website' in links) || ((links.website is string) && (links.website.size() <= 2000)))
        && (!('facebook' in links) || ((links.facebook is string) && (links.facebook.size() <= 2000)))
        && (!('instagram' in links) || ((links.instagram is string) && (links.instagram.size() <= 2000)))
        && (!('x' in links) || ((links.x is string) && (links.x.size() <= 2000)))
        && (!('twitter' in links) || ((links.twitter is string) && (links.twitter.size() <= 2000)))
        && (!('discord' in links) || ((links.discord is string) && (links.discord.size() <= 2000)))
        && (!('youtube' in links) || ((links.youtube is string) && (links.youtube.size() <= 2000)))
        && (!('twitch' in links) || ((links.twitch is string) && (links.twitch.size() <= 2000)))
        && (!('tiktok' in links) || ((links.tiktok is string) && (links.tiktok.size() <= 2000)));
    }

    function validMasterLeagueOptionalFields(data) {
      return (!('bannerUrl' in data) || ((data.bannerUrl is string) && (data.bannerUrl.size() <= 2000)))
        && (!('logoUrl' in data) || ((data.logoUrl is string) && (data.logoUrl.size() <= 2000)))
        && (!('bio' in data) || ((data.bio is string) && (data.bio.size() <= 2000)))
        && (!('badge' in data) || ((data.badge is string) && (data.badge.size() <= 80)))
        && (!('socialLinks' in data) || validMasterLeagueSocialLinksMap(data.socialLinks))
        && (!('staffShareIds' in data) || (data.staffShareIds is map))
        && (!('totalTournamentsCreated' in data) || ((data.totalTournamentsCreated is int) && (data.totalTournamentsCreated >= 0)))
        && (!('totalParticipantsTeams' in data) || ((data.totalParticipantsTeams is int) && (data.totalParticipantsTeams >= 0)))
        && (!('totalMatches' in data) || ((data.totalMatches is int) && (data.totalMatches >= 0)));
    }

    function masterLeaguePlanId(masterLeagueId) {
      let ml = masterLeagueDoc(masterLeagueId);
      return (ml.exists() && ('plan' in ml.data) && (ml.data.plan is string)) ? ml.data.plan : 'basic';
    }

    function allowedMasterLeagueIdForPlan(masterLeagueId, planId) {
      return signedIn()
        && (planId is string)
        && (
          (planId == 'elite')
          || (planId == 'basic' && masterLeagueId == ('ml_' + request.auth.uid + '_1'))
          || (planId == 'pro' && (
            masterLeagueId == ('ml_' + request.auth.uid + '_1')
            || masterLeagueId == ('ml_' + request.auth.uid + '_2')
            || masterLeagueId == ('ml_' + request.auth.uid + '_3')
            || masterLeagueId == ('ml_' + request.auth.uid + '_4')
            || masterLeagueId == ('ml_' + request.auth.uid + '_5')
          ))
        );
    }

    function allowedCompetitionLeagueIdForMasterLeague(leagueId, masterLeagueId) {
      let planId = masterLeaguePlanId(masterLeagueId);

      return signedIn()
        && (leagueId is string) && (leagueId.size() > 0) && (leagueId.size() <= 200)
        && validMasterLeagueId(masterLeagueId)
        && (
          (planId == 'elite')
          || (planId == 'basic' && (
            leagueId == ('mlc_' + masterLeagueId + '_1')
            || leagueId == ('mlc_' + masterLeagueId + '_2')
            || leagueId == ('mlc_' + masterLeagueId + '_3')
          ))
          || (planId == 'pro' && (
            leagueId == ('mlc_' + masterLeagueId + '_1')
            || leagueId == ('mlc_' + masterLeagueId + '_2')
            || leagueId == ('mlc_' + masterLeagueId + '_3')
            || leagueId == ('mlc_' + masterLeagueId + '_4')
            || leagueId == ('mlc_' + masterLeagueId + '_5')
            || leagueId == ('mlc_' + masterLeagueId + '_6')
            || leagueId == ('mlc_' + masterLeagueId + '_7')
            || leagueId == ('mlc_' + masterLeagueId + '_8')
            || leagueId == ('mlc_' + masterLeagueId + '_9')
          ))
        );
    }

    function isMasterLeagueOwner(masterLeagueId) {
      let ml = masterLeagueDoc(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && ml.exists()
        && ('ownerId' in ml.data)
        && (ml.data.ownerId is string)
        && (ml.data.ownerId == request.auth.uid);
    }

    function isMasterLeagueMember(masterLeagueId) {
      let ml = masterLeagueDoc(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && ml.exists()
        && (
          (('ownerId' in ml.data) && (ml.data.ownerId is string) && (ml.data.ownerId == request.auth.uid))
          || (('memberIds' in ml.data) && (ml.data.memberIds is list) && (request.auth.uid in ml.data.memberIds))
        );
    }

    function masterLeagueEntitlementDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/entitlements/master_league);
    }

    function masterLeagueSubscriptionActive(uid) {
      let ed = masterLeagueEntitlementDoc(uid);
      return signedIn()
        && (uid is string)
        && (uid == request.auth.uid)
        && ed.exists()
        && ('active' in ed.data)
        && (ed.data.active is bool)
        && (ed.data.active == true)
        && (
          !('expiresAtMs' in ed.data)
          || (
            (ed.data.expiresAtMs is int)
            && (ed.data.expiresAtMs > request.time.toMillis())
          )
        );
    }

    function isOwner(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (('organizerUserId' in ld.data) && looksLikeFirebaseUid(ld.data.organizerUserId) && (ld.data.organizerUserId == request.auth.uid))
          || (('ownerId' in ld.data) && looksLikeFirebaseUid(ld.data.ownerId) && (ld.data.ownerId == request.auth.uid))
        );
    }

    function isOwnerDirect() {
      return signedIn()
        && resource != null
        && (
          (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
          || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
          || (('organizerUserId' in resource.data) && looksLikeFirebaseUid(resource.data.organizerUserId) && (resource.data.organizerUserId == request.auth.uid))
          || (('ownerId' in resource.data) && looksLikeFirebaseUid(resource.data.ownerId) && (resource.data.ownerId == request.auth.uid))
        );
    }

    function isOrganizerByMembership(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid)).data.role == 0;
    }

    function isLeagueMemberNoGet(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid));
    }

    function isOrganizerRole(role) { return (role is int) && role == 0; }
    function isMemberRole(role)    { return (role is int) && role == 1; }

    function canManageLeague(leagueId) {
      return isSuperAdmin() || isOwner(leagueId) || isOrganizerByMembership(leagueId);
    }

    function canReadLeague(leagueId) {
      let ld = leagueDoc(leagueId);
      return isSuperAdmin()
        || (
          signedIn()
          && ld.exists()
          && (
            (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
            || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
            || (('organizerUserId' in ld.data) && looksLikeFirebaseUid(ld.data.organizerUserId) && (ld.data.organizerUserId == request.auth.uid))
            || (('ownerId' in ld.data) && looksLikeFirebaseUid(ld.data.ownerId) && (ld.data.ownerId == request.auth.uid))
            || ((ld.data.memberIds is list) && (request.auth.uid in ld.data.memberIds))
            || (('masterLeagueId' in ld.data) && (ld.data.masterLeagueId is string) && isMasterLeagueMember(ld.data.masterLeagueId))
            || ((ld.data.isPrivate is bool) && (ld.data.isPrivate == false))
            || ((ld.data.isPrivate is int) && (ld.data.isPrivate == 0))
            || ((ld.data.privacy is string) && (ld.data.privacy == 'public' || ld.data.privacy == 'PUBLIC' || ld.data.privacy == 'LeaguePrivacy.public'))
          )
        )
        || (signedIn() && ld.exists() && !('isPrivate' in ld.data) && !('privacy' in ld.data));
    }

    function membershipDoc(leagueId, uid) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(uid));
    }

    function leagueMatchDoc(leagueId, matchId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/matches/$(matchId));
    }

    function matchIsFinished(matchDoc) {
      return matchDoc.exists()
        && (
          (('isPlayed' in matchDoc.data) && (matchDoc.data.isPlayed is bool) && (matchDoc.data.isPlayed == true))
          || (('status' in matchDoc.data) && (matchDoc.data.status is string) && (matchDoc.data.status == 'FINISHED'))
          || (('matchStatus' in matchDoc.data) && (matchDoc.data.matchStatus is string) && (matchDoc.data.matchStatus == 'FINISHED'))
        );
    }

    function matchHasTeams(matchDoc) {
      return matchDoc.exists()
        && ('homeTeamId' in matchDoc.data) && (matchDoc.data.homeTeamId is string) && (matchDoc.data.homeTeamId.size() > 0)
        && ('awayTeamId' in matchDoc.data) && (matchDoc.data.awayTeamId is string) && (matchDoc.data.awayTeamId.size() > 0);
    }

    function isParticipantTeam(matchDoc, teamId) {
      return matchHasTeams(matchDoc) && ((matchDoc.data.homeTeamId == teamId) || (matchDoc.data.awayTeamId == teamId));
    }

    function highlightHasOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly(['matchId','leagueId','teamId','uploadedBy','cloudinaryPublicId','secureUrl','thumbnailUrl','duration','size','format','status','createdAt','updatedAt']);
    }

    function highlightFieldsAreValid(matchId, highlightId) {
      let d = request.resource.data;
      let maxBytes = 15 * 1024 * 1024;
      let maxSeconds = 180;
      return highlightHasOnlyAllowedKeys()
        && (d.matchId is string) && (d.matchId == matchId)
        && (d.leagueId is string) && (d.leagueId.size() > 0) && (d.leagueId.size() <= 200)
        && (d.teamId is string) && (d.teamId.size() > 0) && (d.teamId.size() <= 200)
        && (d.uploadedBy is string) && (d.uploadedBy == request.auth.uid)
        && (d.cloudinaryPublicId is string) && (d.cloudinaryPublicId == ('match_highlights/' + d.leagueId + '/' + matchId + '/' + d.teamId + '/' + highlightId)) && (d.cloudinaryPublicId.size() <= 600)
        && (d.secureUrl is string) && (d.secureUrl.size() <= 2000)
        && (d.thumbnailUrl is string) && (d.thumbnailUrl.size() <= 2000)
        && (d.duration is int || d.duration is float) && (d.duration >= 0) && (d.duration <= maxSeconds)
        && (d.size is int) && (d.size >= 0) && (d.size <= maxBytes)
        && (d.format is string) && (d.format.size() <= 10)
        && (d.status is string) && (d.status in ['UPLOADING', 'PROCESSING', 'APPROVED'])
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp))
        && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderIsLeagueParticipant(matchId, highlightId) {
      let d = request.resource.data;
      let mem = membershipDoc(d.leagueId, request.auth.uid);
      let md = leagueMatchDoc(d.leagueId, matchId);
      return signedIn() && mem.exists() && ('teamId' in mem.data) && (mem.data.teamId is string) && (mem.data.teamId == d.teamId) && matchIsFinished(md) && isParticipantTeam(md, d.teamId);
    }

    function highlightCreateIsValid(matchId, highlightId) {
      let d = request.resource.data;
      return highlightFieldsAreValid(matchId, highlightId) && highlightUploaderIsLeagueParticipant(matchId, highlightId)
        && (d.status == 'UPLOADING') && (d.secureUrl == '') && (d.thumbnailUrl == '') && (d.duration == 0 || d.duration == 0.0) && (d.size == 0) && (d.format == '')
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp)) && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderUpdateIsValid(matchId, highlightId) {
      let d = request.resource.data;
      let identityUnchanged = (d.matchId == resource.data.matchId) && (d.leagueId == resource.data.leagueId) && (d.teamId == resource.data.teamId) && (d.uploadedBy == resource.data.uploadedBy) && (d.cloudinaryPublicId == resource.data.cloudinaryPublicId);
      let isUploader = signedIn() && ('uploadedBy' in resource.data) && (resource.data.uploadedBy is string) && (resource.data.uploadedBy == request.auth.uid);
      let md = leagueMatchDoc(resource.data.leagueId, matchId);
      let mem = membershipDoc(resource.data.leagueId, request.auth.uid);
      let stillAllowed = mem.exists() && ('teamId' in mem.data) && (mem.data.teamId is string) && (mem.data.teamId == resource.data.teamId) && matchIsFinished(md) && isParticipantTeam(md, resource.data.teamId);
      let uploadingStateOk = (d.status == 'UPLOADING') && (d.secureUrl == '') && (d.thumbnailUrl == '') && (d.size == 0) && (d.duration == 0 || d.duration == 0.0) && (d.format == '' || d.format == 'mp4');
      let processingStateOk = (d.status == 'PROCESSING') && (d.secureUrl.size() > 10) && (d.thumbnailUrl.size() > 10) && (d.size > 0) && (d.duration > 0) && (d.format == 'mp4');
      return highlightFieldsAreValid(matchId, highlightId) && identityUnchanged && isUploader && stillAllowed && (uploadingStateOk || processingStateOk);
    }

    function highlightModeratorUpdateIsValid(matchId, highlightId) {
      return signedIn() && canManageLeague(resource.data.leagueId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status is string) && (request.resource.data.status in ['PROCESSING', 'APPROVED'])
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == null || (request.resource.data.updatedAt is timestamp));
    }

    function validRewardType(t) { return (t is string) && (t == 'cash' || t == 'physical' || t == 'digital' || t == 'trophy' || t == 'other'); }
    function validRewardFields() {
      let d = request.resource.data;
      return (d.position is int) && (d.position >= 1) && (d.position <= 1000) && (d.rewardName is string) && (d.rewardName.size() >= 1) && (d.rewardName.size() <= 120) && (d.rewardType is string) && validRewardType(d.rewardType) && (!('description' in d) || (d.description is string && d.description.size() <= 6000)) && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2000));
    }

    function validChatType(t) { return (t is string) && (t == 'text' || t == 'image' || t == 'code' || t == 'voice'); }
    function isReasonableMs(ms) { return (ms is int) && (ms >= (request.time.toMillis() - 30 * 60 * 1000)) && (ms <= (request.time.toMillis() + 30 * 60 * 1000)); }

    function validChatMessageCreate(messageId) {
      return signedIn()
        && (request.resource.data.keys().hasOnly(['messageId','senderId','senderName','senderPhoto','text','imageUrl','voiceUrl','type','leagueId','timestamp','createdAt','createdAtMs','pinned','pinnedAt','pinnedBy','deleted','deletedAt','deletedBy','replyToMessageId','replyToSenderName','replyToText','replyToType']))
        && (request.resource.data.messageId is string) && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string) && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string) && (request.resource.data.senderName.size() >= 1) && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string) && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string) && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string) && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.voiceUrl is string) && (request.resource.data.voiceUrl.size() <= 2000)
        && (!('leagueId' in request.resource.data) || ((request.resource.data.leagueId is string) && (request.resource.data.leagueId.size() <= 200)))
        && isReasonableMs(request.resource.data.timestamp) && (request.resource.data.createdAt == request.time) && isReasonableMs(request.resource.data.createdAtMs)
        && (!('pinned' in request.resource.data) || ((request.resource.data.pinned is bool) && (request.resource.data.pinned == false)))
        && (!('pinnedAt' in request.resource.data) || (request.resource.data.pinnedAt == null))
        && (!('pinnedBy' in request.resource.data) || ((request.resource.data.pinnedBy is string) && (request.resource.data.pinnedBy == '')))
        && (!('deleted' in request.resource.data) || ((request.resource.data.deleted is bool) && (request.resource.data.deleted == false)))
        && (!('deletedAt' in request.resource.data) || (request.resource.data.deletedAt == null))
        && (!('deletedBy' in request.resource.data) || ((request.resource.data.deletedBy is string) && (request.resource.data.deletedBy == '')))
        && (!('replyToMessageId' in request.resource.data) || (request.resource.data.replyToMessageId is string))
        && (!('replyToSenderName' in request.resource.data) || ((request.resource.data.replyToSenderName is string) && (request.resource.data.replyToSenderName.size() <= 80)))
        && (!('replyToText' in request.resource.data) || ((request.resource.data.replyToText is string) && (request.resource.data.replyToText.size() <= 4000)))
        && (!('replyToType' in request.resource.data) || ((request.resource.data.replyToType is string) && (request.resource.data.replyToType == '' || validChatType(request.resource.data.replyToType))))
        && ((request.resource.data.type == 'text' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '') || (request.resource.data.type == 'code' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '') || (request.resource.data.type == 'image' && request.resource.data.imageUrl.size() > 10 && request.resource.data.voiceUrl == '') || (request.resource.data.type == 'voice' && request.resource.data.voiceUrl.size() > 10 && request.resource.data.imageUrl == ''));
    }

    function isChatPinUpdate() { return signedIn() && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true)) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['pinned','pinnedAt','pinnedBy']); }
    function validChatPinUpdate() { return isChatPinUpdate() && (request.resource.data.pinned is bool) && (request.resource.data.pinnedBy is string) && ((request.resource.data.pinned == true && (request.resource.data.pinnedBy == request.auth.uid) && (request.resource.data.pinnedAt == request.time)) || (request.resource.data.pinned == false && (request.resource.data.pinnedBy == '') && (request.resource.data.pinnedAt == null))); }
    function isChatSoftDeleteUpdate() { return signedIn() && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true)) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted','deletedAt','deletedBy','pinned','pinnedAt','pinnedBy']); }
    function validChatSoftDeleteUpdate() { return isChatSoftDeleteUpdate() && (request.resource.data.deleted is bool) && (request.resource.data.deleted == true) && (request.resource.data.deletedBy is string) && (request.resource.data.deletedBy == request.auth.uid) && (request.resource.data.deletedAt == request.time) && (request.resource.data.pinned is bool) && (request.resource.data.pinned == false) && (request.resource.data.pinnedBy is string) && (request.resource.data.pinnedBy == '') && (request.resource.data.pinnedAt == null); }

    function isGlobalChatApproved() { return signedIn() && exists(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid)) && get(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid)).data.status == 'approved'; }
    function canAccessGlobalChat() { return signedIn() && (isSuperAdmin() || isGlobalChatApproved()); }
    function isGlobalChatAdmin() { let ad = adminsDoc(); return signedIn() && ad.exists() && (ad.data.globalChatAdmins is list) && (request.auth.uid in ad.data.globalChatAdmins); }
    function allowGlobalSenderPin() { let ad = adminsDoc(); return ad.exists() && ('allowGlobalSenderPin' in ad.data) && (ad.data.allowGlobalSenderPin is bool) && (ad.data.allowGlobalSenderPin == true); }
    function canPinGlobalMessage() { return isSuperAdmin() || isGlobalChatAdmin() || (allowGlobalSenderPin() && ('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid)); }
    function canDeleteGlobalMessage() { return isSuperAdmin() || isGlobalChatAdmin() || (('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid)); }
    function canPinLeagueMessage(leagueId) { return canManageLeague(leagueId); }
    function canDeleteLeagueMessage(leagueId) { return canManageLeague(leagueId) || (('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid)); }

    function validQuickMsg(s) { return (s is string) && (s.size() > 0) && (s.size() <= 15) && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*'); }
