rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────────

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    function isNumericMs(v) {
      return (v is int) || (v is float) || (v is timestamp);
    }

    function toMs(v) {
      return (v is timestamp) ? v.toMillis() : v;
    }

    function isPricingAdmin() {
      let adminPath = /databases/$(database)/documents/app/admins;
      return signedIn() && (
        request.auth.uid == 'QhYeBpvAoRV6j0xGigHkBth4qIG3'
        ||
        (
          exists(adminPath)
          && (request.auth.uid in get(adminPath).data.get('pricingAdmins', []))
        )
      );
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'QhYeBpvAoRV6j0xGigHkBth4qIG3';
    }

    function validMasterLeagueId(id) {
      return (id is string) && (id.size() > 0) && (id.size() <= 200);
    }

    function validMasterLeagueSocialLinksMap(links) {
      return (links is map)
        && links.keys().hasOnly([
          'website','facebook','instagram','x','twitter','discord',
          'youtube','twitch','tiktok'
        ])
        && (!('website' in links) || ((links.website is string) && (links.website.size() <= 2000)))
        && (!('facebook' in links) || ((links.facebook is string) && (links.facebook.size() <= 2000)))
        && (!('instagram' in links) || ((links.instagram is string) && (links.instagram.size() <= 2000)))
        && (!('x' in links) || ((links.x is string) && (links.x.size() <= 2000)))
        && (!('twitter' in links) || ((links.twitter is string) && (links.twitter.size() <= 2000)))
        && (!('discord' in links) || ((links.discord is string) && (links.discord.size() <= 2000)))
        && (!('youtube' in links) || ((links.youtube is string) && (links.youtube.size() <= 2000)))
        && (!('twitch' in links) || ((links.twitch is string) && (links.twitch.size() <= 2000)))
        && (!('tiktok' in links) || ((links.tiktok is string) && (links.tiktok.size() <= 2000)));
    }

    function validInitialCompetitionMap(c) {
      return (c is map)
        && c.keys().hasOnly(['name', 'entryFee', 'maxParticipants', 'currency'])
        && (c.name is string) && (c.name.size() >= 1) && (c.name.size() <= 60)
        && ((c.entryFee is int) || (c.entryFee is float)) && (c.entryFee >= 0)
        && (c.maxParticipants is int) && (c.maxParticipants >= 2) && (c.maxParticipants <= 100000)
        && (c.currency is string) && (c.currency.size() >= 3) && (c.currency.size() <= 32);
    }

    function validVerificationStatus(s) {
      return (s is string) && (s in ['none', 'pending', 'approved', 'rejected', 'info_requested']);
    }

    function validVerificationRequestType(s) {
      return (s is string) && (s in ['initial', 'renewal']);
    }

    function validPlanDurationId(s) {
      // '1mo' added for the Monthly billing period. '3mo','6mo','yearly'
      // and '' (unset) are the existing values — none removed or renamed,
      // so every existing payment_attempts / subscription record with one
      // of those values continues to validate exactly as before.
      return (s is string) && (s in ['1mo', '3mo', '6mo', 'yearly', '']);
    }

    function validPlanId(s) {
      return (s is string) && (s in ['basic', 'pro', 'elite', '']);
    }

    function validWorldCupFormat(s) {
      return (s is string) && (s in ['fifa2022', 'fifa2026']);
    }

    function validLeagueFormatIndex(n) {
      return (n is int) && (n >= 0) && (n <= 3);
    }

    function validWorldCupTeamCount(data) {
      return !(('format' in data) && (data.format == 3))
        || (
          ('settings' in data)
          && (data.settings is map)
          && ('worldCupFormat' in data.settings)
          && (
            (data.settings.worldCupFormat == 'fifa2022' && ('maxTeams' in data) && data.maxTeams == 32)
            || (data.settings.worldCupFormat == 'fifa2026' && ('maxTeams' in data) && data.maxTeams == 48)
          )
        );
    }

    function validLeagueSettingsMap(settings) {
      return (settings is map)
        && (!('doubleRoundRobin' in settings) || (settings.doubleRoundRobin is bool))
        && (!('groupSize' in settings) || ((settings.groupSize is int) && (settings.groupSize >= 2) && (settings.groupSize <= 32)))
        && (!('swissRounds' in settings) || ((settings.swissRounds is int) && (settings.swissRounds >= 1) && (settings.swissRounds <= 20)))
        && (!('lastPulledAtMs' in settings) || (settings.lastPulledAtMs is int))
        && (!('worldCupFormat' in settings) || validWorldCupFormat(settings.worldCupFormat));
    }

    function validFootballCategory(s) {
      return (s is string) && (s in [
        'Local Football',
        'eFootball',
        'EA SPORTS FC',
        'EA SPORTS FC Mobile',
        'Dream League Soccer',
        'Total Football'
      ]);
    }

    function validMasterLeagueOptionalFields(data) {
      return (!('bannerUrl' in data) || ((data.bannerUrl is string) && (data.bannerUrl.size() <= 2000)))
        && (!('logoUrl' in data) || ((data.logoUrl is string) && (data.logoUrl.size() <= 2000)))
        && (!('bio' in data) || ((data.bio is string) && (data.bio.size() <= 2000)))
        && (!('badge' in data) || ((data.badge is string) && (data.badge.size() <= 80)))
        && (!('socialLinks' in data) || validMasterLeagueSocialLinksMap(data.socialLinks))
        && (!('staffShareIds' in data) || (data.staffShareIds is map))
        && (!('totalTournamentsCreated' in data) || ((data.totalTournamentsCreated is int) && (data.totalTournamentsCreated >= 0)))
        && (!('totalParticipantsTeams' in data) || ((data.totalParticipantsTeams is int) && (data.totalParticipantsTeams >= 0)))
        && (!('totalMatches' in data) || ((data.totalMatches is int) && (data.totalMatches >= 0)))
        && (!('followersCount' in data) || ((data.followersCount is int) && (data.followersCount >= 0)))
        && (!('createdViaAttemptId' in data) || ((data.createdViaAttemptId is string) && (data.createdViaAttemptId.size() <= 200)))
        && (!('sourcePaymentId' in data) || ((data.sourcePaymentId is string) && (data.sourcePaymentId.size() <= 200)))
        && (!('sourceReceiptId' in data) || ((data.sourceReceiptId is string) && (data.sourceReceiptId.size() <= 200)))
        && (!('initialCompetition' in data) || validInitialCompetitionMap(data.initialCompetition))
        && (!('verificationStatus' in data) || validVerificationStatus(data.verificationStatus))
        && (!('verifiedBadge' in data) || (data.verifiedBadge is bool))
        && (!('verificationRequestId' in data) || ((data.verificationRequestId is string) && (data.verificationRequestId.size() <= 200)))
        && (!('verificationReceiptId' in data) || ((data.verificationReceiptId is string) && (data.verificationReceiptId.size() <= 200)))
        && (!('verificationPaymentId' in data) || ((data.verificationPaymentId is string) && (data.verificationPaymentId.size() <= 200)))
        && (!('verificationProvider' in data) || ((data.verificationProvider is string) && (data.verificationProvider.size() <= 40)))
        && (!('verificationRequestedAtMs' in data) || (data.verificationRequestedAtMs is int))
        && (!('verificationApprovedAtMs' in data) || (data.verificationApprovedAtMs is int))
        && (!('verificationExpiresAtMs' in data) || (data.verificationExpiresAtMs is int))
        && (!('verificationReviewedBy' in data) || ((data.verificationReviewedBy is string) && (data.verificationReviewedBy.size() <= 200)))
        && (!('verificationNote' in data) || ((data.verificationNote is string) && (data.verificationNote.size() <= 1000)))
        && (!('country' in data) || ((data.country is string) && (data.country.matches('^[A-Z]{2}$'))))
        && (!('usernameLower' in data) || ((data.usernameLower is string) && (data.usernameLower.size() <= 20)))
        && (!('verificationRequestType' in data) || validVerificationRequestType(data.verificationRequestType));
    }

    function allowedMasterLeagueIdForPlan(masterLeagueId, planId) {
      return signedIn()
        && (planId is string)
        && (
          (planId == 'elite')
          || (planId == 'basic' && masterLeagueId == ('ml_' + request.auth.uid + '_1'))
          || (planId == 'pro' && (
            masterLeagueId == ('ml_' + request.auth.uid + '_1')
            || masterLeagueId == ('ml_' + request.auth.uid + '_2')
            || masterLeagueId == ('ml_' + request.auth.uid + '_3')
            || masterLeagueId == ('ml_' + request.auth.uid + '_4')
            || masterLeagueId == ('ml_' + request.auth.uid + '_5')
          ))
        );
    }

    function profileHasActivePlan(planId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && (planId is string)
        && (planId in ['pro', 'elite'])
        && (
          (
            exists(path)
            && (get(path).data.get('activePlanId', '') == planId)
            && isNumericMs(get(path).data.get('planExpiresAtMs', 0))
            && (toMs(get(path).data.get('planExpiresAtMs', 0)) > request.time.toMillis())
          )
          || (
            ('organizerPro' in request.auth.token)
            && (request.auth.token.organizerPro == true)
            && ('organizerProPlan' in request.auth.token)
            && (request.auth.token.organizerProPlan == planId)
          )
        );
    }

    function freeBasicMasterLeagueCreate(masterLeagueId) {
      return signedIn()
        && ('plan' in request.resource.data)
        && (request.resource.data.plan is string)
        && (request.resource.data.plan == 'basic')
        && allowedMasterLeagueIdForPlan(masterLeagueId, 'basic');
    }

    function isMasterLeagueOwner(masterLeagueId) {
      let path = /databases/$(database)/documents/master_leagues/$(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && exists(path)
        && (
          get(path).data.get('ownerId', '') == request.auth.uid
          || get(path).data.get('ownerUid', '') == request.auth.uid
        );
    }

    function isMasterLeagueMember(masterLeagueId) {
      let path = /databases/$(database)/documents/master_leagues/$(masterLeagueId);
      return signedIn()
        && validMasterLeagueId(masterLeagueId)
        && exists(path)
        && (
          get(path).data.get('ownerId', '') == request.auth.uid
          || get(path).data.get('ownerUid', '') == request.auth.uid
          || (request.auth.uid in get(path).data.get('memberIds', []))
        );
    }

    function isOwner(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId);
      return signedIn()
        && leagueId != ''
        && exists(path)
        && (
          get(path).data.get('organizerUid', '') == request.auth.uid
          || get(path).data.get('ownerUid', '') == request.auth.uid
          || get(path).data.get('organizerUserId', '') == request.auth.uid
          || get(path).data.get('ownerId', '') == request.auth.uid
        );
    }

    function isOwnerDirect() {
      return signedIn()
        && resource != null
        && (
          (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
          || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
          || (('organizerUserId' in resource.data) && looksLikeFirebaseUid(resource.data.organizerUserId) && (resource.data.organizerUserId == request.auth.uid))
          || (('ownerId' in resource.data) && looksLikeFirebaseUid(resource.data.ownerId) && (resource.data.ownerId == request.auth.uid))
        );
    }

    function isOrganizerByMembership(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid);
      return signedIn() && leagueId != '' && exists(path) && get(path).data.get('role', -1) == 0;
    }

    function isLeagueMemberNoGet(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid);
      return signedIn() && leagueId != '' && exists(path);
    }

    function isOrganizerRole(role) { return (role is int) && role == 0; }
    function isMemberRole(role)    { return (role is int) && role == 1; }

    function canManageLeague(leagueId) {
      return isSuperAdmin() || isOwner(leagueId) || isOrganizerByMembership(leagueId);
    }

    function canReadLeagueDirect() {
      return isSuperAdmin()
        || (
          resource != null
          && (
            (
              ('masterLeagueId' in resource.data)
              && (resource.data.masterLeagueId is string)
              && (resource.data.masterLeagueId.size() > 0)
            )
            || ((resource.data.isPrivate is bool) && (resource.data.isPrivate == false))
            || ((resource.data.isPrivate is int) && (resource.data.isPrivate == 0))
            || ((resource.data.privacy is string) && (resource.data.privacy == 'public' || resource.data.privacy == 'PUBLIC' || resource.data.privacy == 'LeaguePrivacy.public'))
            || (!('isPrivate' in resource.data) && !('privacy' in resource.data))
            || (
              signedIn()
              && (
                (('organizerUid' in resource.data) && (resource.data.organizerUid == request.auth.uid))
                || (('ownerUid' in resource.data) && (resource.data.ownerUid == request.auth.uid))
                || (('organizerUserId' in resource.data) && (resource.data.organizerUserId == request.auth.uid))
                || (('ownerId' in resource.data) && (resource.data.ownerId == request.auth.uid))
                || ((resource.data.memberIds is list) && (request.auth.uid in resource.data.memberIds))
              )
            )
          )
        );
    }

    function canReadLeague(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId);
      return isSuperAdmin()
        || (
          leagueId != ''
          && exists(path)
          && (
            (get(path).data.get('masterLeagueId', '') != '')
            || (get(path).data.get('isPrivate', false) == false)
            || (get(path).data.get('isPrivate', 1) == 0)
            || (get(path).data.get('privacy', '') in ['public', 'PUBLIC', 'LeaguePrivacy.public'])
            || (!('isPrivate' in get(path).data) && !('privacy' in get(path).data))
            || (
              signedIn()
              && (
                (get(path).data.get('organizerUid', '') == request.auth.uid)
                || (get(path).data.get('ownerUid', '') == request.auth.uid)
                || (get(path).data.get('organizerUserId', '') == request.auth.uid)
                || (get(path).data.get('ownerId', '') == request.auth.uid)
                || (request.auth.uid in get(path).data.get('memberIds', []))
              )
            )
          )
        );
    }

    function matchIsFinished(matchDocData) {
      return matchDocData.get('isPlayed', false) == true
          || matchDocData.get('status', '') == 'FINISHED'
          || matchDocData.get('matchStatus', '') == 'FINISHED';
    }

    function isParticipantTeam(matchDocData, teamId) {
      return matchDocData.get('homeTeamId', '') == teamId || matchDocData.get('awayTeamId', '') == teamId;
    }

    function isWorldCupLeague(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId);
      return leagueId != '' && exists(path) && get(path).data.get('format', -1) == 3;
    }

    function validWorldCupGroupMatchWrite() {
      return (!('groupId' in request.resource.data)
        || (
          (request.resource.data.groupId is string)
          && (request.resource.data.groupId.size() >= 1)
          && (request.resource.data.groupId.size() <= 10)
        )
      );
    }

    function validWorldCupTeamAggregateFields() {
      let d = request.resource.data;
      return (!('basePoints' in d) || ((d.basePoints is int) && (d.basePoints >= 0)))
        && (!('goalDifference' in d) || (d.goalDifference is int))
        && (!('goalsFor' in d) || ((d.goalsFor is int) && (d.goalsFor >= 0)))
        && (!('goalsAgainst' in d) || ((d.goalsAgainst is int) && (d.goalsAgainst >= 0)))
        && (!('wins' in d) || ((d.wins is int) && (d.wins >= 0)))
        && (!('draws' in d) || ((d.draws is int) && (d.draws >= 0)))
        && (!('losses' in d) || ((d.losses is int) && (d.losses >= 0)))
        && (!('matchesPlayed' in d) || ((d.matchesPlayed is int) && (d.matchesPlayed >= 0)))
        && (!('adminAdjustment' in d) || (d.adminAdjustment is int))
        && (!('groupId' in d) || ((d.groupId is string) && (d.groupId.size() <= 10)));
    }

    function validWorldCupKnockoutFields() {
      let d = request.resource.data;
      return (!('nextMatchId' in d) || (d.nextMatchId is string) || (d.nextMatchId == null))
        && (!('loserGoesToMatchId' in d) || (d.loserGoesToMatchId is string) || (d.loserGoesToMatchId == null))
        && (!('tiebreakWinnerTeamId' in d) || (d.tiebreakWinnerTeamId is string) || (d.tiebreakWinnerTeamId == null))
        && (!('winnerId' in d) || (d.winnerId is string) || (d.winnerId == null))
        && (!('loserId' in d) || (d.loserId is string) || (d.loserId == null))
        && (!('roundName' in d)
          || (
            (d.roundName is string)
            && (d.roundName in [
              'Play-off','Round of 32','Round of 16','Quarter Finals','Semi Finals','Final','3rd Place'
            ])
          ))
        && (!('qualificationSlot' in d) || (d.qualificationSlot is string) || (d.qualificationSlot == null));
    }

    function highlightHasOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly(['matchId','leagueId','teamId','uploadedBy','cloudinaryPublicId','secureUrl','thumbnailUrl','duration','size','format','status','createdAt','updatedAt']);
    }

    function highlightFieldsAreValid(matchId, highlightId) {
      let d = request.resource.data;
      let maxBytes = 15 * 1024 * 1024;
      let maxSeconds = 180;
      return highlightHasOnlyAllowedKeys()
        && (d.matchId is string) && (d.matchId == matchId)
        && (d.leagueId is string) && (d.leagueId.size() > 0) && (d.leagueId.size() <= 200)
        && (d.teamId is string) && (d.teamId.size() > 0) && (d.teamId.size() <= 200)
        && (d.uploadedBy is string) && (d.uploadedBy == request.auth.uid)
        && (d.cloudinaryPublicId is string) && (d.cloudinaryPublicId == ('match_highlights/' + d.leagueId + '/' + matchId + '/' + d.teamId + '/' + highlightId)) && (d.cloudinaryPublicId.size() <= 600)
        && (d.secureUrl is string) && (d.secureUrl.size() <= 2000)
        && (d.thumbnailUrl is string) && (d.thumbnailUrl.size() <= 2000)
        && (d.duration is int || d.duration is float) && (d.duration >= 0) && (d.duration <= maxSeconds)
        && (d.size is int) && (d.size >= 0) && (d.size <= maxBytes)
        && (d.format is string) && (d.format.size() <= 10)
        && (d.status is string) && (d.status in ['UPLOADING', 'PROCESSING', 'APPROVED'])
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp))
        && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderIsLeagueParticipant(matchId, highlightId) {
      let d = request.resource.data;
      let memPath = /databases/$(database)/documents/leagues/$(d.leagueId)/memberships/$(request.auth.uid);
      let matchPath = /databases/$(database)/documents/leagues/$(d.leagueId)/matches/$(matchId);
      return signedIn() 
        && exists(memPath) && get(memPath).data.get('teamId', '') == d.teamId
        && exists(matchPath) && matchIsFinished(get(matchPath).data) && isParticipantTeam(get(matchPath).data, d.teamId);
    }

    function highlightCreateIsValid(matchId, highlightId) {
      let d = request.resource.data;
      return highlightFieldsAreValid(matchId, highlightId) && highlightUploaderIsLeagueParticipant(matchId, highlightId)
        && (d.status == 'UPLOADING') && (d.secureUrl == '') && (d.thumbnailUrl == '') && (d.duration == 0 || d.duration == 0.0) && (d.size == 0) && (d.format == '')
        && (!('createdAt' in d) || d.createdAt == null || (d.createdAt is timestamp)) && (!('updatedAt' in d) || d.updatedAt == null || (d.updatedAt is timestamp));
    }

    function highlightUploaderUpdateIsValid(matchId, highlightId) {
      let d = request.resource.data;
      let identityUnchanged = (d.matchId == resource.data.matchId) && (d.leagueId == resource.data.leagueId) && (d.teamId == resource.data.teamId) && (d.uploadedBy == resource.data.uploadedBy) && (d.cloudinaryPublicId == resource.data.cloudinaryPublicId);
      let isUploader = signedIn() && ('uploadedBy' in resource.data) && (resource.data.uploadedBy is string) && (resource.data.uploadedBy == request.auth.uid);
      let memPath = /databases/$(database)/documents/leagues/$(resource.data.leagueId)/memberships/$(request.auth.uid);
      let matchPath = /databases/$(database)/documents/leagues/$(resource.data.leagueId)/matches/$(matchId);
      let stillAllowed = exists(memPath) && get(memPath).data.get('teamId', '') == resource.data.teamId
                         && exists(matchPath) && matchIsFinished(get(matchPath).data) && isParticipantTeam(get(matchPath).data, resource.data.teamId);
      let uploadingStateOk = (d.status == 'UPLOADING') && (d.secureUrl == '') && (d.thumbnailUrl == '') && (d.size == 0) && (d.duration == 0 || d.duration == 0.0) && (d.format == '' || d.format == 'mp4');
      let processingStateOk = (d.status == 'PROCESSING') && (d.secureUrl.size() > 10) && (d.thumbnailUrl.size() > 10) && (d.size > 0) && (d.duration > 0) && (d.format == 'mp4');
      return highlightFieldsAreValid(matchId, highlightId) && identityUnchanged && isUploader && stillAllowed && (uploadingStateOk || processingStateOk);
    }

    function highlightModeratorUpdateIsValid(matchId, highlightId) {
      return signedIn() && canManageLeague(resource.data.leagueId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status is string) && (request.resource.data.status in ['PROCESSING', 'APPROVED'])
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == null || (request.resource.data.updatedAt is timestamp));
    }

    function validRewardType(t) { return (t is string) && (t == 'cash' || t == 'physical' || t == 'digital' || t == 'trophy' || t == 'other'); }
    function validRewardFields() {
      let d = request.resource.data;
      return (d.position is int) && (d.position >= 1) && (d.position <= 1000)
        && (d.rewardName is string) && (d.rewardName.size() >= 1) && (d.rewardName.size() <= 120)
        && (d.rewardType is string) && validRewardType(d.rewardType)
        && (!('description' in d) || (d.description is string && d.description.size() <= 6000))
        && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2000));
    }

    function validChatType(t) { return (t is string) && (t == 'text' || t == 'image' || t == 'code' || t == 'voice'); }
    function isReasonableMs(ms) { return (ms is int) && (ms >= (request.time.toMillis() - 30 * 60 * 1000)) && (ms <= (request.time.toMillis() + 30 * 60 * 1000)); }

    function validChatMessageCreate(messageId) {
      return signedIn()
        // FIX: 'voiceDurationMs' added here — the app's sendLeagueMessage()
        // has included this field on EVERY message (not just voice ones,
        // always as an int >= 0) for a while now, but it was never added
        // to this allowlist. Since this is a strict keys().hasOnly(...)
        // gate, every single league chat message create — text, image, or
        // voice — was being rejected outright with permission-denied.
        // (Private chat messages were unaffected because that rule has no
        // such keys() allowlist at all.)
        && (request.resource.data.keys().hasOnly(['messageId','senderId','senderName','senderPhoto','text','imageUrl','voiceUrl','voiceDurationMs','type','leagueId','timestamp','createdAt','createdAtMs','pinned','pinnedAt','pinnedBy','deleted','deletedAt','deletedBy','replyToMessageId','replyToSenderName','replyToText','replyToType']))
        && (request.resource.data.messageId is string) && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string) && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string) && (request.resource.data.senderName.size() >= 1) && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string) && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string) && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string) && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.voiceUrl is string) && (request.resource.data.voiceUrl.size() <= 2000)
        && (!('voiceDurationMs' in request.resource.data) || ((request.resource.data.voiceDurationMs is int) && (request.resource.data.voiceDurationMs >= 0)))
        && (!('leagueId' in request.resource.data) || ((request.resource.data.leagueId is string) && (request.resource.data.leagueId.size() <= 200)))
        && isReasonableMs(request.resource.data.timestamp)
        && (request.resource.data.createdAt == request.time)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (!('pinned' in request.resource.data) || ((request.resource.data.pinned is bool) && (request.resource.data.pinned == false)))
        && (!('pinnedAt' in request.resource.data) || (request.resource.data.pinnedAt == null))
        && (!('pinnedBy' in request.resource.data) || ((request.resource.data.pinnedBy is string) && (request.resource.data.pinnedBy == '')))
        && (!('deleted' in request.resource.data) || ((request.resource.data.deleted is bool) && (request.resource.data.deleted == false)))
        && (!('deletedAt' in request.resource.data) || (request.resource.data.deletedAt == null))
        && (!('deletedBy' in request.resource.data) || ((request.resource.data.deletedBy is string) && (request.resource.data.deletedBy == '')))
        && (!('replyToMessageId' in request.resource.data) || (request.resource.data.replyToMessageId is string))
        && (!('replyToSenderName' in request.resource.data) || ((request.resource.data.replyToSenderName is string) && (request.resource.data.replyToSenderName.size() <= 80)))
        && (!('replyToText' in request.resource.data) || ((request.resource.data.replyToText is string) && (request.resource.data.replyToText.size() <= 4000)))
        && (!('replyToType' in request.resource.data) || ((request.resource.data.replyToType is string) && (request.resource.data.replyToType == '' || validChatType(request.resource.data.replyToType))))
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'code' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'image' && request.resource.data.imageUrl.size() > 10 && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'voice' && request.resource.data.voiceUrl.size() > 10 && request.resource.data.imageUrl == '')
        );
    }

    function validOrganizerChatMessageCreate(messageId, masterLeagueId) {
      return signedIn()
        // FIX: same missing-'voiceDurationMs' bug as validChatMessageCreate
        // above, on the organizer (master league) chatroom — sendOrganizerMessage()
        // always includes it, this allowlist never had it, every organizer
        // chat message create was rejected with permission-denied.
        && request.resource.data.keys().hasOnly([
          'messageId','senderId','senderName','senderPhoto','text','imageUrl','voiceUrl','voiceDurationMs','type',
          'masterLeagueId','timestamp','createdAt','createdAtMs',
          'pinned','pinnedAt','pinnedBy','deleted','deletedAt','deletedBy',
          'replyToMessageId','replyToSenderName','replyToText','replyToType'
        ])
        && (request.resource.data.messageId is string)
        && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string)
        && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string)
        && (request.resource.data.senderName.size() >= 1)
        && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string)
        && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string)
        && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.voiceUrl is string)
        && (request.resource.data.voiceUrl.size() <= 2000)
        && (!('voiceDurationMs' in request.resource.data) || ((request.resource.data.voiceDurationMs is int) && (request.resource.data.voiceDurationMs >= 0)))
        && (request.resource.data.masterLeagueId is string)
        && (request.resource.data.masterLeagueId == masterLeagueId)
        && isReasonableMs(request.resource.data.timestamp)
        && (request.resource.data.createdAt == request.time)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinned == false)
        && (request.resource.data.pinnedAt == null)
        && (request.resource.data.pinnedBy is string)
        && (request.resource.data.pinnedBy == '')
        && (request.resource.data.deleted is bool)
        && (request.resource.data.deleted == false)
        && (request.resource.data.deletedAt == null)
        && (request.resource.data.deletedBy is string)
        && (request.resource.data.deletedBy == '')
        && (!('replyToMessageId' in request.resource.data) || (request.resource.data.replyToMessageId is string))
        && (!('replyToSenderName' in request.resource.data) || ((request.resource.data.replyToSenderName is string) && (request.resource.data.replyToSenderName.size() <= 80)))
        && (!('replyToText' in request.resource.data) || ((request.resource.data.replyToText is string) && (request.resource.data.replyToText.size() <= 4000)))
        && (!('replyToType' in request.resource.data) || ((request.resource.data.replyToType is string) && (request.resource.data.replyToType == '' || validChatType(request.resource.data.replyToType))))
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'code' && request.resource.data.text.size() > 0 && request.resource.data.imageUrl == '' && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'image' && request.resource.data.imageUrl.size() > 10 && request.resource.data.voiceUrl == '')
          || (request.resource.data.type == 'voice' && request.resource.data.voiceUrl.size() > 10 && request.resource.data.imageUrl == '')
        );
    }

    function isChatPinUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['pinned','pinnedAt','pinnedBy']);
    }

    function validChatPinUpdate() {
      return isChatPinUpdate()
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinnedBy is string)
        && (
          (request.resource.data.pinned == true && (request.resource.data.pinnedBy == request.auth.uid) && (request.resource.data.pinnedAt == request.time))
          || (request.resource.data.pinned == false && (request.resource.data.pinnedBy == '') && (request.resource.data.pinnedAt == null))
        );
    }

    function isChatSoftDeleteUpdate() {
      return signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted','deletedAt','deletedBy','pinned','pinnedAt','pinnedBy']);
    }

    function validChatSoftDeleteUpdate() {
      return isChatSoftDeleteUpdate()
        && (request.resource.data.deleted is bool)
        && (request.resource.data.deleted == true)
        && (request.resource.data.deletedBy is string)
        && (request.resource.data.deletedBy == request.auth.uid)
        && (request.resource.data.deletedAt == request.time)
        && (request.resource.data.pinned is bool)
        && (request.resource.data.pinned == false)
        && (request.resource.data.pinnedBy is string)
        && (request.resource.data.pinnedBy == '')
        && (request.resource.data.pinnedAt == null);
    }

    function isGlobalChatApproved() {
      let path = /databases/$(database)/documents/globalChatRequests/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.get('status', '') == 'approved';
    }

    function canAccessGlobalChat() {
      return signedIn() && (isSuperAdmin() || isGlobalChatApproved());
    }

    function isGlobalChatAdmin() {
      let adminPath = /databases/$(database)/documents/app/admins;
      return signedIn() && exists(adminPath) && (request.auth.uid in get(adminPath).data.get('globalChatAdmins', []));
    }

    function allowGlobalSenderPin() {
      let adminPath = /databases/$(database)/documents/app/admins;
      return exists(adminPath) && get(adminPath).data.get('allowGlobalSenderPin', false) == true;
    }

    function canPinGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (allowGlobalSenderPin() && ('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid));
    }

    function canDeleteGlobalMessage() {
      return isSuperAdmin()
        || isGlobalChatAdmin()
        || (('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid));
    }

    function canPinLeagueMessage(leagueId) { return canManageLeague(leagueId); }

    function canDeleteLeagueMessage(leagueId) {
      return canManageLeague(leagueId)
        || (('senderId' in resource.data) && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid));
    }

    function validQuickMsgInline(s) {
      return (s is string)
        && (s.size() > 0)
        && (s.size() <= 15)
        && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*');
    }

    function validQuickMessagesInline(list) {
      return (list is list)
        && (list.size() <= 15)
        && (list.size() < 1 || validQuickMsgInline(list[0]))
        && (list.size() < 2 || validQuickMsgInline(list[1]))
        && (list.size() < 3 || validQuickMsgInline(list[2]))
        && (list.size() < 4 || validQuickMsgInline(list[3]))
        && (list.size() < 5 || validQuickMsgInline(list[4]))
        && (list.size() < 6 || validQuickMsgInline(list[5]))
        && (list.size() < 7 || validQuickMsgInline(list[6]))
        && (list.size() < 8 || validQuickMsgInline(list[7]))
        && (list.size() < 9 || validQuickMsgInline(list[8]))
        && (list.size() < 10 || validQuickMsgInline(list[9]))
        && (list.size() < 11 || validQuickMsgInline(list[10]))
        && (list.size() < 12 || validQuickMsgInline(list[11]))
        && (list.size() < 13 || validQuickMsgInline(list[12]))
        && (list.size() < 14 || validQuickMsgInline(list[13]))
        && (list.size() < 15 || validQuickMsgInline(list[14]));
    }

    function isCallParticipant(callId) {
      let path = /databases/$(database)/documents/call_rooms/$(callId);
      return signedIn()
        && callId != ''
        && exists(path)
        && (
          get(path).data.get('hostUserId', '') == request.auth.uid
          || get(path).data.get('createdBy', '') == request.auth.uid
          || (request.auth.uid in get(path).data.get('participantIds', []))
        );
    }

    function validUsernameFormat(id) {
      return (id is string) && id.matches('^[a-z0-9_]{3,20}$');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Super-admin global bypass
    // ─────────────────────────────────────────────────────────────────────────
    // The single hardcoded super-admin uid (isSuperAdmin()) can read and
    // write ANY document in the database, full stop — this is a deliberate,
    // explicit "break glass" rule. Cloud Firestore unions every `match`
    // block that applies to a given path: this recursive-wildcard block
    // does not replace or narrow any rule below, it just adds an extra
    // always-available "or allow if isSuperAdmin()" alongside them, so every
    // existing rule for every other user is completely unchanged.
    //
    // Every other admin/delegated-admin check in this file (isPricingAdmin(),
    // isBadgeAdminWrite(), etc.) stays scoped to its specific action — only
    // this one uid gets unconditional access to everything.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && validUsernameFormat(username)
        && request.resource.data.keys().hasOnly(['userId', 'createdAtMs'])
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.createdAtMs is int);

      allow update: if false;

      allow delete: if signedIn()
        && (resource.data.userId is string)
        && (resource.data.userId == request.auth.uid);
    }

    match /organizer_usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && validUsernameFormat(username)
        && request.resource.data.keys().hasOnly(['masterLeagueId', 'ownerId', 'createdAtMs'])
        && (request.resource.data.masterLeagueId is string)
        && validMasterLeagueId(request.resource.data.masterLeagueId)
        && (request.resource.data.ownerId is string)
        && (request.resource.data.ownerId == request.auth.uid)
        && isMasterLeagueOwner(request.resource.data.masterLeagueId)
        && (request.resource.data.createdAtMs is int);

      allow update: if false;

      allow delete: if signedIn()
        && (resource.data.ownerId is string)
        && (resource.data.ownerId == request.auth.uid);
    }

    function validBadgeSource(s) {
      return (s is string) && (s in ['manual_purchase', 'pro_subscription', 'elite_subscription', 'admin_granted']);
    }

    function _sourceRequiresExpiry(source) {
      return (source is string) && (source in ['pro_subscription', 'elite_subscription']);
    }

    function _sourceRequiresNoExpiry(source) {
      return (source is string) && (source in ['manual_purchase', 'admin_granted']);
    }

    function _validSourceExpiry(source, expiresAt) {
      return (
        _sourceRequiresExpiry(source)
        && (expiresAt is timestamp)
        && (expiresAt > request.time)
      )
      || (
        _sourceRequiresNoExpiry(source)
        && (expiresAt == null)
      );
    }

    function validVerificationMap(v) {
      return (v is map)
        && v.keys().hasOnly([
          'greenVerified','organizerVerified','staffVerified',
          'greenSource','organizerSource','staffSource',
          'greenExpiresAt','organizerExpiresAt','staffExpiresAt'
        ])
        && (!('greenVerified' in v) || (v.greenVerified is bool))
        && (!('organizerVerified' in v) || (v.organizerVerified is bool))
        && (!('staffVerified' in v) || (v.staffVerified is bool))
        && (!('greenSource' in v) || (v.greenSource == null) || validBadgeSource(v.greenSource))
        && (!('organizerSource' in v) || (v.organizerSource == null) || validBadgeSource(v.organizerSource))
        && (!('staffSource' in v) || (v.staffSource == null) || validBadgeSource(v.staffSource))
        && (!('greenExpiresAt' in v) || (v.greenExpiresAt == null) || (v.greenExpiresAt is timestamp))
        && (!('organizerExpiresAt' in v) || (v.organizerExpiresAt == null) || (v.organizerExpiresAt is timestamp))
        && (!('staffExpiresAt' in v) || (v.staffExpiresAt == null) || (v.staffExpiresAt is timestamp))
        && (
          !('greenVerified' in v) || (v.greenVerified == false)
          || (
            ('greenSource' in v) && (v.greenSource != null)
            && validBadgeSource(v.greenSource)
            && _validSourceExpiry(v.greenSource, ('greenExpiresAt' in v ? v.greenExpiresAt : null))
          )
        )
        && (
          !('organizerVerified' in v) || (v.organizerVerified == false)
          || (
            ('organizerSource' in v) && (v.organizerSource != null)
            && (v.organizerSource in ['manual_purchase', 'elite_subscription', 'admin_granted'])
            && _validSourceExpiry(v.organizerSource, ('organizerExpiresAt' in v ? v.organizerExpiresAt : null))
          )
        )
        && (
          !('staffVerified' in v) || (v.staffVerified == false)
          || (
            ('staffSource' in v) && (v.staffSource != null)
            && (v.staffSource == 'admin_granted')
            && _validSourceExpiry(v.staffSource, ('staffExpiresAt' in v ? v.staffExpiresAt : null))
          )
        );
    }

    function isBadgeSelfWrite(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['verification'])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && (request.resource.data.verification is map)
        && validVerificationMap(request.resource.data.verification);
    }

    function isBadgeAdminWrite(targetUserId) {
      return isPricingAdmin()
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == targetUserId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['verification'])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && (request.resource.data.verification is map)
        && validVerificationMap(request.resource.data.verification);
    }

    match /globalChatRequests/{requestId} {
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if signedIn()
        && request.auth.uid == requestId
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.status is string)
        && (request.resource.data.status == 'pending');
      allow update: if signedIn()
        && (
          (isSuperAdmin()
            && (request.resource.data.status is string)
            && (request.resource.data.status in ['pending','approved','rejected']))
          || (request.auth.uid == requestId
            && (request.resource.data.status is string)
            && (request.resource.data.status == 'pending'))
        );
      allow delete: if false;
    }

    match /globalChatroom/{messageId} {
      allow get, list: if canAccessGlobalChat();
      allow create: if canAccessGlobalChat() && validChatMessageCreate(messageId);
      allow update: if canAccessGlobalChat()
        && (
          (validChatPinUpdate() && canPinGlobalMessage())
          || (validChatSoftDeleteUpdate() && canDeleteGlobalMessage())
        );
      allow delete: if isSuperAdmin();
    }

    match /app/chatModeration/users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && (request.resource.data.allChatMuted is bool)
        && (request.resource.data.allChatBanned is bool)
        && (request.resource.data.updatedAtMs is int)
        && (request.resource.data.updatedBy is string)
        && (request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['userId','teamName','authProvider','createdAt','updatedAt'])
        && (!('shareId' in request.resource.data) || ((request.resource.data.shareId is string) && (request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$'))))
        && (!('activePlanId' in request.resource.data) || validPlanId(request.resource.data.activePlanId))
        && (!('activePlanDurationId' in request.resource.data) || validPlanDurationId(request.resource.data.activePlanDurationId))
        && (!('planPurchasedAtMs' in request.resource.data) || (request.resource.data.planPurchasedAtMs is int))
        && (!('planExpiresAtMs' in request.resource.data) || isNumericMs(request.resource.data.planExpiresAtMs))
        && (!('planReceiptId' in request.resource.data) || (request.resource.data.planReceiptId is string))
        && (!('planProvider' in request.resource.data) || (request.resource.data.planProvider is string));

      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['teamName','userId','updatedAt'])

          || (
            (resource.data.shareId == null || resource.data.shareId == '')
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['shareId','userId','updatedAt'])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )

          || (
            // analyticsCountry: write-once, same pattern as shareId above.
            // Deliberately separate from any currency-selection country
            // field elsewhere in the app — this one is written by
            // UserAnalyticsCountryBackfill and is NEVER set to a guessed
            // default; it is either a real two-letter code or absent.
            (resource.data.analyticsCountry == null || resource.data.analyticsCountry == '')
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['analyticsCountry','userId','updatedAt'])
            && (request.resource.data.analyticsCountry is string)
            && request.resource.data.analyticsCountry.matches('^[A-Z]{2}$')
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['username','usernameLower','userId','updatedAt'])
            && (request.resource.data.usernameLower is string)
            && validUsernameFormat(request.resource.data.usernameLower)
            && (request.resource.data.username is string)
            && (request.resource.data.username == request.resource.data.usernameLower)
            && exists(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
            && (get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.userId == request.auth.uid)
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['quickMessagesCustom','userId','updatedAt'])
            && validQuickMessagesInline(request.resource.data.quickMessagesCustom)
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['photoUrl','profileImageUrl','teamImageUrl','userId','updatedAt'])
            && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string))
            && (!('profileImageUrl' in request.resource.data) || (request.resource.data.profileImageUrl is string))
            && (!('teamImageUrl' in request.resource.data) || (request.resource.data.teamImageUrl is string))
            && (request.resource.data.updatedAt is int)
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['isPremium','premiumExpiresAtMs','userId','updatedAt'])
            && (request.resource.data.isPremium is bool)
            && (request.resource.data.isPremium == true)
            && isNumericMs(request.resource.data.premiumExpiresAtMs)
            && (toMs(request.resource.data.premiumExpiresAtMs) > request.time.toMillis())
            && (request.resource.data.updatedAt is int)
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'activePlanId',
              'activePlanDurationId',
              'planPurchasedAtMs',
              'planExpiresAtMs',
              'planReceiptId',
              'planProvider',
              'userId',
              'updatedAt'
            ])
            && validPlanId(request.resource.data.activePlanId)
            && validPlanDurationId(request.resource.data.activePlanDurationId)
            && (request.resource.data.planPurchasedAtMs is int)
            && isNumericMs(request.resource.data.planExpiresAtMs)
            && (request.resource.data.planReceiptId is string)
            && (request.resource.data.planProvider is string)
            && (
              (
                request.resource.data.activePlanId == 'basic'
                && (
                  request.resource.data.planProvider == 'free'
                  || request.resource.data.planProvider == 'system'
                  || request.resource.data.planProvider == ''
                )
              )
              || (
                request.resource.data.activePlanId in ['pro', 'elite']
                && toMs(request.resource.data.planExpiresAtMs) > request.time.toMillis()
                && (
                  request.resource.data.planProvider == 'flutterwave'
                  || request.resource.data.planProvider == 'google_play_billing'
                  || request.resource.data.planProvider == 'google_play'
                  || request.resource.data.planProvider == 'stripe'
                  || request.resource.data.planProvider == 'manual'
                )
              )
            )
            && (request.resource.data.updatedAt is int)
          )

          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'activePlanId',
              'activePlanDurationId',
              'planPurchasedAtMs',
              'planExpiresAtMs',
              'planReceiptId',
              'planProvider',
              'isPremium',
              'premiumExpiresAtMs',
              'userId',
              'updatedAt'
            ])
            && validPlanId(request.resource.data.activePlanId)
            && validPlanDurationId(request.resource.data.activePlanDurationId)
            && (request.resource.data.planPurchasedAtMs is int)
            && isNumericMs(request.resource.data.planExpiresAtMs)
            && (request.resource.data.planReceiptId is string)
            && (request.resource.data.planProvider is string)
            && (request.resource.data.isPremium is bool)
            && (request.resource.data.isPremium == true)
            && isNumericMs(request.resource.data.premiumExpiresAtMs)
            && (toMs(request.resource.data.premiumExpiresAtMs) > request.time.toMillis())
            && (
              (
                request.resource.data.activePlanId == 'basic'
                && (
                  request.resource.data.planProvider == 'free'
                  || request.resource.data.planProvider == 'system'
                  || request.resource.data.planProvider == ''
                )
              )
              || (
                request.resource.data.activePlanId in ['pro', 'elite']
                && toMs(request.resource.data.planExpiresAtMs) > request.time.toMillis()
                && (
                  request.resource.data.planProvider == 'flutterwave'
                  || request.resource.data.planProvider == 'google_play_billing'
                  || request.resource.data.planProvider == 'google_play'
                  || request.resource.data.planProvider == 'stripe'
                  || request.resource.data.planProvider == 'manual'
                )
              )
            )
            && (request.resource.data.updatedAt is int)
          )

          || isBadgeSelfWrite(userId)
        )
      ) || (
        isPricingAdmin()
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == userId)
        && (
          isBadgeAdminWrite(userId)
          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'isVerified',
              'verifiedAtMs',
              'verificationExpiresAtMs',
              'verificationStatus',
              'updatedAt'
            ])
            && (!('isVerified' in request.resource.data) || (request.resource.data.isVerified is bool))
            && (!('verifiedAtMs' in request.resource.data) || (request.resource.data.verifiedAtMs is int))
            && (!('verificationExpiresAtMs' in request.resource.data) || (request.resource.data.verificationExpiresAtMs is int))
            && (!('verificationStatus' in request.resource.data) || validVerificationStatus(request.resource.data.verificationStatus))
            && (request.resource.data.updatedAt is int)
          )
        )
      );

      allow delete: if false;

      match /leagueCharges/{leagueId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);
        allow update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);
        allow delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.token is string)
          && (request.resource.data.token == tokenId)
          && (!('platform' in request.resource.data) || (request.resource.data.platform is string))
          && (!('updatedAt' in request.resource.data) || (request.resource.data.updatedAt is timestamp))
          && (!('updatedAtMs' in request.resource.data) || (request.resource.data.updatedAtMs is int));
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /entitlements/{entitlementId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /team_profile/{docId} {
        allow get, list: if true;
        allow create, update: if signedIn() && request.auth.uid == userId
          && docId == 'profile'
          && (request.resource.data.game is string)
          && (request.resource.data.favoriteClub is string)
          && (request.resource.data.favoriteClub.size() <= 80)
          && (request.resource.data.favoritePlayer is string)
          && (request.resource.data.favoritePlayer.size() <= 80)
          && (request.resource.data.bio is string)
          && (request.resource.data.bio.size() <= 500)
          && (request.resource.data.bannerImageUrl is string)
          && (request.resource.data.bannerImageUrl.size() <= 2000)
          && (request.resource.data.themeColor is string)
          && (request.resource.data.themeColor.size() <= 16)
          && (request.resource.data.visibility is string)
          && (request.resource.data.visibility in ['public', 'followers_only', 'private'])
          && (request.resource.data.updatedAtMs is int);
        allow delete: if false;
      }

      match /squads/{gameId} {
        allow get, list: if true;
        allow create, update: if signedIn() && request.auth.uid == userId
          && (request.resource.data.formation is string)
          && (request.resource.data.formation.size() <= 20)
          && (request.resource.data.players is list)
          && (request.resource.data.players.size() <= 23)
          && (request.resource.data.managerName is string)
          && (request.resource.data.managerName.size() <= 60)
          && (request.resource.data.captainPlayerId is string)
          && (request.resource.data.viceCaptainPlayerId is string)
          && (request.resource.data.teamStrength is int)
          && (request.resource.data.teamStrength >= 0)
          && (request.resource.data.teamStrength <= 100)
          && (request.resource.data.updatedAtMs is int);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /recent_matches/{matchId} {
        allow get, list: if true;
        allow create, update: if signedIn()
          && (request.resource.data.leagueId is string) && (request.resource.data.leagueId.size() > 0)
          && canManageLeague(request.resource.data.leagueId)
          && (request.resource.data.leagueName is string) && (request.resource.data.leagueName.size() <= 120)
          && (request.resource.data.opponentName is string) && (request.resource.data.opponentName.size() <= 120)
          && (request.resource.data.result is string) && (request.resource.data.result in ['W', 'D', 'L'])
          && (request.resource.data.goalsFor is int) && (request.resource.data.goalsFor >= 0)
          && (request.resource.data.goalsAgainst is int) && (request.resource.data.goalsAgainst >= 0)
          && (request.resource.data.playedAtMs is int);
        allow delete: if false;
      }

      match /trophies/{trophyId} {
        allow get, list: if true;
        allow create: if signedIn()
          && (request.resource.data.leagueId is string) && (request.resource.data.leagueId.size() > 0)
          && canManageLeague(request.resource.data.leagueId)
          && (request.resource.data.leagueName is string) && (request.resource.data.leagueName.size() <= 120)
          && (request.resource.data.position is int) && (request.resource.data.position >= 1) && (request.resource.data.position <= 1000)
          && (request.resource.data.season is string) && (request.resource.data.season.size() <= 40)
          && (request.resource.data.createdAtMs is int);
        allow update, delete: if false;
      }

      match /stats/{docId} {
        allow get, list: if true;
        allow create, update: if signedIn()
          && docId == 'summary'
          && (
            request.resource.data.diff(resource == null ? {} : resource.data)
              .changedKeys().hasOnly(['followersCount', 'followingCount'])
            || (
              request.resource.data.diff(resource == null ? {} : resource.data)
                .changedKeys().hasOnly(['wins', 'draws', 'losses', 'goalsScored', 'goalsConceded', 'competitionsJoined', 'trophies'])
              && (!('wins' in request.resource.data) || (request.resource.data.wins is int && request.resource.data.wins >= 0))
              && (!('draws' in request.resource.data) || (request.resource.data.draws is int && request.resource.data.draws >= 0))
              && (!('losses' in request.resource.data) || (request.resource.data.losses is int && request.resource.data.losses >= 0))
              && (!('goalsScored' in request.resource.data) || (request.resource.data.goalsScored is int && request.resource.data.goalsScored >= 0))
              && (!('goalsConceded' in request.resource.data) || (request.resource.data.goalsConceded is int && request.resource.data.goalsConceded >= 0))
              && (!('competitionsJoined' in request.resource.data) || (request.resource.data.competitionsJoined is int && request.resource.data.competitionsJoined >= 0))
              && (!('trophies' in request.resource.data) || (request.resource.data.trophies is int && request.resource.data.trophies >= 0))
            )
          );
        allow delete: if false;
      }

      match /followers/{followerId} {
        allow get, list: if true;
        allow create: if signedIn() && request.auth.uid == followerId
          && (request.resource.data.userId == followerId);
        allow delete: if signedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{targetId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && (request.resource.data.userId == targetId);
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /blocked_users/{targetId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && (request.resource.data.userId == targetId);
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /blocked_by/{blockerId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == blockerId
          && (request.resource.data.userId is string) && (request.resource.data.userId == blockerId)
          && (request.resource.data.blockedAtMs is int);
        allow delete: if signedIn() && request.auth.uid == blockerId;
        allow update: if false;
      }

      match /statuses/{statusId} {
        allow get, list: if true;

        allow create: if signedIn()
          && request.auth.uid == userId
          && (profileHasActivePlan('pro') || profileHasActivePlan('elite'))
          && request.resource.data.keys().hasOnly(['statusId','userId','imageUrl','caption','createdAtMs','expiresAtMs'])
          && (request.resource.data.statusId is string) && (request.resource.data.statusId == statusId)
          && (request.resource.data.userId is string) && (request.resource.data.userId == userId)
          && (request.resource.data.imageUrl is string) && (request.resource.data.imageUrl.size() > 0) && (request.resource.data.imageUrl.size() <= 2000)
          && (request.resource.data.caption is string) && (request.resource.data.caption.size() <= 200)
          && isReasonableMs(request.resource.data.createdAtMs)
          && (request.resource.data.expiresAtMs is int)
          && (request.resource.data.expiresAtMs > request.resource.data.createdAtMs)
          && (request.resource.data.expiresAtMs <= (request.resource.data.createdAtMs + (26 * 60 * 60 * 1000)));

        allow update: if false;

        allow delete: if signedIn()
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid);
      }

      // Private, self-only app-state cursors — currently just the
      // organizer-feed read/clear cursors (lastSeenOrganizerFeedAtMs,
      // clearedOrganizerFeedAtMs), written by OrganizerFeedFirebase and
      // read by FollowedOrganizerNotificationsService. No rule existed
      // for this path before, which means every prior write here was
      // silently permission-denied — this is a pre-existing gap, not
      // something introduced by the organizer-feed read/clear feature.
      match /private/{docId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'lastSeenOrganizerFeedAtMs','clearedOrganizerFeedAtMs'
          ])
          && (!('lastSeenOrganizerFeedAtMs' in request.resource.data)
              || (request.resource.data.lastSeenOrganizerFeedAtMs is int))
          && (!('clearedOrganizerFeedAtMs' in request.resource.data)
              || (request.resource.data.clearedOrganizerFeedAtMs is int));

        allow delete: if false;
      }
    }

    match /user_search/{userId} {
      allow get, list: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && (request.resource.data.userId is string) && (request.resource.data.userId == userId)
        && (!('displayName' in request.resource.data) || ((request.resource.data.displayName is string) && (request.resource.data.displayName.size() <= 120)))
        && (!('displayNameLower' in request.resource.data) || ((request.resource.data.displayNameLower is string) && (request.resource.data.displayNameLower.size() <= 120)))
        && (!('shareId' in request.resource.data) || ((request.resource.data.shareId is string) && (request.resource.data.shareId.size() <= 20)))
        && (!('shareIdLower' in request.resource.data) || ((request.resource.data.shareIdLower is string) && (request.resource.data.shareIdLower.size() <= 20)))
        && (!('game' in request.resource.data) || ((request.resource.data.game is string) && (request.resource.data.game.size() <= 40)))
        && (!('badge' in request.resource.data) || ((request.resource.data.badge is string) && (request.resource.data.badge.size() <= 40)))
        && (!('avatarUrl' in request.resource.data) || ((request.resource.data.avatarUrl is string) && (request.resource.data.avatarUrl.size() <= 2000)))
        && (!('country' in request.resource.data) || ((request.resource.data.country is string) && (request.resource.data.country.matches('^[A-Z]{2}$'))))
        && (!('usernameLower' in request.resource.data) || ((request.resource.data.usernameLower is string) && (request.resource.data.usernameLower.size() <= 20)))
        && (request.resource.data.updatedAtMs is int);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow get, list: if isPricingAdmin() || isSuperAdmin();

      allow create: if signedIn()
        && (request.resource.data.reportId is string) && (request.resource.data.reportId == reportId)
        && (request.resource.data.reporterId is string) && (request.resource.data.reporterId == request.auth.uid)
        && (request.resource.data.targetUserId is string) && (request.resource.data.targetUserId.size() > 0)
        && (request.resource.data.targetUserId != request.auth.uid)
        && (request.resource.data.reason is string)
        && (request.resource.data.reason in ['spam', 'harassment', 'impersonation', 'cheating', 'other'])
        && (!('details' in request.resource.data) || ((request.resource.data.details is string) && (request.resource.data.details.size() <= 1000)))
        && (request.resource.data.status is string) && (request.resource.data.status == 'pending')
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.reviewedAtMs is int) && (request.resource.data.reviewedAtMs == 0)
        && (request.resource.data.reviewedBy is string) && (request.resource.data.reviewedBy == '');

      allow update: if (isPricingAdmin() || isSuperAdmin())
        && (resource.data.status == 'pending')
        && (request.resource.data.reporterId == resource.data.reporterId)
        && (request.resource.data.targetUserId == resource.data.targetUserId)
        && (request.resource.data.reason == resource.data.reason)
        && (request.resource.data.createdAtMs == resource.data.createdAtMs)
        && (request.resource.data.status is string)
        && (request.resource.data.status in ['reviewed', 'dismissed'])
        && (request.resource.data.reviewedAtMs is int) && (request.resource.data.reviewedAtMs > 0)
        && (request.resource.data.reviewedBy is string) && (request.resource.data.reviewedBy == request.auth.uid);

      allow delete: if false;
    }

    match /organizer_feed/{eventId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','masterLeagueId','type','title','message','createdAtMs','actorId','actorName','leagueId'])
        && (request.resource.data.id is string) && (request.resource.data.id == eventId)
        && (request.resource.data.masterLeagueId is string) && validMasterLeagueId(request.resource.data.masterLeagueId)
        && isMasterLeagueOwner(request.resource.data.masterLeagueId)
        && (request.resource.data.type is string) && (request.resource.data.type.size() > 0) && (request.resource.data.type.size() <= 80)
        && (request.resource.data.title is string) && (request.resource.data.title.size() > 0) && (request.resource.data.title.size() <= 160)
        && (request.resource.data.message is string) && (request.resource.data.message.size() <= 1000)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.actorId is string) && (request.resource.data.actorId == request.auth.uid)
        && (request.resource.data.actorName is string) && (request.resource.data.actorName.size() <= 120)
        && (request.resource.data.leagueId is string);
      allow update, delete: if false;
    }

    match /master_leagues/{masterLeagueId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name','ownerId','ownerUid','createdAt','purchaseStatus','memberIds',
          'roles','staffShareIds','updatedAtMs','plan','bannerUrl','logoUrl',
          'bio','socialLinks','badge','totalTournamentsCreated',
          'totalParticipantsTeams','totalMatches','followersCount',
          'createdViaAttemptId','sourcePaymentId','sourceReceiptId',
          'initialCompetition','verificationStatus','verifiedBadge',
          'verificationRequestId','verificationReceiptId','verificationPaymentId',
          'verificationProvider','verificationRequestedAtMs',
          'verificationApprovedAtMs','verificationExpiresAtMs',
          'verificationReviewedBy','verificationNote','verificationRequestType',
          'country','usernameLower'
        ])
        && (request.resource.data.name is string) && (request.resource.data.name.size() >= 1) && (request.resource.data.name.size() <= 60)
        && (request.resource.data.ownerId is string) && (request.resource.data.ownerId == request.auth.uid)
        && (!('ownerUid' in request.resource.data) || ((request.resource.data.ownerUid is string) && (request.resource.data.ownerUid == request.auth.uid)))
        && (request.resource.data.purchaseStatus is string) && (request.resource.data.purchaseStatus == 'active')
        && (request.resource.data.memberIds is list) && (request.auth.uid in request.resource.data.memberIds)
        && (request.resource.data.roles is map) && (request.resource.data.roles[request.auth.uid] is string) && (request.resource.data.roles[request.auth.uid] == 'owner')
        && (!('staffShareIds' in request.resource.data) || (request.resource.data.staffShareIds is map))
        && (request.resource.data.createdAt is timestamp)
        && (request.resource.data.updatedAtMs is int)
        && (request.resource.data.plan is string) && (request.resource.data.plan in ['basic', 'pro', 'elite'])
        && validMasterLeagueOptionalFields(request.resource.data)
        && (
          isSuperAdmin()
          || freeBasicMasterLeagueCreate(masterLeagueId)
          || (
               ('plan' in request.resource.data)
               && (request.resource.data.plan in ['pro', 'elite'])
               && allowedMasterLeagueIdForPlan(masterLeagueId, request.resource.data.plan)
             )
        );

      allow update: if (
          signedIn()
          && (
            isSuperAdmin()
            || (
                 ('organizerPro' in request.auth.token)
                 && (request.auth.token.organizerPro == true)
               )
            || (resource.data.plan in ['basic', 'pro', 'elite'])
          )
          && (resource.data.ownerId is string)
          && (resource.data.ownerId == request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'name','ownerId','ownerUid','createdAt','purchaseStatus','memberIds',
            'roles','staffShareIds','updatedAtMs','plan','bannerUrl','logoUrl',
            'bio','socialLinks','badge','totalTournamentsCreated',
            'totalParticipantsTeams','totalMatches','followersCount',
            'createdViaAttemptId','sourcePaymentId','sourceReceiptId',
            'initialCompetition','verificationStatus','verifiedBadge',
            'verificationRequestId','verificationReceiptId','verificationPaymentId',
            'verificationProvider','verificationRequestedAtMs',
            'verificationApprovedAtMs','verificationExpiresAtMs',
            'verificationReviewedBy','verificationNote','verificationRequestType',
            'country','usernameLower'
          ])
          && (request.resource.data.ownerId == resource.data.ownerId)
          && (request.resource.data.createdAt == resource.data.createdAt)
          && (request.resource.data.purchaseStatus == resource.data.purchaseStatus)
          && (request.resource.data.plan == resource.data.plan)
          && (!('createdViaAttemptId' in resource.data) || (request.resource.data.createdViaAttemptId == resource.data.createdViaAttemptId))
          && (!('sourcePaymentId' in resource.data) || (request.resource.data.sourcePaymentId == resource.data.sourcePaymentId))
          && (!('sourceReceiptId' in resource.data) || (request.resource.data.sourceReceiptId == resource.data.sourceReceiptId))
          && (!('initialCompetition' in resource.data) || (request.resource.data.initialCompetition == resource.data.initialCompetition))
          && (request.resource.data.name is string) && (request.resource.data.name.size() >= 1) && (request.resource.data.name.size() <= 60)
          && (request.resource.data.memberIds is list) && (request.auth.uid in request.resource.data.memberIds)
          && (request.resource.data.roles is map) && (request.resource.data.roles[request.auth.uid] is string) && (request.resource.data.roles[request.auth.uid] == 'owner')
          && (!('staffShareIds' in request.resource.data) || (request.resource.data.staffShareIds is map))
          && (!('followersCount' in resource.data) || (request.resource.data.followersCount == resource.data.followersCount))
          && (request.resource.data.updatedAtMs is int)
          && validMasterLeagueOptionalFields(request.resource.data)
        ) || (
          isPricingAdmin()
          && request.resource.data.keys().hasOnly([
            'name','ownerId','ownerUid','createdAt','purchaseStatus','memberIds',
            'roles','staffShareIds','updatedAtMs','plan','bannerUrl','logoUrl',
            'bio','socialLinks','badge','totalTournamentsCreated',
            'totalParticipantsTeams','totalMatches','followersCount',
            'createdViaAttemptId','sourcePaymentId','sourceReceiptId',
            'initialCompetition','verificationStatus','verifiedBadge',
            'verificationRequestId','verificationReceiptId','verificationPaymentId',
            'verificationProvider','verificationRequestedAtMs',
            'verificationApprovedAtMs','verificationExpiresAtMs',
            'verificationReviewedBy','verificationNote','verificationRequestType',
            'country','usernameLower'
          ])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'verificationStatus','verifiedBadge','verificationApprovedAtMs',
            'verificationExpiresAtMs','verificationReviewedBy','verificationNote',
            'verificationRequestType','updatedAtMs','logoUrl'
          ])
          && request.resource.data.diff(resource.data).removedKeys().size() == 0
          && (
            !request.resource.data.diff(resource.data).changedKeys().hasAny(['logoUrl'])
            || resource.data.get('logoUrl', '') == ''
          )
          && validMasterLeagueOptionalFields(request.resource.data)
          && validVerificationStatus(request.resource.data.verificationStatus)
          && validVerificationRequestType(request.resource.data.verificationRequestType)
          && (request.resource.data.updatedAtMs is int)
        ) || (
          signedIn()
          && request.resource.data.keys().hasOnly([
            'name','ownerId','ownerUid','createdAt','purchaseStatus','memberIds',
            'roles','staffShareIds','updatedAtMs','plan','bannerUrl','logoUrl',
            'bio','socialLinks','badge','totalTournamentsCreated',
            'totalParticipantsTeams','totalMatches','followersCount',
            'createdViaAttemptId','sourcePaymentId','sourceReceiptId',
            'initialCompetition','verificationStatus','verifiedBadge',
            'verificationRequestId','verificationReceiptId','verificationPaymentId',
            'verificationProvider','verificationRequestedAtMs',
            'verificationApprovedAtMs','verificationExpiresAtMs',
            'verificationReviewedBy','verificationNote','verificationRequestType',
            'country','usernameLower'
          ])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followersCount','updatedAtMs'])
          && request.resource.data.diff(resource.data).removedKeys().size() == 0
          && (request.resource.data.followersCount is int)
          && (request.resource.data.followersCount >= 0)
          && (request.resource.data.updatedAtMs is int)
          && (
            request.resource.data.followersCount == resource.data.get('followersCount', 0) + 1
            || (
              resource.data.get('followersCount', 0) > 0
              && request.resource.data.followersCount == resource.data.get('followersCount', 0) - 1
            )
          )
        );

      allow delete: if signedIn()
        && (
          isSuperAdmin()
          || (
            (resource.data.ownerId is string)
            && (resource.data.ownerId == request.auth.uid)
          )
        );

      match /followers/{uid} {
        allow get, list: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == uid
          && !isMasterLeagueOwner(masterLeagueId)
          && request.resource.data.keys().hasOnly(['userId', 'followedAtMs'])
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid)
          && (request.resource.data.followedAtMs is int);
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /competition_templates/{templateId} {
        allow get, list: if signedIn();
        allow create, update, delete: if isMasterLeagueOwner(masterLeagueId);
      }

      match /chatroom/{messageId} {
        allow get, list: if signedIn();
        allow create: if signedIn() && validOrganizerChatMessageCreate(messageId, masterLeagueId);
        allow update: if signedIn() && (validChatSoftDeleteUpdate() || validChatPinUpdate());
        allow delete: if false;
      }

      match /disciplineActions/{actionId} {
        allow get, list: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'id','masterLeagueId','targetUserId','targetShareId','targetName',
            'targetRole','actionType','pointsDelta','reason','createdBy',
            'createdByName','createdAtMs','active','reversedAtMs','reversedBy',
            'reversedByName','reversalReason'
          ])
          && (request.resource.data.id is string)
          && (request.resource.data.id == actionId)
          && (request.resource.data.masterLeagueId is string)
          && (request.resource.data.masterLeagueId == masterLeagueId)
          && (request.resource.data.targetUserId is string)
          && (request.resource.data.targetUserId.size() > 0)
          && (!('targetShareId' in request.resource.data) || ((request.resource.data.targetShareId is string) && (request.resource.data.targetShareId.size() <= 20)))
          && (request.resource.data.targetName is string)
          && (request.resource.data.targetName.size() <= 120)
          && (request.resource.data.targetRole is string)
          && (request.resource.data.targetRole.size() <= 40)
          && (request.resource.data.actionType is string)
          && (request.resource.data.actionType in [
            'warning',
            'points_deduction',
            'organizer_chat_mute',
            'organizer_chat_ban',
            'organizer_chat_unmute',
            'organizer_chat_unban'
          ])
          && (request.resource.data.pointsDelta is int)
          && (request.resource.data.reason is string)
          && (request.resource.data.reason.size() > 0)
          && (request.resource.data.reason.size() <= 1000)
          && (request.resource.data.createdBy is string)
          && (request.resource.data.createdBy == request.auth.uid)
          && (!('createdByName' in request.resource.data) || ((request.resource.data.createdByName is string) && (request.resource.data.createdByName.size() <= 120)))
          && (request.resource.data.createdAtMs is int)
          && (request.resource.data.active is bool)
          && (request.resource.data.reversedAtMs is int)
          && (request.resource.data.reversedBy is string)
          && (!('reversedByName' in request.resource.data) || ((request.resource.data.reversedByName is string) && (request.resource.data.reversedByName.size() <= 120)))
          && (request.resource.data.reversalReason is string);

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'active','reversedAtMs','reversedBy','reversedByName','reversalReason'
          ])
          && (request.resource.data.reversedAtMs is int)
          && (request.resource.data.reversedBy is string)
          && (request.resource.data.reversedBy == request.auth.uid)
          && (!('reversedByName' in request.resource.data) || ((request.resource.data.reversedByName is string) && (request.resource.data.reversedByName.size() <= 120)))
          && (request.resource.data.reversalReason is string)
          && (request.resource.data.reversalReason.size() > 0)
          && (request.resource.data.reversalReason.size() <= 1000);

        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow get, list: if signedIn();

        allow create: if isMasterLeagueOwner(masterLeagueId)
          && request.resource.data.keys().hasOnly([
            'masterLeagueId','leagueId','title','message','authorId',
            'authorName','pinned','pinnedBy','pinnedAtMs','createdAtMs',
            'updatedAtMs'
          ])
          && (request.resource.data.masterLeagueId is string)
          && (request.resource.data.masterLeagueId == masterLeagueId)
          && (request.resource.data.title is string)
          && (request.resource.data.title.size() > 0)
          && (request.resource.data.title.size() <= 120)
          && (request.resource.data.message is string)
          && (request.resource.data.message.size() > 0)
          && (request.resource.data.message.size() <= 4000)
          && (request.resource.data.authorId is string)
          && (request.resource.data.authorId == request.auth.uid)
          && (request.resource.data.pinned is bool)
          && (request.resource.data.pinned == false)
          && (request.resource.data.pinnedAtMs is int)
          && (request.resource.data.createdAtMs is int)
          && (request.resource.data.updatedAtMs is int);

        // Covers both pin (pinned:true, pinnedBy:<uid>, pinnedAtMs:<ms>)
        // and unpin (pinned:false, pinnedBy:'', pinnedAtMs:0) — same field
        // set either way, including the "unpin the previously pinned one"
        // half of a pin batch.
        allow update: if isMasterLeagueOwner(masterLeagueId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'pinned','pinnedBy','pinnedAtMs'
          ])
          && (request.resource.data.pinned is bool)
          && (request.resource.data.pinnedBy is string)
          && (request.resource.data.pinnedAtMs is int);

        allow delete: if isMasterLeagueOwner(masterLeagueId);
      }

      match /memberModeration/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow list: if signedIn();

        allow create, update: if signedIn()
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == userId)
          && (!('shareId' in request.resource.data) || ((request.resource.data.shareId is string) && (request.resource.data.shareId.size() <= 20)))
          && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string))
          && (request.resource.data.points is int)
          && (request.resource.data.warnings is int)
          && (request.resource.data.chatMuted is bool)
          && (request.resource.data.chatBanned is bool)
          && (request.resource.data.updatedAtMs is int);

        allow delete: if false;
      }
    }

    match /master_league_verification_requests/{requestId} {
      allow get: if signedIn()
        && (
          isPricingAdmin()
          || (
            resource != null
            && (resource.data.ownerId is string)
            && (resource.data.ownerId == request.auth.uid)
          )
        );
      allow list: if isPricingAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'requestId','masterLeagueId','ownerId','status','requestType',
          'provider','receiptId','paymentId','attemptId','submittedAtMs',
          'reviewedAtMs','reviewedBy','note','resubmittedAtMs',
          'orgName','orgType','orgCountry','orgRegion','orgCity',
          'contactEmail','contactPhone','website','socialLink',
          'applicantFullName','applicantRole','orgDescription',
          'competitionTypes','verificationReason','supportingLinks','logoUrl'
        ])
        && (request.resource.data.requestId is string) && (request.resource.data.requestId == requestId)
        && (request.resource.data.masterLeagueId is string) && validMasterLeagueId(request.resource.data.masterLeagueId)
        && isMasterLeagueOwner(request.resource.data.masterLeagueId)
        && (request.resource.data.ownerId is string) && (request.resource.data.ownerId == request.auth.uid)
        && (request.resource.data.status is string) && (request.resource.data.status == 'pending')
        && (request.resource.data.requestType is string) && validVerificationRequestType(request.resource.data.requestType)
        && (request.resource.data.provider is string) && (request.resource.data.provider.size() <= 40)
        && (request.resource.data.receiptId is string) && (request.resource.data.receiptId.size() <= 200)
        && (request.resource.data.paymentId is string) && (request.resource.data.paymentId.size() <= 200)
        && (request.resource.data.attemptId is string) && (request.resource.data.attemptId.size() <= 200)
        && (request.resource.data.submittedAtMs is int)
        && (!('reviewedAtMs' in request.resource.data) || ((request.resource.data.reviewedAtMs is int) && (request.resource.data.reviewedAtMs == 0)))
        && (!('reviewedBy' in request.resource.data) || ((request.resource.data.reviewedBy is string) && (request.resource.data.reviewedBy == '')))
        && (!('note' in request.resource.data) || ((request.resource.data.note is string) && (request.resource.data.note.size() <= 1000)))
        && (!('resubmittedAtMs' in request.resource.data) || (request.resource.data.resubmittedAtMs is int));

      allow update: if (
        isPricingAdmin()
        && request.resource.data.keys().hasOnly([
          'requestId','masterLeagueId','ownerId','status','requestType',
          'provider','receiptId','paymentId','attemptId','submittedAtMs',
          'reviewedAtMs','reviewedBy','note','resubmittedAtMs',
          'orgName','orgType','orgCountry','orgRegion','orgCity',
          'contactEmail','contactPhone','website','socialLink',
          'applicantFullName','applicantRole','orgDescription',
          'competitionTypes','verificationReason','supportingLinks','logoUrl'
        ])
        && (request.resource.data.requestId == resource.data.requestId)
        && (request.resource.data.masterLeagueId == resource.data.masterLeagueId)
        && (request.resource.data.ownerId == resource.data.ownerId)
        && (request.resource.data.requestType == resource.data.requestType)
        && (request.resource.data.provider == resource.data.provider)
        && (request.resource.data.receiptId == resource.data.receiptId)
        && (request.resource.data.paymentId == resource.data.paymentId)
        && (request.resource.data.attemptId == resource.data.attemptId)
        && (request.resource.data.submittedAtMs == resource.data.submittedAtMs)
        && (resource.data.status in ['pending', 'info_requested'])
        && (request.resource.data.status is string)
        && (request.resource.data.status in ['approved', 'rejected', 'info_requested'])
        && (request.resource.data.reviewedAtMs is int)
        && (request.resource.data.reviewedAtMs > 0)
        && (request.resource.data.reviewedBy is string)
        && (request.resource.data.reviewedBy == request.auth.uid)
        && (request.resource.data.note is string)
        && (request.resource.data.note.size() <= 1000)
      ) || (
        signedIn()
        && (resource.data.ownerId == request.auth.uid)
        && (resource.data.status == 'info_requested')
        && (request.resource.data.status == 'pending')
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'resubmittedAtMs', 'orgName', 'orgType', 'orgCountry', 'orgRegion', 'orgCity',
          'contactEmail', 'contactPhone', 'website', 'socialLink', 'applicantFullName', 
          'applicantRole', 'orgDescription', 'competitionTypes', 'verificationReason', 
          'supportingLinks', 'logoUrl'
        ])
        && (request.resource.data.resubmittedAtMs is int)
      );

      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','leagueId','title','message','createdAtMs','authorId','authorName','scope','masterLeagueId'])
        && (request.resource.data.id is string) && (request.resource.data.id == announcementId)
        && (request.resource.data.title is string) && (request.resource.data.title.size() >= 1) && (request.resource.data.title.size() <= 80)
        && (request.resource.data.message is string) && (request.resource.data.message.size() >= 1) && (request.resource.data.message.size() <= 1000)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.authorId is string) && (request.resource.data.authorId == request.auth.uid)
        && (request.resource.data.authorName is string) && (request.resource.data.authorName.size() <= 120)
        && (request.resource.data.scope is string) && (request.resource.data.scope in ['league', 'master_league'])
        && (
          (
            request.resource.data.scope == 'master_league'
            && (request.resource.data.masterLeagueId is string)
            && validMasterLeagueId(request.resource.data.masterLeagueId)
            && isMasterLeagueOwner(request.resource.data.masterLeagueId)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == '')
          )
          || (
            request.resource.data.scope == 'league'
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId.size() > 0)
            && canManageLeague(request.resource.data.leagueId)
          )
        );

      allow delete: if signedIn()
        && resource != null
        && (
          (
            (resource.data.scope is string)
            && (resource.data.scope == 'master_league')
            && (resource.data.masterLeagueId is string)
            && isMasterLeagueOwner(resource.data.masterLeagueId)
          )
          || ((resource.data.authorId is string) && (resource.data.authorId == request.auth.uid))
          || isPricingAdmin()
        );

      allow update: if false;
    }

    match /leagues/{leagueId} {
      allow read: if canReadLeagueDirect();

      allow create: if signedIn()
        && ('organizerUid' in request.resource.data)
        && (request.resource.data.organizerUid is string)
        && (request.resource.data.organizerUid == request.auth.uid)
        && (!('ownerUid' in request.resource.data) || ((request.resource.data.ownerUid is string) && (request.resource.data.ownerUid == request.auth.uid)))
        && (!('ownerId' in request.resource.data) || ((request.resource.data.ownerId is string) && (request.resource.data.ownerId == request.auth.uid)))
        && (!(request.resource.data.memberIds is list) || (request.auth.uid in request.resource.data.memberIds))
        && (!('masterLeagueId' in request.resource.data)
          || (request.resource.data.masterLeagueId == null)
          || (request.resource.data.masterLeagueId == '')
          || ((request.resource.data.masterLeagueId is string) && (request.resource.data.masterLeagueId.size() > 0) && validMasterLeagueId(request.resource.data.masterLeagueId))
        )
        && (!('format' in request.resource.data) || validLeagueFormatIndex(request.resource.data.format))
        && (!('settings' in request.resource.data) || validLeagueSettingsMap(request.resource.data.settings))
        && validWorldCupTeamCount(request.resource.data)
        && (!('footballCategory' in request.resource.data) || validFootballCategory(request.resource.data.footballCategory));

      allow update: if (
          (
            isOwnerDirect()
            || (
              signedIn()
              && (request.resource.data.memberIds is list)
              && (request.auth.uid in request.resource.data.memberIds)
              && !request.resource.data.diff(resource.data).changedKeys().hasAny(['masterLeagueId'])
            )
          ) && (
            (!('format' in request.resource.data) || validLeagueFormatIndex(request.resource.data.format))
            && (!('settings' in request.resource.data) || validLeagueSettingsMap(request.resource.data.settings))
            && validWorldCupTeamCount(request.resource.data)
            && (!('footballCategory' in request.resource.data) || validFootballCategory(request.resource.data.footballCategory))
          )
        ) || (
          signedIn()
          && resource != null
          && (resource.data.memberIds is list)
          && (request.auth.uid in resource.data.memberIds)
          && (request.resource.data.memberIds is list)
          && !(request.auth.uid in request.resource.data.memberIds)
          && (resource.data.ownerUid is string)
          && (resource.data.ownerUid != request.auth.uid)
          && (resource.data.organizerUid is string)
          && (resource.data.organizerUid != request.auth.uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds','updatedAtMs'])
        );

      allow delete: if isOwnerDirect();

      // Competition Rules & Configuration — separate from disciplineActions.
      // Competition Rules = what participants must follow.
      // Discipline (disciplineActions, above) = what organizers can do when
      // rules are broken. Doc id "current" is the live/published rules;
      // doc ids "v{n}" are archived historical versions written only when
      // a locked version is later edited (see saveCompetitionRules).
      match /competitionRules/{ruleDocId} {
        allow get, list: if signedIn();

        allow create, update: if canManageLeague(leagueId)
          && (request.resource.data.keys().hasOnly([
            'leagueId','version','locked','competitionType','scheduling',
            'matchSettings','gameplay','connection','noShow',
            'resultSubmission','evidence','eligibility','fairPlay',
            'disputes','updatedAtMs','updatedBy','updatedByName'
          ]))
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId)
          && (request.resource.data.version is int)
          && (request.resource.data.locked is bool)
          && (request.resource.data.updatedAtMs is int)
          && (request.resource.data.updatedBy is string)
          && (request.resource.data.updatedBy == request.auth.uid);

        allow delete: if false;
      }

      match /rewards/{rewardId} {
        allow get, list: if signedIn();
        allow create: if canManageLeague(leagueId) && validRewardFields();
        allow update: if canManageLeague(leagueId) && validRewardFields();
        allow delete: if canManageLeague(leagueId);
      }

      match /teams/{teamId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId)
          && validWorldCupTeamAggregateFields();
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId)
          && validWorldCupGroupMatchWrite();
      }

      match /knockout/{matchId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId)
          && validWorldCupKnockoutFields();
      }

      match /memberships/{membershipId} {
        allow read: if signedIn();

        allow create: if canManageLeague(leagueId)
          || (
            signedIn()
            && request.auth.uid == membershipId
            && (request.resource.data.userId is string)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role is int)
            && (isMemberRole(request.resource.data.role) || isOrganizerRole(request.resource.data.role))
          );

        allow update: if canManageLeague(leagueId)
          || (
            signedIn()
            && request.auth.uid == membershipId
            && (resource.data.userId == request.auth.uid)
            && (resource.data.leagueId == leagueId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['teamId','updatedAtMs','version'])
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role == resource.data.role)
          );

        allow delete: if canManageLeague(leagueId)
          || (
            signedIn()
            && request.auth.uid == membershipId
            && (resource.data.userId is string)
            && (resource.data.userId == request.auth.uid)
            && (resource.data.leagueId is string)
            && (resource.data.leagueId == leagueId)
            && (resource.data.role is int)
            && resource.data.role != 0
          );
      }

      match /announcements/{annId} {
        allow read: if signedIn();
        allow write: if canManageLeague(leagueId);
      }

      match /chatroom/{messageId} {
        allow get, list: if isLeagueMemberNoGet(leagueId);
        allow create: if isLeagueMemberNoGet(leagueId)
          && validChatMessageCreate(messageId)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);
        allow update: if isLeagueMemberNoGet(leagueId)
          && (
            (validChatPinUpdate() && canPinLeagueMessage(leagueId))
            || (validChatSoftDeleteUpdate() && canDeleteLeagueMessage(leagueId))
          );
        allow delete: if canManageLeague(leagueId)
          || (signedIn() && (resource.data.senderId is string) && (resource.data.senderId == request.auth.uid));
      }

      match /space/{docId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && (
            canManageLeague(leagueId)
            || (('hostUserId' in request.resource.data) && (request.resource.data.hostUserId is string) && (request.resource.data.hostUserId == request.auth.uid))
          );
        allow update: if signedIn()
          && (
            canManageLeague(leagueId)
            || (resource != null && ('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
            || (('hostUserId' in request.resource.data) && (request.resource.data.hostUserId is string) && (request.resource.data.hostUserId == request.auth.uid))
          );
        allow delete: if canManageLeague(leagueId);

        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create: if signedIn();
          allow update, delete: if false;
        }

        match /requests/{uid} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == uid;
          allow update: if signedIn() && (canManageLeague(leagueId) || (request.auth.uid == uid));
          allow delete: if signedIn() && (canManageLeague(leagueId) || (request.auth.uid == uid));
        }

        match /speakers/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if signedIn()
            && (
              canManageLeague(leagueId)
              || (
                exists(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId))
                && get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data.get('hostUserId', '') == request.auth.uid
              )
            );
        }
      }

      match /couponConfig/{docId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);
        allow update: if signedIn()
          && (
            ((resource.data.organizerUserId is string) && (resource.data.organizerUserId == request.auth.uid))
            || (
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['qtyRemaining','updatedAtMs'])
              && (request.resource.data.qtyRemaining is int)
              && (request.resource.data.qtyRemaining == (resource.data.qtyRemaining - 1))
              && (request.resource.data.qtyRemaining >= 0)
            )
          );
        allow delete: if false;
      }

      match /couponCodes/{codeId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedBy','usedAtMs','updatedAtMs'])
          && (resource.data.usedBy is string)
          && (resource.data.usedBy == '')
          && (request.resource.data.usedBy is string)
          && (request.resource.data.usedBy == request.auth.uid);
        allow delete: if false;
      }

      match /couponRedemptions/{uid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && uid == request.auth.uid
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);
        allow update: if signedIn()
          && uid == request.auth.uid
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid);
        allow delete: if false;
      }

      match /coupons/{couponId} {
        allow read, write: if false;
      }

      match /pointAdjustments/{adjustmentId} {
        allow read: if canManageLeague(leagueId);

        allow create: if canManageLeague(leagueId)
          && request.resource.data.keys().hasOnly([
            'id', 'leagueId', 'teamId', 'type', 'points',
            'reason', 'adjustedBy', 'createdAt', 'createdAtMs'
          ])
          && (request.resource.data.id is string) && (request.resource.data.id == adjustmentId)
          && (request.resource.data.leagueId is string) && (request.resource.data.leagueId == leagueId)
          && (request.resource.data.teamId is string) && (request.resource.data.teamId.size() > 0)
          && (request.resource.data.type is string) && (request.resource.data.type in ['ADDITION', 'DEDUCTION'])
          && (request.resource.data.points is int) && (request.resource.data.points > 0) && (request.resource.data.points <= 1000)
          && (request.resource.data.reason is string) && (request.resource.data.reason.size() > 0) && (request.resource.data.reason.size() <= 500)
          && (request.resource.data.adjustedBy is string) && (request.resource.data.adjustedBy == request.auth.uid)
          && (request.resource.data.createdAt is timestamp)
          && (request.resource.data.createdAtMs is int);

        allow update: if false;
        allow delete: if false;
      }
    }

    match /matches/{matchId} {
      allow get, list, create, update, delete: if false;

      match /highlights/{highlightId} {
        allow get, list: if signedIn()
          && ('leagueId' in resource.data)
          && (resource.data.leagueId is string)
          && canReadLeague(resource.data.leagueId);
        allow create: if signedIn() && highlightCreateIsValid(matchId, highlightId);
        allow update: if signedIn()
          && (
            highlightUploaderUpdateIsValid(matchId, highlightId)
            || highlightModeratorUpdateIsValid(matchId, highlightId)
          );
        allow delete: if signedIn()
          && ('uploadedBy' in resource.data)
          && (resource.data.uploadedBy is string)
          && (resource.data.uploadedBy == request.auth.uid)
          && ('status' in resource.data)
          && (resource.data.status is string)
          && (resource.data.status == 'UPLOADING');
      }
    }

    match /league_spaces/{spaceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /call_rooms/{callId} {
      allow get: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
        );
      allow list: if signedIn();
      allow create: if signedIn()
        && (
          (('createdBy' in request.resource.data) && (request.resource.data.createdBy is string) && (request.resource.data.createdBy == request.auth.uid))
          || (('hostUserId' in request.resource.data) && (request.resource.data.hostUserId is string) && (request.resource.data.hostUserId == request.auth.uid))
        );
      allow update: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
          || (('participantIds' in request.resource.data) && (request.resource.data.participantIds is list) && (request.auth.uid in request.resource.data.participantIds))
        );
      allow delete: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
        );

      match /quick_messages/{msgId} {
        allow read: if isCallParticipant(callId);
        allow create: if signedIn()
          && (request.resource.data.senderId is string)
          && (request.resource.data.senderId == request.auth.uid)
          && isCallParticipant(callId);
        allow update, delete: if false;
      }
    }

    match /marketplace_products/{productId} {
      allow get, list: if signedIn();
      allow create: if isPricingAdmin()
        && (request.resource.data.createdBy is string)
        && (request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.keys().hasAll(['productId','name','price','description','imageUrl','affiliateUrl','category','sellerName','createdAt','createdBy'])
        && (request.resource.data.productId is string)
        && (request.resource.data.productId == productId)
        && (request.resource.data.name is string)
        && (request.resource.data.price is string)
        && (request.resource.data.description is string)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.affiliateUrl is string)
        && (request.resource.data.category is string)
        && (request.resource.data.sellerName is string)
        && (request.resource.data.createdAt is timestamp);
      allow update, delete: if false;
    }

    match /app/{docId} {
      allow get, list: if (docId == 'pricing') || (docId == 'admins' && signedIn());
      allow create, update: if (docId == 'pricing' || docId == 'admins') && isPricingAdmin();
      allow delete: if false;
    }

    match /app_config/{docId} {
      allow get, list: if (docId == 'pricing');
      allow create, update: if (docId == 'pricing') && isPricingAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PAYMENT RULES FIXED BELOW — `masterLeagueName` ADDED TO `hasOnly`,
    // AND `leagueId`/`leagueName`/`masterLeagueId`/`couponCode` immutability
    // checks GUARDED WITH `in` ON BOTH `payments` AND `payment_attempts`.
    //
    // ROOT CAUSE OF THE "Get Verified" STEP 5 PERMISSION-DENIED:
    // payment_attempts docs for organizer-verification fees are created
    // directly by the Flutter client and never include `leagueId` /
    // `leagueName` (there's no league involved in an organizer
    // verification purchase). The `update` rule below used to compare
    // `request.resource.data.leagueId == resource.data.leagueId` with NO
    // `('leagueId' in resource.data)` guard — unlike every other optional
    // field in the same rule (masterLeagueName, productType,
    // productSubType, planId, planDurationId, metadata), which ARE
    // guarded. Reading a map key that doesn't exist on either side of a
    // comparison throws inside Firestore's rules evaluator, and a thrown
    // error inside `allow update` is treated as a hard deny — so ANY
    // update to a payment_attempts doc that never had leagueId/leagueName
    // set (i.e. every organizer-verification attempt) was unconditionally
    // rejected with permission-denied, regardless of who was calling it or
    // what else was true. Added the missing `in` guards below, matching
    // the pattern already used for the sibling optional fields. The same
    // unguarded pattern existed on `payments` (safe today only because the
    // Cloudflare Worker always backfills leagueId/leagueName to '' there,
    // which is incidental, not enforced) — guarded defensively for
    // consistency.
    // ─────────────────────────────────────────────────────────────────────────
    
    match /payment_attempts/{attemptId} {
      function validCurrency(c) { return (c is string) && (c in ['NGN', 'USD', 'PLAY']); }
      function validProvider(p) {
        return (p is string) && (p in [
          'flutterwave',
          'free',
          'google_play_billing',
          'google_play'
        ]);
      }
      function validStatusForClient(s) { return (s is string) && (s in ['initiated', 'client_success', 'cancelled', 'client_failed', 'verified', 'fulfilled']); }
      function validProductType(t) { return (t is string) && (t.size() <= 80); }
      function validProductSubType(t) { return (t is string) && (t.size() <= 120); }

      allow get: if isPricingAdmin()
        || (
          signedIn()
          && resource != null
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid)
        );
      allow list: if isPricingAdmin();

      allow create: if signedIn()
        && (request.resource.data.attemptId is string) && (request.resource.data.attemptId == attemptId)
        && (request.resource.data.userId is string) && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.provider is string) && validProvider(request.resource.data.provider)
        && validCurrency(request.resource.data.currency)
        && (request.resource.data.amount is int || request.resource.data.amount is float) && (request.resource.data.amount >= 0)
        && (request.resource.data.amountStr is string)
        && (request.resource.data.status is string) && (request.resource.data.status == 'initiated')
        && (request.resource.data.createdAtMs is int) && (request.resource.data.updatedAtMs is int)
        && (request.resource.data.items is list)
        && (!('productType' in request.resource.data) || validProductType(request.resource.data.productType))
        && (!('productSubType' in request.resource.data) || validProductSubType(request.resource.data.productSubType))
        && (!('planId' in request.resource.data) || validPlanId(request.resource.data.planId))
        && (!('planDurationId' in request.resource.data) || validPlanDurationId(request.resource.data.planDurationId))
        && (!('metadata' in request.resource.data) || (request.resource.data.metadata is map))
        && request.resource.data.keys().hasOnly([
          'attemptId','provider','currency','amount','amountStr','userId',
          'leagueId','leagueName','masterLeagueId','masterLeagueName','couponCode','productType',
          'productSubType','planId','planDurationId','metadata','status',
          'createdAtMs','updatedAtMs','items'
        ]);

      allow update: if signedIn()
        && resource != null
        && (resource.data.userId is string)
        && (resource.data.userId == request.auth.uid)
        && (request.resource.data.userId == resource.data.userId)
        && (request.resource.data.attemptId == resource.data.attemptId)
        && (request.resource.data.provider == resource.data.provider)
        && (request.resource.data.currency == resource.data.currency)
        && (request.resource.data.amount == resource.data.amount)
        && (request.resource.data.amountStr == resource.data.amountStr)
        && (!('leagueId' in resource.data) || (request.resource.data.leagueId == resource.data.leagueId))
        && (!('leagueName' in resource.data) || (request.resource.data.leagueName == resource.data.leagueName))
        && (!('masterLeagueId' in resource.data) || (request.resource.data.masterLeagueId == resource.data.masterLeagueId))
        && (!('masterLeagueName' in resource.data) || (request.resource.data.masterLeagueName == resource.data.masterLeagueName))
        && (!('couponCode' in resource.data) || (request.resource.data.couponCode == resource.data.couponCode))
        && (request.resource.data.items == resource.data.items)
        && (!('productType' in resource.data) || (request.resource.data.productType == resource.data.productType))
        && (!('productSubType' in resource.data) || (request.resource.data.productSubType == resource.data.productSubType))
        && (!('planId' in resource.data) || (request.resource.data.planId == resource.data.planId))
        && (!('planDurationId' in resource.data) || (request.resource.data.planDurationId == resource.data.planDurationId))
        && (!('metadata' in resource.data) || (request.resource.data.metadata == resource.data.metadata))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status','providerTransactionId','txRef','errorMessage','paymentId',
          'receiptId','paidAtMs','updatedAtMs','fulfilledMasterLeagueId',
          'fulfilledVerificationRequestId','purchaseToken'
        ])
        && request.resource.data.diff(resource.data).addedKeys().hasOnly([
          'status','providerTransactionId','txRef','errorMessage','paymentId',
          'receiptId','paidAtMs','updatedAtMs','fulfilledMasterLeagueId',
          'fulfilledVerificationRequestId','purchaseToken'
        ])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && validStatusForClient(request.resource.data.status)
        && (request.resource.data.updatedAtMs is int);

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isPricingAdmin()
        || (
          signedIn()
          && resource != null
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid)
        );
      allow list: if isPricingAdmin();

      allow create: if signedIn()
        && (request.resource.data.paymentId is string)
        && (request.resource.data.paymentId == paymentId)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.status is string)
        && (request.resource.data.status == 'success')
        && (!('productId' in request.resource.data) || ((request.resource.data.productId is string) && (request.resource.data.productId.size() <= 200)))
        && request.resource.data.keys().hasOnly([
          'paymentId','attemptId','status','provider','providerTransactionId',
          'txRef','receiptId','userId','leagueId','leagueName','masterLeagueId',
          'masterLeagueName','couponCode','currency','amount','amountStr','items','productType',
          'productSubType','productId','metadata','paidAtMs','createdAtMs','updatedAtMs',
          'verification','rawFlutterwaveVerification','fulfilledMasterLeagueId',
          'fulfilledVerificationRequestId','fulfilledAtMs','firebaseEmail',
          'flutterwaveEmail',
          'purchaseToken'
        ]);

      // NOTE: unlike payment_attempts (whose create rule strictly requires
      // and type-checks attemptId/provider/currency/amount/amountStr/items
      // for every attempt), payments' create rule ONLY requires paymentId,
      // userId, and status — every other field is optional at creation.
      // Google Play-sourced payment docs carry purchaseToken and omit the
      // Flutterwave-only fields (providerTransactionId, txRef), and may
      // not set every generic field either. Every comparison below is
      // therefore guarded with an existence check so a field that's
      // legitimately absent on a given payment doc can't crash the rule
      // evaluator (which Firestore treats as a hard deny) — the equality
      // constraint still applies in full whenever the field IS present.
      allow update: if signedIn()
        && resource != null
        && (resource.data.userId is string)
        && (resource.data.userId == request.auth.uid)
        && (request.resource.data.userId == resource.data.userId)
        && (request.resource.data.paymentId == resource.data.paymentId)
        && (!('attemptId' in resource.data) || (request.resource.data.attemptId == resource.data.attemptId))
        && (!('provider' in resource.data) || (request.resource.data.provider == resource.data.provider))
        && (!('providerTransactionId' in resource.data) || (request.resource.data.providerTransactionId == resource.data.providerTransactionId))
        && (!('txRef' in resource.data) || (request.resource.data.txRef == resource.data.txRef))
        && (!('receiptId' in resource.data) || (request.resource.data.receiptId == resource.data.receiptId))
        && (!('leagueId' in resource.data) || (request.resource.data.leagueId == resource.data.leagueId))
        && (!('leagueName' in resource.data) || (request.resource.data.leagueName == resource.data.leagueName))
        && (!('masterLeagueId' in resource.data) || (request.resource.data.masterLeagueId == resource.data.masterLeagueId))
        && (!('masterLeagueName' in resource.data) || (request.resource.data.masterLeagueName == resource.data.masterLeagueName))
        && (!('couponCode' in resource.data) || (request.resource.data.couponCode == resource.data.couponCode))
        && (!('currency' in resource.data) || (request.resource.data.currency == resource.data.currency))
        && (!('amount' in resource.data) || (request.resource.data.amount == resource.data.amount))
        && (!('amountStr' in resource.data) || (request.resource.data.amountStr == resource.data.amountStr))
        && (!('items' in resource.data) || (request.resource.data.items == resource.data.items))
        && (!('productType' in resource.data) || (request.resource.data.productType == resource.data.productType))
        && (!('productSubType' in resource.data) || (request.resource.data.productSubType == resource.data.productSubType))
        && (!('metadata' in resource.data) || (request.resource.data.metadata == resource.data.metadata))
        && (!('verification' in resource.data) || (request.resource.data.verification == resource.data.verification))
        && (!('rawFlutterwaveVerification' in resource.data) || (request.resource.data.rawFlutterwaveVerification == resource.data.rawFlutterwaveVerification))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'fulfilledMasterLeagueId','fulfilledVerificationRequestId',
          'fulfilledAtMs','updatedAtMs'
        ])
        && request.resource.data.diff(resource.data).addedKeys().hasOnly([
          'fulfilledMasterLeagueId','fulfilledVerificationRequestId',
          'fulfilledAtMs','updatedAtMs'
        ])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && (!('fulfilledMasterLeagueId' in resource.data) || resource.data.fulfilledMasterLeagueId == '')
        && (!('fulfilledVerificationRequestId' in resource.data) || resource.data.fulfilledVerificationRequestId == '')
        && (request.resource.data.updatedAtMs is int);

      allow delete: if false;
    }

    match /analytics_summary/{docId} {
      allow get, list: if isPricingAdmin();
      allow create, update: if isPricingAdmin();
      allow delete: if false;
    }

    match /revenue_by_day/{dayId} {
      allow get, list: if isPricingAdmin();
      allow create, update: if isPricingAdmin();
      allow delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && (request.resource.data.eventName is string)
        && (request.resource.data.eventName.size() > 0)
        && (request.resource.data.eventName.size() <= 200)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && request.resource.data.keys().hasOnly(['eventName','createdAtMs','userId','extra']);
      allow get, list: if isPricingAdmin();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Universal Sharing & Deep Linking analytics
    // ─────────────────────────────────────────────────────────────────────
    //
    //   - `create` is allowed for BOTH signed-in and signed-out (anonymous
    //     browser) visitors, because share links must be clickable by people
    //     who have never signed in — that is the whole point of a public
    //     share link. Every field is still strictly type/size/enum validated
    //     so this cannot be abused to write arbitrary data.
    //   - No `get`/`list` is granted to clients at all: dashboard reads are
    //     expected to go through the Admin SDK / a Cloud Function (matching
    //     how `analytics_events`/`analytics_summary` are already read-gated
    //     to isPricingAdmin() elsewhere in this file, but these link-event
    //     documents are higher-volume and lower-sensitivity, so they are not
    //     even exposed to admins via direct client reads).
    //   - `update`/`delete` are never allowed on events — the log is
    //     append-only, and the rollup document is only ever touched via
    //     `create`/`update` (Firestore's create/update split applies per
    //     document: the FIRST write to a given rollup doc id is a `create`,
    //     subsequent merges to the SAME doc id are `update`s, so both must
    //     be granted for the increment pattern used by LinkAnalyticsService
    //     to work).

    function validLinkEventType(t) { return (t is string) && (t in ['share', 'click']); }

    function validLinkEntityType(t) {
      return (t is string) && (t in [
        'userProfile', 'competition', 'team', 'post', 'organizerWorkspace',
        'marketProduct', 'tournament', 'news', 'achievement'
      ]);
    }

    function validLinkChannel(c) {
      return (c is string) && (c in [
        'whatsapp', 'telegram', 'facebook', 'x', 'sms', 'copy_link',
        'system_share', 'deep_link', 'web_direct'
      ]);
    }

    match /analytics_link_events/{eventId} {
      allow get, list: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'eventId', 'eventType', 'entityType', 'entityId', 'channel',
          'userId', 'createdAtMs'
        ])
        && (request.resource.data.eventId is string) && (request.resource.data.eventId == eventId)
        && validLinkEventType(request.resource.data.eventType)
        && validLinkEntityType(request.resource.data.entityType)
        && (request.resource.data.entityId is string)
        && (request.resource.data.entityId.size() > 0)
        && (request.resource.data.entityId.size() <= 200)
        && validLinkChannel(request.resource.data.channel)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId.size() <= 128)
        && (
          (request.resource.data.userId == '')
          || (signedIn() && request.resource.data.userId == request.auth.uid)
        )
        && (request.resource.data.createdAtMs is int);

      allow update, delete: if false;
    }

    match /analytics_link_rollups/{rollupId} {
      allow get, list: if false;

      function validRollupWrite() {
        return request.resource.data.keys().hasOnly([
          'entityType', 'entityId', 'shareCount', 'clickCount', 'lastEventAtMs'
        ])
        && validLinkEntityType(request.resource.data.entityType)
        && (request.resource.data.entityId is string)
        && (request.resource.data.entityId.size() > 0)
        && (request.resource.data.entityId.size() <= 200)
        && (rollupId == (request.resource.data.entityType + '_' + request.resource.data.entityId))
        && (!('shareCount' in request.resource.data) || (request.resource.data.shareCount is int) && (request.resource.data.shareCount >= 0))
        && (!('clickCount' in request.resource.data) || (request.resource.data.clickCount is int) && (request.resource.data.clickCount >= 0))
        && (request.resource.data.lastEventAtMs is int);
      }

      allow create: if validRollupWrite();
      allow update: if validRollupWrite()
        // Only the two counters and the timestamp may ever change — identity
        // fields are immutable once the rollup doc exists.
        && (request.resource.data.entityType == resource.data.entityType)
        && (request.resource.data.entityId == resource.data.entityId);

      allow delete: if false;
    }

    match /platform_announcements/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /public_posts/{postId} {
      allow get, list: if true;

      allow create: if signedIn()
        && (isSuperAdmin() || profileHasActivePlan('pro') || profileHasActivePlan('elite'))
        && request.resource.data.keys().hasOnly([
          'postId','authorId','authorDisplayName','authorPhotoUrl','createdAtMs',
          'text','mediaUrl','audioUrl','postType','leagueId','leagueName',
          'matchScoreHome','matchScoreAway','matchOpponentName',
          'isPromoted','likeCount','commentCount','deleted'
        ])
        && (request.resource.data.postId is string) && (request.resource.data.postId == postId)
        && (request.resource.data.authorId is string) && (request.resource.data.authorId == request.auth.uid)
        && (request.resource.data.authorDisplayName is string) && (request.resource.data.authorDisplayName.size() <= 120)
        && (request.resource.data.authorPhotoUrl is string) && (request.resource.data.authorPhotoUrl.size() <= 2000)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (request.resource.data.text is string) && (request.resource.data.text.size() <= 2000)
        && (request.resource.data.mediaUrl is string) && (request.resource.data.mediaUrl.size() <= 2000)
        && (!('audioUrl' in request.resource.data) || ((request.resource.data.audioUrl is string) && (request.resource.data.audioUrl.size() <= 2000)))
        && (request.resource.data.postType is string) && (request.resource.data.postType in ['text','competition_promo','match_result'])
        && (request.resource.data.leagueId is string) && (request.resource.data.leagueId.size() <= 200)
        && (request.resource.data.leagueName is string) && (request.resource.data.leagueName.size() <= 200)
        && (request.resource.data.matchScoreHome is int) && (request.resource.data.matchScoreHome == 0)
        && (request.resource.data.matchScoreAway is int) && (request.resource.data.matchScoreAway == 0)
        && (request.resource.data.matchOpponentName is string) && (request.resource.data.matchOpponentName == '')
        && (request.resource.data.isPromoted is bool) && (request.resource.data.isPromoted == false)
        && (request.resource.data.likeCount is int) && (request.resource.data.likeCount == 0)
        && (request.resource.data.commentCount is int) && (request.resource.data.commentCount == 0)
        && (request.resource.data.deleted is bool) && (request.resource.data.deleted == false)
        && ((request.resource.data.text.size() > 0) || (request.resource.data.mediaUrl.size() > 0) || (request.resource.data.audioUrl.size() > 0));

      allow update: if signedIn()
        && ('authorId' in resource.data)
        && (resource.data.authorId is string)
        && (resource.data.authorId == request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted'])
        && (request.resource.data.deleted is bool)
        && (request.resource.data.deleted == true);

      allow update: if signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likeCount'])
        && (request.resource.data.likeCount is int)
        && (
          request.resource.data.likeCount == resource.data.likeCount + 1
          || (resource.data.likeCount > 0 && request.resource.data.likeCount == resource.data.likeCount - 1)
        );

      allow update: if signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount is int)
        && (request.resource.data.commentCount == resource.data.commentCount + 1);

      allow delete: if false;

      match /likes/{uid} {
        allow get, list: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && (request.resource.data.userId is string) && (request.resource.data.userId == uid)
          && (request.resource.data.likedAtMs is int);
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'commentId','postId','authorId','authorDisplayName','authorPhotoUrl',
            'text','createdAtMs','deleted'
          ])
          && (request.resource.data.commentId is string) && (request.resource.data.commentId == commentId)
          && (request.resource.data.postId is string) && (request.resource.data.postId == postId)
          && (request.resource.data.authorId is string) && (request.resource.data.authorId == request.auth.uid)
          && (request.resource.data.authorDisplayName is string) && (request.resource.data.authorDisplayName.size() <= 120)
          && (request.resource.data.authorPhotoUrl is string) && (request.resource.data.authorPhotoUrl.size() <= 2000)
          && (request.resource.data.text is string) && (request.resource.data.text.size() > 0) && (request.resource.data.text.size() <= 500)
          && isReasonableMs(request.resource.data.createdAtMs)
          && (request.resource.data.deleted is bool) && (request.resource.data.deleted == false);

        allow update: if signedIn()
          && ('authorId' in resource.data) && (resource.data.authorId is string)
          && (
            (resource.data.authorId == request.auth.uid)
            || (
              exists(/databases/$(database)/documents/public_posts/$(postId))
              && get(/databases/$(database)/documents/public_posts/$(postId)).data.get('authorId', '') == request.auth.uid
            )
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted'])
          && (request.resource.data.deleted is bool) && (request.resource.data.deleted == true);

        allow delete: if false;
      }
    }

    match /discussion_threads/{threadId} {
      allow get, list: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'threadId','authorId','authorDisplayName','authorPhotoUrl',
          'title','body','createdAtMs','lastReplyAtMs','replyCount','deleted'
        ])
        && (request.resource.data.threadId is string) && (request.resource.data.threadId == threadId)
        && (request.resource.data.authorId is string) && (request.resource.data.authorId == request.auth.uid)
        && (request.resource.data.authorDisplayName is string) && (request.resource.data.authorDisplayName.size() <= 120)
        && (request.resource.data.authorPhotoUrl is string) && (request.resource.data.authorPhotoUrl.size() <= 2000)
        && (request.resource.data.title is string) && (request.resource.data.title.size() > 0) && (request.resource.data.title.size() <= 140)
        && (request.resource.data.body is string) && (request.resource.data.body.size() <= 4000)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (request.resource.data.lastReplyAtMs is int) && (request.resource.data.lastReplyAtMs == request.resource.data.createdAtMs)
        && (request.resource.data.replyCount is int) && (request.resource.data.replyCount == 0)
        && (request.resource.data.deleted is bool) && (request.resource.data.deleted == false);

      allow update: if signedIn()
        && ('authorId' in resource.data) && (resource.data.authorId is string) && (resource.data.authorId == request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted'])
        && (request.resource.data.deleted is bool) && (request.resource.data.deleted == true);

      allow update: if signedIn()
        && !(('deleted' in resource.data) && (resource.data.deleted is bool) && (resource.data.deleted == true))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['replyCount','lastReplyAtMs'])
        && (request.resource.data.replyCount is int)
        && (request.resource.data.replyCount == resource.data.replyCount + 1)
        && isReasonableMs(request.resource.data.lastReplyAtMs);

      allow delete: if false;

      match /replies/{replyId} {
        allow get, list: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'replyId','threadId','authorId','authorDisplayName','authorPhotoUrl',
            'text','createdAtMs','deleted'
          ])
          && (request.resource.data.replyId is string) && (request.resource.data.replyId == replyId)
          && (request.resource.data.threadId is string) && (request.resource.data.threadId == threadId)
          && (request.resource.data.authorId is string) && (request.resource.data.authorId == request.auth.uid)
          && (request.resource.data.authorDisplayName is string) && (request.resource.data.authorDisplayName.size() <= 120)
          && (request.resource.data.authorPhotoUrl is string) && (request.resource.data.authorPhotoUrl.size() <= 2000)
          && (request.resource.data.text is string) && (request.resource.data.text.size() > 0) && (request.resource.data.text.size() <= 2000)
          && isReasonableMs(request.resource.data.createdAtMs)
          && (request.resource.data.deleted is bool) && (request.resource.data.deleted == false);

        allow update: if signedIn()
          && ('authorId' in resource.data) && (resource.data.authorId is string) && (resource.data.authorId == request.auth.uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted'])
          && (request.resource.data.deleted is bool) && (request.resource.data.deleted == true);

        allow delete: if false;
      }
    }

    match /private_threads/{threadId} {
      function threadParticipantIds(data) {
        return data.get('participantIds', []);
      }

      function otherParticipant(ids) {
        return ids[0] == request.auth.uid ? ids[1] : ids[0];
      }

      function notBlockedEitherWay(otherUid) {
        return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_users/$(otherUid))
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_by/$(otherUid));
      }

      function requesterHasActivePlan() {
        return profileHasActivePlan('pro') || profileHasActivePlan('elite');
      }

      allow get: if signedIn() && (request.auth.uid in threadParticipantIds(resource.data));
      allow list: if signedIn();

      allow create: if signedIn()
        && (request.resource.data.participantIds is list)
        && (request.resource.data.participantIds.size() == 2)
        && (request.auth.uid in request.resource.data.participantIds)
        && (request.resource.data.initiatedBy is string)
        && (request.resource.data.initiatedBy == request.auth.uid)
        && (request.resource.data.lastMessage is string)
        && (request.resource.data.lastMessageAtMs is int)
        && (request.resource.data.lastSenderId is string)
        && (request.resource.data.createdAtMs is int)
        && requesterHasActivePlan()
        && notBlockedEitherWay(otherParticipant(request.resource.data.participantIds));

      allow update: if signedIn()
        && (request.auth.uid in resource.data.participantIds)
        && (request.resource.data.participantIds == resource.data.participantIds)
        && (request.resource.data.initiatedBy == resource.data.initiatedBy)
        && (request.resource.data.createdAtMs == resource.data.createdAtMs)
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['lastMessage', 'lastMessageAtMs', 'lastSenderId']);

      allow delete: if false;

      match /messages/{messageId} {
        function parentThread() {
          return get(/databases/$(database)/documents/private_threads/$(threadId)).data;
        }

        allow get, list: if signedIn()
          && (request.auth.uid in parentThread().participantIds);

        allow create: if signedIn()
          && (request.auth.uid in parentThread().participantIds)
          && (request.resource.data.senderId is string)
          && (request.resource.data.senderId == request.auth.uid)
          && (request.resource.data.type is string)
          && (request.resource.data.type in ['text', 'image', 'voice'])
          && (request.resource.data.text is string) && (request.resource.data.text.size() <= 4000)
          && (request.resource.data.imageUrl is string) && (request.resource.data.imageUrl.size() <= 2000)
          && (request.resource.data.voiceUrl is string) && (request.resource.data.voiceUrl.size() <= 2000)
          && (request.resource.data.createdAtMs is int)
          && (
               (request.resource.data.type == 'text' && request.resource.data.text.size() > 0) ||
               (request.resource.data.type == 'image' && request.resource.data.imageUrl.size() > 10) ||
               (request.resource.data.type == 'voice' && request.resource.data.voiceUrl.size() > 10)
             )
          && notBlockedEitherWay(otherParticipant(parentThread().participantIds));

        allow update, delete: if false;
      }
    }
  }
}
