rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function looksLikeFirebaseUid(s) {
      return (s is string) && (s.size() > 20);
    }

    function adminsDoc() {
      return get(/databases/$(database)/documents/app/admins);
    }

    function isPricingAdmin() {
      return signedIn() && (
        request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        ||
        (adminsDoc().exists()
          && (adminsDoc().data.pricingAdmins is list)
          && (request.auth.uid in adminsDoc().data.pricingAdmins))
      );
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1';
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    // ================================================================
    // League admin support (Organizer/Admin can delete league, manage teams, etc.)
    //
    // Supports multiple legacy shapes:
    // - leagues/{leagueId}.adminUids: [uid, ...]
    // - leagues/{leagueId}.adminIds: [uid, ...]
    // - leagues/{leagueId}.admins: [uid, ...]
    // - leagues/{leagueId}/admins/{uid} doc exists
    // - leagues/{leagueId}/leagueAdmins/{uid} doc exists
    // ================================================================
    function isLeagueAdmin(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('adminUids' in ld.data) && (ld.data.adminUids is list) && (request.auth.uid in ld.data.adminUids))
          || (('adminIds' in ld.data) && (ld.data.adminIds is list) && (request.auth.uid in ld.data.adminIds))
          || (('admins' in ld.data) && (ld.data.admins is list) && (request.auth.uid in ld.data.admins))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/admins/$(request.auth.uid))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/leagueAdmins/$(request.auth.uid))
        );
    }

    function isLeagueAdminDirect(leagueId) {
      return signedIn()
        && resource != null
        && (
          (('adminUids' in resource.data) && (resource.data.adminUids is list) && (request.auth.uid in resource.data.adminUids))
          || (('adminIds' in resource.data) && (resource.data.adminIds is list) && (request.auth.uid in resource.data.adminIds))
          || (('admins' in resource.data) && (resource.data.admins is list) && (request.auth.uid in resource.data.admins))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/admins/$(request.auth.uid))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/leagueAdmins/$(request.auth.uid))
        );
    }

    // ================================================================
    // isOwner via get() — for NON-TRANSACTION subcollection writes only
    // SAFE for: teams, matches, knockout, announcements, space, memberships
    // ================================================================
    function isOwner(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in ld.data)
            && looksLikeFirebaseUid(ld.data.organizerUserId)
            && (ld.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in ld.data)
            && looksLikeFirebaseUid(ld.data.ownerId)
            && (ld.data.ownerId == request.auth.uid)
          )
        );
    }

    // ================================================================
    // isOwnerDirect via resource.data — for league doc update/delete
    // No get() call.
    // ================================================================
    function isOwnerDirect() {
      return signedIn()
        && resource != null
        && (
          (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
          || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
          || (
            ('organizerUserId' in resource.data)
            && looksLikeFirebaseUid(resource.data.organizerUserId)
            && (resource.data.organizerUserId == request.auth.uid)
          )
          || (
            ('ownerId' in resource.data)
            && looksLikeFirebaseUid(resource.data.ownerId)
            && (resource.data.ownerId == request.auth.uid)
          )
        );
    }

    function isPublicLeague(leagueId) {
      let ld = leagueDoc(leagueId);
      return ld.exists() && (
        ((ld.data.isPrivate is bool) && (ld.data.isPrivate == false))
        || ((ld.data.isPrivate is int) && (ld.data.isPrivate == 0))
        || ((ld.data.privacy is string) && (
          ld.data.privacy == 'public'
          || ld.data.privacy == 'PUBLIC'
          || ld.data.privacy == 'LeaguePrivacy.public'
        ))
      );
    }

    function isLeagueParticipant(leagueId) {
      let ld = leagueDoc(leagueId);
      return signedIn()
        && ld.exists()
        && (
          (('organizerUid' in ld.data) && (ld.data.organizerUid is string) && (ld.data.organizerUid == request.auth.uid))
          || (('ownerUid' in ld.data) && (ld.data.ownerUid is string) && (ld.data.ownerUid == request.auth.uid))
          || (('organizerUserId' in ld.data) && looksLikeFirebaseUid(ld.data.organizerUserId) && (ld.data.organizerUserId == request.auth.uid))
          || (('ownerId' in ld.data) && looksLikeFirebaseUid(ld.data.ownerId) && (ld.data.ownerId == request.auth.uid))
          || (('memberIds' in ld.data) && (ld.data.memberIds is list) && (request.auth.uid in ld.data.memberIds))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
        );
    }

    // Chatroom-safe (no get())
    function isLeagueMemberNoGet(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid));
    }

    // Allow a non-owner to "join" by only adding themselves to memberIds.
    function canSelfJoinLeagueUpdate() {
      let beforeSize = (resource.data.memberIds is list) ? resource.data.memberIds.size() : 0;

      return signedIn()
        && (resource != null)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'memberIds',
          'updatedAtMs'
        ])
        && (request.resource.data.memberIds is list)
        && (request.auth.uid in request.resource.data.memberIds)
        // No removals
        && (request.resource.data.memberIds.size() >= beforeSize)
        // Add at most 1 uid per update
        && (request.resource.data.memberIds.size() <= beforeSize + 1);
    }

    // ===== Chat validation helpers =====

    function validChatType(t) {
      return (t is string) && (t == 'text' || t == 'image' || t == 'code');
    }

    function isReasonableMs(ms) {
      return (ms is int)
        && (ms >= (request.time.toMillis() - 30 * 60 * 1000))
        && (ms <= (request.time.toMillis() + 30 * 60 * 1000));
    }

    function validChatMessageCreate(messageId) {
      return signedIn()
        && (request.resource.data.keys().hasOnly([
          'messageId',
          'senderId',
          'senderName',
          'senderPhoto',
          'text',
          'imageUrl',
          'type',
          'createdAt',
          'createdAtMs'
        ]))
        && (request.resource.data.messageId is string)
        && (request.resource.data.messageId == messageId)
        && (request.resource.data.senderId is string)
        && (request.resource.data.senderId == request.auth.uid)
        && (request.resource.data.senderName is string)
        && (request.resource.data.senderName.size() >= 1)
        && (request.resource.data.senderName.size() <= 80)
        && (request.resource.data.senderPhoto is string)
        && (request.resource.data.senderPhoto.size() <= 2000)
        && validChatType(request.resource.data.type)
        && (request.resource.data.text is string)
        && (request.resource.data.text.size() <= 4000)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.imageUrl.size() <= 2000)
        && (request.resource.data.createdAt == request.time)
        && isReasonableMs(request.resource.data.createdAtMs)
        && (
          (request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == '')
          ||
          (request.resource.data.type == 'code'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == '')
          ||
          (request.resource.data.type == 'image'
            && request.resource.data.imageUrl.size() > 10)
        );
    }

    function isGlobalChatApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/globalChatRequests/$(request.auth.uid)).data.status == 'approved';
    }

    function canAccessGlobalChat() {
      return signedIn() && (isSuperAdmin() || isGlobalChatApproved());
    }

    function validQuickMsg(s) {
      return (s is string)
        && (s.size() > 0)
        && (s.size() <= 15)
        && !s.matches('.*(https?://|www\\.|@|\\.com|\\.net|\\.org).*');
    }

    function validQuickMessages(list) {
      return (list is list)
        && (list.size() <= 15)
        && (list.size() < 1  || validQuickMsg(list[0]))
        && (list.size() < 2  || validQuickMsg(list[1]))
        && (list.size() < 3  || validQuickMsg(list[2]))
        && (list.size() < 4  || validQuickMsg(list[3]))
        && (list.size() < 5  || validQuickMsg(list[4]))
        && (list.size() < 6  || validQuickMsg(list[5]))
        && (list.size() < 7  || validQuickMsg(list[6]))
        && (list.size() < 8  || validQuickMsg(list[7]))
        && (list.size() < 9  || validQuickMsg(list[8]))
        && (list.size() < 10 || validQuickMsg(list[9]))
        && (list.size() < 11 || validQuickMsg(list[10]))
        && (list.size() < 12 || validQuickMsg(list[11]))
        && (list.size() < 13 || validQuickMsg(list[12]))
        && (list.size() < 14 || validQuickMsg(list[13]))
        && (list.size() < 15 || validQuickMsg(list[14]));
    }

    function callRoomDoc(callId) {
      return get(/databases/$(database)/documents/call_rooms/$(callId));
    }

    function isCallParticipant(callId) {
      let cd = callRoomDoc(callId);
      return signedIn()
        && cd.exists()
        && (
          (('hostUserId' in cd.data) && (cd.data.hostUserId is string) && (cd.data.hostUserId == request.auth.uid))
          || (('createdBy' in cd.data) && (cd.data.createdBy is string) && (cd.data.createdBy == request.auth.uid))
          || (('participantIds' in cd.data) && (cd.data.participantIds is list) && (request.auth.uid in cd.data.participantIds))
        );
    }

    // ===== GLOBAL CHAT REQUESTS =====
    match /globalChatRequests/{requestId} {
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if signedIn()
        && request.auth.uid == requestId
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid)
        && (request.resource.data.status is string)
        && (request.resource.data.status == 'pending');

      allow update: if signedIn()
        && (
          (
            isSuperAdmin()
            && (request.resource.data.status is string)
            && (request.resource.data.status in ['pending', 'approved', 'rejected'])
          )
          ||
          (
            request.auth.uid == requestId
            && (request.resource.data.status is string)
            && (request.resource.data.status == 'pending')
          )
        );

      allow delete: if false;
    }

    // ===== GLOBAL PUBLIC CHATROOM =====
    match /globalChatroom/{messageId} {
      allow get, list: if canAccessGlobalChat();

      allow create: if canAccessGlobalChat()
        && validChatMessageCreate(messageId);

      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll([
          'userId',
          'teamName',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && (
          !('shareId' in request.resource.data)
          || (
            (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'teamName',
            'updatedAt'
          ])
          ||
          (
            resource.data.shareId == null
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'shareId',
              'updatedAt'
            ])
            && (request.resource.data.shareId is string)
            && request.resource.data.shareId.matches('^eS[A-Za-z0-9]{4,12}$')
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'quickMessagesCustom',
              'updatedAt'
            ])
            && validQuickMessages(request.resource.data.quickMessagesCustom)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'isPremium',
              'updatedAt'
            ])
            && (request.resource.data.isPremium is bool)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'photoUrl',
              'profileImageUrl',
              'teamImageUrl',
              'updatedAt'
            ])
            && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string))
            && (!('profileImageUrl' in request.resource.data) || (request.resource.data.profileImageUrl is string))
            && (!('teamImageUrl' in request.resource.data) || (request.resource.data.teamImageUrl is string))
            && (request.resource.data.updatedAt is int)
          )
        );

      allow delete: if false;

      match /leagueCharges/{leagueId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow update: if signedIn()
          && request.auth.uid == userId
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow delete: if false;
      }
    }

    match /leagues/{leagueId} {

      allow get: if signedIn()
        && (
          (('organizerUid' in resource.data) && (resource.data.organizerUid is string) && (resource.data.organizerUid == request.auth.uid))
          || (('ownerUid' in resource.data) && (resource.data.ownerUid is string) && (resource.data.ownerUid == request.auth.uid))
          || (('organizerUserId' in resource.data) && looksLikeFirebaseUid(resource.data.organizerUserId) && (resource.data.organizerUserId == request.auth.uid))
          || (('ownerId' in resource.data) && looksLikeFirebaseUid(resource.data.ownerId) && (resource.data.ownerId == request.auth.uid))
          || ((resource.data.memberIds is list) && (request.auth.uid in resource.data.memberIds))
          || exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
          || ((resource.data.isPrivate is bool) && (resource.data.isPrivate == false))
          || ((resource.data.isPrivate is int) && (resource.data.isPrivate == 0))
          || ((resource.data.privacy is string) && (
            resource.data.privacy == 'public'
            || resource.data.privacy == 'PUBLIC'
            || resource.data.privacy == 'LeaguePrivacy.public'
          ))
        );

      // Needed for join-by-code query
      allow list: if signedIn();

      allow create: if signedIn()
        && ('organizerUid' in request.resource.data)
        && (request.resource.data.organizerUid is string)
        && (request.resource.data.organizerUid == request.auth.uid)
        && (
          !(request.resource.data.memberIds is list)
          || (request.auth.uid in request.resource.data.memberIds)
        );

      // Organizer/Admin can update freely. Non-owner can only self-join.
      allow update: if
        isOwnerDirect()
        || isLeagueAdminDirect(leagueId)
        || canSelfJoinLeagueUpdate();

      // ONLY Organizer/Admin can delete league.
      allow delete: if isOwnerDirect() || isLeagueAdminDirect(leagueId);

      match /teams/{teamId} {
        allow get, list: if signedIn() && (isLeagueParticipant(leagueId) || isPublicLeague(leagueId));

        function validTeamPayload() {
          return signedIn()
            && (request.resource.data.id is string)
            && (request.resource.data.id == teamId)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.name is string)
            && (request.resource.data.name.size() >= 1)
            && (request.resource.data.name.size() <= 80)
            && (request.resource.data.updatedAtMs is int)
            && (request.resource.data.version is int)
            && (
              !('ownerId' in request.resource.data)
              || (
                (request.resource.data.ownerId is string)
                && (request.resource.data.ownerId == teamId)
              )
            );
        }

        // Organizer/Admin can manage all teams.
        // Member can create/update/delete their own team doc (teamId == auth.uid), if membership exists.
        allow create: if
          (
            (isOwner(leagueId) || isLeagueAdmin(leagueId))
            && validTeamPayload()
          )
          || (
            signedIn()
            && (teamId == request.auth.uid)
            && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
            && validTeamPayload()
          );

        allow update: if
          (
            (isOwner(leagueId) || isLeagueAdmin(leagueId))
            && validTeamPayload()
          )
          || (
            signedIn()
            && (teamId == request.auth.uid)
            && exists(/databases/$(database)/documents/leagues/$(leagueId)/memberships/$(request.auth.uid))
            && validTeamPayload()
            && (
              !('ownerId' in resource.data)
              || (!('ownerId' in request.resource.data) || (request.resource.data.ownerId == resource.data.ownerId))
            )
          );

        allow delete: if isOwner(leagueId) || isLeagueAdmin(leagueId) || (signedIn() && teamId == request.auth.uid);
      }

      match /matches/{matchId} {
        allow read: if signedIn() && (isLeagueParticipant(leagueId) || isPublicLeague(leagueId));
        allow write: if isOwner(leagueId) || isLeagueAdmin(leagueId);
      }

      match /knockout/{matchId} {
        allow read: if signedIn() && (isLeagueParticipant(leagueId) || isPublicLeague(leagueId));
        allow write: if isOwner(leagueId) || isLeagueAdmin(leagueId);
      }

      match /memberships/{membershipId} {
        allow get, list: if signedIn()
          && (
            isOwner(leagueId)
            || isLeagueAdmin(leagueId)
            || (membershipId == request.auth.uid)
            || isLeagueParticipant(leagueId)
          );

        // FIX: allow self-create member membership (role==1) after memberIds contains uid.
        // Organizer/Admin can create for others.
        allow create: if
          isOwner(leagueId)
          || isLeagueAdmin(leagueId)
          || (
            signedIn()
            && (membershipId == request.auth.uid)
            && (request.resource.data.userId is string)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId is string)
            && (request.resource.data.leagueId == leagueId)
            && (request.resource.data.role is int)
            && (
              (
                request.resource.data.role == 1
                && leagueDoc(leagueId).exists()
                && (leagueDoc(leagueId).data.memberIds is list)
                && (request.auth.uid in leagueDoc(leagueId).data.memberIds)
              )
              ||
              (
                request.resource.data.role == 0
                && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).exists()
                && (
                  (getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.organizerUid == request.auth.uid)
                  || (getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid)
                )
              )
            )
          );

        allow update: if
          isOwner(leagueId)
          || isLeagueAdmin(leagueId)
          || (
            signedIn()
            && (resource.data.userId == request.auth.uid)
            && (request.resource.data.userId == request.auth.uid)
            && (request.resource.data.leagueId == leagueId)
            && (resource.data.role == request.resource.data.role)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'teamId',
              'updatedAtMs',
              'version'
            ])
          );

        allow delete: if isOwner(leagueId) || isLeagueAdmin(leagueId);
      }

      match /announcements/{annId} {
        allow read: if signedIn() && (isLeagueParticipant(leagueId) || isPublicLeague(leagueId));
        allow write: if isOwner(leagueId) || isLeagueAdmin(leagueId);
      }

      match /chatroom/{messageId} {
        allow get, list: if isLeagueMemberNoGet(leagueId);

        allow create: if isLeagueMemberNoGet(leagueId)
          && validChatMessageCreate(messageId);

        allow update: if false;
        allow delete: if isOwner(leagueId) || isLeagueAdmin(leagueId) || isSuperAdmin();
      }

      match /space/{docId} {
        allow read: if signedIn() && (isLeagueParticipant(leagueId) || isPublicLeague(leagueId));

        allow create: if signedIn()
          && (
            isOwner(leagueId)
            || isLeagueAdmin(leagueId)
            || (
              ('hostUserId' in request.resource.data)
              && (request.resource.data.hostUserId is string)
              && (request.resource.data.hostUserId == request.auth.uid)
            )
          );

        allow update: if signedIn()
          && (
            isOwner(leagueId)
            || isLeagueAdmin(leagueId)
            || (
              resource != null
              && ('hostUserId' in resource.data)
              && (resource.data.hostUserId is string)
              && (resource.data.hostUserId == request.auth.uid)
            )
            || (
              ('hostUserId' in request.resource.data)
              && (request.resource.data.hostUserId is string)
              && (request.resource.data.hostUserId == request.auth.uid)
            )
          );

        allow delete: if isOwner(leagueId) || isLeagueAdmin(leagueId);

        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create: if signedIn();
          allow update, delete: if false;
        }

        match /requests/{uid} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == uid;
          allow update: if signedIn() && (isOwner(leagueId) || isLeagueAdmin(leagueId) || (request.auth.uid == uid));
          allow delete: if signedIn() && (isOwner(leagueId) || isLeagueAdmin(leagueId) || (request.auth.uid == uid));
        }

        match /speakers/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if signedIn()
            && (
              isOwner(leagueId)
              || isLeagueAdmin(leagueId)
              || (
                exists(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId))
                && ('hostUserId' in get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data)
                && (get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data.hostUserId is string)
                && (get(/databases/$(database)/documents/leagues/$(leagueId)/space/$(docId)).data.hostUserId == request.auth.uid)
              )
            );
        }
      }

      // ==========================
      // Coupons — NO get() ownership
      // ==========================
      match /couponConfig/{docId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);

        allow update: if signedIn()
          && (
            (
              (resource.data.organizerUserId is string)
              && (resource.data.organizerUserId == request.auth.uid)
            )
            ||
            (
              request.resource.data.diff(resource.data).changedKeys().hasOnly([
                'qtyRemaining',
                'updatedAtMs'
              ])
              && (request.resource.data.qtyRemaining is int)
              && (request.resource.data.qtyRemaining == (resource.data.qtyRemaining - 1))
              && (request.resource.data.qtyRemaining >= 0)
            )
          );

        allow delete: if false;
      }

      match /couponCodes/{codeId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (request.resource.data.organizerUserId is string)
          && (request.resource.data.organizerUserId == request.auth.uid)
          && (request.resource.data.leagueId is string)
          && (request.resource.data.leagueId == leagueId);

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'usedBy',
            'usedAtMs',
            'updatedAtMs'
          ])
          && (resource.data.usedBy is string) && (resource.data.usedBy == '')
          && (request.resource.data.usedBy is string) && (request.resource.data.usedBy == request.auth.uid);

        allow delete: if false;
      }

      match /couponRedemptions/{uid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && uid == request.auth.uid
          && (request.resource.data.userId is string)
          && (request.resource.data.userId == request.auth.uid);

        allow update: if signedIn()
          && uid == request.auth.uid
          && (resource.data.userId is string)
          && (resource.data.userId == request.auth.uid);

        allow delete: if false;
      }

      match /coupons/{couponId} {
        allow read, write: if false;
      }
    }

    match /league_spaces/{spaceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /call_rooms/{callId} {
      allow get: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
        );

      allow list: if signedIn();

      allow create: if signedIn()
        && (
          (
            ('createdBy' in request.resource.data)
            && (request.resource.data.createdBy is string)
            && (request.resource.data.createdBy == request.auth.uid)
          )
          || (
            ('hostUserId' in request.resource.data)
            && (request.resource.data.hostUserId is string)
            && (request.resource.data.hostUserId == request.auth.uid)
          )
        );

      allow update: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
          || (('participantIds' in resource.data) && (resource.data.participantIds is list) && (request.auth.uid in resource.data.participantIds))
          || (
            ('participantIds' in request.resource.data)
            && (request.resource.data.participantIds is list)
            && (request.auth.uid in request.resource.data.participantIds)
          )
        );

      allow delete: if signedIn()
        && resource != null
        && (
          (('hostUserId' in resource.data) && (resource.data.hostUserId is string) && (resource.data.hostUserId == request.auth.uid))
          || (('createdBy' in resource.data) && (resource.data.createdBy is string) && (resource.data.createdBy == request.auth.uid))
        );

      match /quick_messages/{msgId} {
        allow read: if isCallParticipant(callId);

        allow create: if signedIn()
          && (request.resource.data.senderId is string)
          && (request.resource.data.senderId == request.auth.uid)
          && isCallParticipant(callId);

        allow update, delete: if false;
      }
    }

    match /marketplace_products/{productId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == 'a0JDUelQW3TEyoXTm4ESuGi7ndq1'
        && (request.resource.data.createdBy is string)
        && (request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.keys().hasAll([
          'productId',
          'name',
          'price',
          'description',
          'imageUrl',
          'affiliateUrl',
          'category',
          'sellerName',
          'createdAt',
          'createdBy'
        ])
        && (request.resource.data.productId is string)
        && (request.resource.data.productId == productId)
        && (request.resource.data.name is string)
        && (request.resource.data.price is string)
        && (request.resource.data.description is string)
        && (request.resource.data.imageUrl is string)
        && (request.resource.data.affiliateUrl is string)
        && (request.resource.data.category is string)
        && (request.resource.data.sellerName is string)
        && (request.resource.data.createdAt is timestamp);

      allow update, delete: if false;
    }

    match /app/{docId} {
      allow get, list: if (docId == 'pricing') || (docId == 'admins' && signedIn());
      allow create, update: if ((docId == 'pricing' || docId == 'admins') && isPricingAdmin());
      allow delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && (request.resource.data.eventName is string)
        && (request.resource.data.createdAtMs is int)
        && (request.resource.data.userId is string)
        && (request.resource.data.userId == request.auth.uid);

      allow get, list: if isPricingAdmin();
      allow update, delete: if false;
    }
  }
}
