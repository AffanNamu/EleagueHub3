rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /leagues/{leagueId} {

      function isOwner() {
        return signedIn()
          && resource.data.organizerUserId == request.auth.uid;
      }

      function isMember() {
        return signedIn()
          && (resource.data.memberIds is list)
          && (request.auth.uid in resource.data.memberIds);
      }

      /* =======================
         League document rules
         ======================= */

      // Single document read
      allow get: if (!resource.data.isPrivate)
        || isOwner()
        || isMember();

      // Collection queries (VERY IMPORTANT)
      allow list: if signedIn();

      // Create league
      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        && (request.resource.data.memberIds is list)
        && (request.auth.uid in request.resource.data.memberIds);

      // Update league:
      // - owner can edit anything
      // - members can only add themselves
      allow update: if isOwner()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
            .changedKeys()
            .hasOnly(['memberIds', 'updatedAtMs'])
          && request.auth.uid in request.resource.data.memberIds
        );

      // Delete league
      allow delete: if isOwner();

      /* =======================
         Subcollections
         ======================= */

      match /teams/{teamId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /matches/{matchId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /knockout/{matchId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner();
      }

      match /memberships/{membershipId} {
        allow read: if isOwner() || isMember();
        allow write: if isOwner()
          || (
            signedIn()
            && request.resource.data.userId == request.auth.uid
          );
      }
    }
  }
}
