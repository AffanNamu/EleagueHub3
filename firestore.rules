rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /leagues/{leagueId} {
      // READ
      allow get, list: if !resource.data.isPrivate
        || (signedIn() && request.auth.uid in resource.data.memberIds)
        || (signedIn() && resource.data.organizerUserId == request.auth.uid);

      // CREATE (owner must be current user and memberIds must include owner)
      allow create: if signedIn()
        && request.resource.data.organizerUserId == request.auth.uid
        && (request.resource.data.memberIds is list)
        && (request.auth.uid in request.resource.data.memberIds);

      // UPDATE/DELETE owner only
      allow update, delete: if signedIn() && resource.data.organizerUserId == request.auth.uid;

      // JOIN: allow user to add themselves to memberIds only
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds', 'updatedAtMs'])
        && request.auth.uid in request.resource.data.memberIds;
    }
  }
}
