<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for firebase_messaging. This literal value is used
	     as-is when the app is signed with a distribution profile for
	     App Store/TestFlight submission. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Required because google_sign_in is offered as a login option.
	     Apple guideline 4.8 requires Sign in with Apple be offered
	     alongside any other third-party login. The auth flow itself is
	     AuthService.signInWithApple() (lib/features/auth/data/auth_service.dart),
	     wired to the "Continue with Apple" button on login_screen.dart —
	     iOS only for now; confirm the Sign in with Apple capability is
	     also enabled on this app's App ID in the Apple Developer portal,
	     this entitlement alone isn't sufficient without that. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- App Group placeholder for sharing data between the main app
	     and the ReplayKit Broadcast Upload Extension (for the
	     in-app-overlay + screen-recording redesign). Create this
	     exact group ID in Apple Developer portal → Identifiers →
	     App Groups before this will build with a real profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eleaguehub.app</string>
	</array>

	<!-- Universal Links (Android App Links equivalent) for Universal
	     Sharing deep links — /u/{username}, /leagues/{id}, /team/{id},
	     /post/{id}, /master-leagues/{id}, /join. Requires
	     https://esportlyic.com/.well-known/apple-app-site-association
	     (see web_client/public/.well-known/apple-app-site-association)
	     to list this app's Team ID + bundle ID, or Apple will not
	     associate this domain with the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:esportlyic.com</string>
		<string>applinks:www.esportlyic.com</string>
	</array>
</dict>
</plist>
