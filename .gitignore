# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Next.js build output (web_client already has its own /.next/ ignore;
# esportlyic-admin's was mistakenly committed at some point, generating
# large diffs on every dev/build run — untracked and ignored here).
esportlyic-admin/.next/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.*.local
# Any other *.env-suffixed file (e.g. esportlyic-admin/esportlyic.env, a
# duplicate of .env.local that was committed under a name none of the
# patterns above cover -- caught by a security audit; see that commit).
*.env

# dataconnect generated files
.dataconnect

# ── Code-signing / API credential material ──
# These must NEVER be committed -- iOS builds decode them fresh on every
# CI run from base64 GitHub Actions secrets (see .github/workflows/ios.yml),
# so plaintext copies in the repo are never needed and are pure exposure.
# (AuthKey_FHU84658L6.p8.txt, distribution.cer, ios_development.p12,
# ios_distribution.p12, release-key.jks, upload-keystore.jks, and others
# were found already committed on origin/main and removed -- see commit
# message for the incident writeup. ios_distribution.key, p8_text.txt,
# p12_text.txt, and profile_text.txt were a second wave from the same
# original commit that slipped past those rules -- same incident, caught
# late; see this commit's message.)
*.p8
*.p8.txt
*.key
AuthKey_*
*.p12
*.cer
*.pem
*.mobileprovision
*.jks
*.keystore
*_text.txt
encoded_keystore.txt
GoogleService-Info.plist
GoogleService-Info.plist.b64

# Supabase CLI local cache
supabase/.temp/

# ── Flutter build artifacts ──
# Never tracked in this repo's history -- CI (ios.yml/android.yml)
# regenerates all of these from scratch on every run via heredocs, so a
# local `flutter analyze`/`flutter pub get` run (e.g. for verifying a
# change in this environment) produces the same generated output the CI
# runner would, which is noise here, not real source.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m
